# PROMETHEUS_EXTRA_MATCHERS=cluster="vc-942nkkozc8o5fyb9q3bznb1ws"
# VICTORIALOGS_URL=http://10.2.5.85:31700
# VICTORIALOGS_CLUSTER=vc-942nkkozc8o5fyb9q3bznb1ws
