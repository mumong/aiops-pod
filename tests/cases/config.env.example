TELEMETRY_IMAGE=xnet.registry.io:8443/observability/python:3-alpine
OTLP_HTTP_ENDPOINT=http://lgtm.monitor.svc:4318/v1/traces
PROMETHEUS_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TLS_VERIFY=true
ELASTICSEARCH_CA_CERT=
DEEPFLOW_NAMESPACE=monitor
DEEPFLOW_CLICKHOUSE_SELECTOR=app.kubernetes.io/name=clickhouse
TEMPO_URL=
OBSERVABILITY_TIMEOUT_SECONDS=300

# Multi-cluster test env (VictoriaMetrics + VictoriaLogs with Kubernetes events only).
# Run per cluster with that cluster's KUBECONFIG; cluster = the xnet virtual Node name.
# OBSERVABILITY_PROFILE=victoria
