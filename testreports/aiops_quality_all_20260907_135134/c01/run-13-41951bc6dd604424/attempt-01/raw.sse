data: {"id": "41951bc6dd604424-node_complete-parallel_evidence", "run_id": "41951bc6dd604424", "seq": 1606, "ts_ms": 1788761664925, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 38.329, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-bsq52"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/41951bc6dd604424-g1/lane_artifacts/g1/artifact.json", "sha256": "3588573164e038b71d20f42cc37cbdec79cbc90704994556874497acb8b0475d", "bytes": 2451}, "snapshot_sha256": "2e459c8aaa1683d84673a411d1732fe0b57f51ede66239e916ce834f95048611"}]}, "handoff_summary": ""}

