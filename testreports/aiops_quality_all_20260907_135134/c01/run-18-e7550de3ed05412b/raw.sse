data: {"id": "e7550de3ed05412b-node_complete-parallel_evidence", "run_id": "e7550de3ed05412b", "seq": 763, "ts_ms": 1788762436267, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 43.86, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-bsq52"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e7550de3ed05412b-g1/lane_artifacts/g1/artifact.json", "sha256": "9195d48e493871787c6cdcd82fc305934e9ebf2ac08fd0bdf2b62db265cd3ed4", "bytes": 2451}, "snapshot_sha256": "d937965f2d0cf00a4b97a063304f9a8b2dfd64749b084086ac8a35dfde1f1edc"}]}, "handoff_summary": ""}

