data: {"id": "efd6d89d335e4a10-thinking-parallel_evidence-1853", "run_id": "efd6d89d335e4a10", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\n关键诊断行:\nPod prometheus-observability-prometheus-0 in monitor namespace is Running but experiencing OOMKilled restarts and unhealthy probes on node1.\nkey_facts: [\"Name: prometheus-o", "duration_seconds": null, "iteration": 2, "ts_ms": 1788762249769, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g2", "entity": {"kind": "Pod", "namespace": "monitor", "name": "prometheus-observability-prometheus-0"}, "dimension": "kubernetes"}, "tool_call_id": "call_a1e6c43348bc4a0f88441a7d", "tool_sequence": 6, "semantic_success": true, "result": "kubectl_describe 摘要:\n关键诊断行:\nPod prometheus-observability-prometheus-0 in monitor namespace is Running but experiencing OOMKilled restarts and unhealthy probes on node1.\nkey_facts: [\"Name: prometheus-observability-prometheus-0, Namespace: monitor, Node: node1/10.2.0.49\", \"Status: Running, QoS: Burstable\", \"Container prometheus (xnet.registry.io:8443/observability/prometheus/prometheus:v3.4.1) is Ready=True\", \"Last State: Terminated, Reason: OOMKilled, Exit Code: 137 (Started Wed 21:11, Finished Thu 01:14)\", \"Memory Limits: 512Mi, Requests: 256Mi\", \"Restart Count: 2\", \"Warning: Liveness probe failed (x176 over 19d) - context deadline exceeded\", \"Warning: Readiness probe failed (x142 over 19d) - context deadline exceeded\", \"Error in logs: found duplicate series ... many-to-many matching not allowed\"]\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/efd6d89d335e4a10-g2/tools/009-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/efd6d89d335e4a10-g2/tools/009-evidence-kubectl_describe.structured.json", "summa