data: {"id": "1e837b11acef4317-thinking-parallel_evidence-459", "run_id": "1e837b11acef4317", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubernetes_tabular_query", "content": null, "status": "success", "result_preview": "kubernetes_tabular_query 输出摘要: raw_chars=225 lines=3\nCommand failed (exit 1):\nkubectl get nodes --all-namespaces -o custom-columns='metadata.name,metadata.labels['aiops\\.lab/unavailable']'\nerror: unex", "duration_seconds": null, "iteration": 2, "ts_ms": 1788762536522, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "kubernetes"}, "tool_call_id": "call_bd67f4d2516c4f0fb0e4ee5a", "tool_sequence": 2, "semantic_success": false, "result": "kubernetes_tabular_query 输出摘要: raw_chars=225 lines=3\nCommand failed (exit 1):\nkubectl get nodes --all-namespaces -o custom-columns='metadata.name,metadata.labels['aiops\\.lab/unavailable']'\nerror: unexpected custom-columns spec: metadata.name, expected <header>:<json-path-expr>", "raw_ref": "/tmp/aiops/reports/context_archives/1e837b11acef4317-g1/tools/005-evidence-kubernetes_tabular_query.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/1e837b11acef4317-g1/tools/005-evidence-kubernetes_tabular_query.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/1e837b11acef4317-g1/tools/005-evidence-kubernetes_tabular_query.summary.txt"}

