data: {"id": "ce6880c6e7024211-node_complete-parallel_evidence", "run_id": "ce6880c6e7024211", "seq": 1122, "ts_ms": 1788775609666, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 27.415, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-7ds5p"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/ce6880c6e7024211-g1/lane_artifacts/g1/artifact.json", "sha256": "14f7d69fd4329ee1589963ff57166aac2dfe4fa321a2925dfa3b108b76fee095", "bytes": 2633}, "snapshot_sha256": "9481a21247d1bad37e2c141e3f613ec7c675ca38da3748041535b4941faab84f"}]}, "handoff_summary": ""}

