data: {"id": "d38cc4d9b5fa4c69-node_complete-parallel_evidence", "run_id": "d38cc4d9b5fa4c69", "seq": 1140, "ts_ms": 1788775132933, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 38.875, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-7ds5p"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d38cc4d9b5fa4c69-g1/lane_artifacts/g1/artifact.json", "sha256": "3039b93fbbe6f73b681fee382f56bbc3782e5024ce1fb6d45df1248debbda83c", "bytes": 2633}, "snapshot_sha256": "a2c66dd12411df7b44964d08a1ea55c5397f6b9787f6d2e5fca9eeef04a8cb58"}]}, "handoff_summary": ""}

