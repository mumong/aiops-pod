data: {"id": "dafce6624c4e4f50-node_complete-parallel_evidence", "run_id": "dafce6624c4e4f50", "seq": 1400, "ts_ms": 1788775807972, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 42.458, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-7ds5p"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/dafce6624c4e4f50-g1/lane_artifacts/g1/artifact.json", "sha256": "84960c787fcebef481caa3e83097f69bdba824536afc85dbddb55f17fe0091d1", "bytes": 2633}, "snapshot_sha256": "84d75fb47fb10d6f534c7f812c11ed20f7565fa2f62163cd30614ce02b1ebc36"}]}, "handoff_summary": ""}

