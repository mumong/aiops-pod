data: {"id": "89768ad95f214313-node_complete-parallel_evidence", "run_id": "89768ad95f214313", "seq": 1227, "ts_ms": 1788791000062, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 67.463, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-jwr8b"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/89768ad95f214313-g1/lane_artifacts/g1/artifact.json", "sha256": "710df12ba4d8119d43bb9d55dff28148a28c72491dc984fb8cd03239145032f6", "bytes": 2450}, "snapshot_sha256": "416bb5efcc059ab733b95590d98c2113e0694e1065aca637029b16e9d42923a2"}]}, "handoff_summary": ""}

