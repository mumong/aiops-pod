data: {"id": "2df5cba55bc646b4-thinking-parallel_evidence-153", "run_id": "2df5cba55bc646b4", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_get_yaml", "content": null, "status": "success", "result_preview": "Pod `workload-7679bcf76-jwr8b` in namespace `aiops-case-06` is Running but not Ready. Container `app` is stuck in CrashLoopBackOff with exitCode 2, caused by runtime exit (env FAILURE_MODE=runtime_exi", "duration_seconds": null, "iteration": 2, "ts_ms": 1788785666399, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-jwr8b"}, "dimension": "kubernetes"}, "tool_call_id": "call_3e72ae0320d84b4ebdfb7769", "tool_sequence": 4, "semantic_success": true, "result": "Pod `workload-7679bcf76-jwr8b` in namespace `aiops-case-06` is Running but not Ready. Container `app` is stuck in CrashLoopBackOff with exitCode 2, caused by runtime exit (env FAILURE_MODE=runtime_exit).\nkey_facts: [\"Pod: workload-7679bcf76-jwr8b, Namespace: aiops-case-06\", \"Node: node2, Phase: Running\", \"Container `app`: Image `xnet.registry.io:8443/observability/python:3-alpine`, Command: `python3 /opt/aiops/server.py`\", \"Restart Count: 9\", \"Container Status: waiting, Reason: CrashLoopBackOff\", \"Last State: terminated, Reason: Error, Exit Code: 2\", \"Message: back-off 5m0s restarting failed container\", \"Conditions: Ready=False, Reason=ContainersNotReady, Message='containers with unready status: [app]'\", \"Environment: FAILURE_MODE=runtime_exit, PYTHONUNBUFFERED=1\"]", "raw_ref": "/tmp/aiops/reports/context_archives/2df5cba55bc646b4-g1/tools/007-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/2df5cba55bc646b4-g1/tools/007-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/2df5cba55bc