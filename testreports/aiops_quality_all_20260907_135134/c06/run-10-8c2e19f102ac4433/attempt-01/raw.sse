data: {"id": "8c2e19f102ac4433-node_complete-parallel_evidence", "run_id": "8c2e19f102ac4433", "seq": 699, "ts_ms": 1788785905105, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 61.674, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-jwr8b"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8c2e19f102ac4433-g1/lane_artifacts/g1/artifact.json", "sha256": "09befc571490dfdf71bc1715835b5a79988d1c9e5eb9560b91846a77745dbe00", "bytes": 2450}, "snapshot_sha256": "13431fd028fafd11e06e666cef85ecddece0628448e74a9799678eb333fd2bb6"}]}, "handoff_summary": ""}

