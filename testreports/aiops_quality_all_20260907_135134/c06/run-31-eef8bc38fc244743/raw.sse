data: {"id": "eef8bc38fc244743-node_complete-parallel_evidence", "run_id": "eef8bc38fc244743", "seq": 1256, "ts_ms": 1788789559583, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 71.513, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-jwr8b"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/eef8bc38fc244743-g1/lane_artifacts/g1/artifact.json", "sha256": "a3260f5ef0f02a3aa4910eaa50ef3a4020d2bc7cd23309e705cbb0e605476531", "bytes": 2450}, "snapshot_sha256": "962faa4516ad743ef8ad6cfdf034d62053b8bc80a5cbe006f0717196913fba11"}]}, "handoff_summary": ""}

