data: {"id": "e8de5026b4104eee-node_complete-parallel_evidence", "run_id": "e8de5026b4104eee", "seq": 2994, "ts_ms": 1788822520871, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 186.002, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-bwqhh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e8de5026b4104eee-g1/lane_artifacts/g1/artifact.json", "sha256": "741775d4d5b8228848bd7f5a98450d42134be6ff6a62bfc1f6a698121edefb87", "bytes": 2452}, "snapshot_sha256": "7b332f885d532c870d9d4f9c7a223ec2b42bae9a0be999a33b1826e08484c8ef"}]}, "handoff_summary": ""}

