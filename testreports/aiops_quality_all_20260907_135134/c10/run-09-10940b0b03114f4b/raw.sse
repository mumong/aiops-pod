data: {"id": "10940b0b03114f4b-thinking-parallel_evidence-879", "run_id": "10940b0b03114f4b", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\nname: workload-79d9f8fd88-bwqhh\nnamespace: aiops-case-10\nnode: node2/10.2.0.50\nstatus: Running\n关键诊断行:\n      Exit Code:    137\n  Warning  Unhealthy       23m (x8 over 25m)   kubele", "duration_seconds": null, "iteration": 1, "ts_ms": 1788816116176, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-bwqhh"}, "dimension": "kubernetes"}, "tool_call_id": "call_5428f53c43294beb80a6c9bc", "tool_sequence": 1, "semantic_success": true, "result": "kubectl_describe 摘要:\nname: workload-79d9f8fd88-bwqhh\nnamespace: aiops-case-10\nnode: node2/10.2.0.50\nstatus: Running\n关键诊断行:\n      Exit Code:    137\n  Warning  Unhealthy       23m (x8 over 25m)   kubelet            Liveness probe failed: HTTP probe failed with statuscode: 500\n      Reason:       CrashLoopBackOff\n  Warning  BackOff         58s (x80 over 21m)  kubelet            Back-off restarting failed container app in pod workload-79d9f8fd88-bwqhh_aiops-case-10(f2db1889-e2c8-4073-b40b-7603dc0755f7)\n  Normal   Killing         23m (x4 over 25m)   kubelet            Container app failed liveness probe, will be restarted\nAnnotations:      cni.projectcalico.org/containerID: 74fa41eee00e35c682aa95368094782dc681fd9afeafb483b397d9689f0722af\n                  cni.projectcalico.org/podIP: 172.16.104.32/32\n                  cni.projectcalico.org/podIPs: 172.16.104.32/32\n                  k8s.v1.cni.cncf.io/network-status:\n                  k8s.v1.cni.cncf.io/networks-status:\nPod 关键区块:\nControlled By: ReplicaSet/workload-79d9f8fd88\nQoS Class: Burstable\nNode-Selectors: <non