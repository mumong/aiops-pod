data: {"id": "c5b745b0029b4bc4-node_complete-parallel_evidence", "run_id": "c5b745b0029b4bc4", "seq": 1174, "ts_ms": 1788817118938, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 66.914, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-bwqhh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/c5b745b0029b4bc4-g1/lane_artifacts/g1/artifact.json", "sha256": "276febcdbe7a29146ac53fe773576eec83e5f73e14c394d7a786142b4a96aa39", "bytes": 2452}, "snapshot_sha256": "a481995207a0c11daab8cf0a0ca8664f20adc7743f400edbb14b3c07e5de2441"}]}, "handoff_summary": ""}

