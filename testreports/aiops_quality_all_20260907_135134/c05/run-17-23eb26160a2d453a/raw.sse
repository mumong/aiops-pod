data: {"id": "23eb26160a2d453a-thinking-parallel_evidence-588", "run_id": "23eb26160a2d453a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx (ns: aiops-case-05) 绑定至 node2，但因缺失 Multus 网络定义 unavailable-network 导致反复创建 Sandbox 失败。\nkey_facts: [\"Pod/aiops-case-05/workload-5dbb5dcd6c-kbwsx 被调度至 node2。\", \"持续报错：FailedC", "duration_seconds": null, "iteration": 1, "ts_ms": 1788780702978, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_6d296e4e76854e8faff9e47c", "tool_sequence": 2, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx (ns: aiops-case-05) 绑定至 node2，但因缺失 Multus 网络定义 unavailable-network 导致反复创建 Sandbox 失败。\nkey_facts: [\"Pod/aiops-case-05/workload-5dbb5dcd6c-kbwsx 被调度至 node2。\", \"持续报错：FailedCreatePodSandBox (42m-40m, 多次)。\", \"根本原因：网络插件 Multus 尝试加载网络定义 unavailable-network 失败。\", \"具体错误：network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found。\", \"伴随 Warning：NoNetworkFound。\"]", "raw_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/004-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/004-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/004-evidence-kubectl_events.summary.txt"}

