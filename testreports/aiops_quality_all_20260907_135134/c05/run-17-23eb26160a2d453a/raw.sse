data: {"id": "23eb26160a2d453a-thinking-parallel_evidence-590", "run_id": "23eb26160a2d453a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod `workload-5dbb5dcd6c-kbwsx` is stuck in `Pending` state due to repeated CNI network attachment failures. The Multus plugin repeatedly reports it cannot find the NetworkAttachmentDefinition `unavai", "duration_seconds": null, "iteration": 1, "ts_ms": 1788780709485, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_60e108cfcbc94666aa051790", "tool_sequence": 1, "semantic_success": true, "result": "Pod `workload-5dbb5dcd6c-kbwsx` is stuck in `Pending` state due to repeated CNI network attachment failures. The Multus plugin repeatedly reports it cannot find the NetworkAttachmentDefinition `unavailable-network` in namespace `aiops-case-05`.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"State: Waiting (ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Warning NoNetworkFound (multus): network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"Warning FailedCreatePodSandBox (kubelet): plugin type=\\\"multus\\\" name=\\\"multus-cni-network\\\" failed\", \"Reason for failure: getKubernetesDelegate: cannot find a network-attachment-definition (unavailable-network)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/006-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/006-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/006-evidence-kubectl_describe.summary.txt"}

