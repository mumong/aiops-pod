vidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/005-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/23eb26160a2d453a-g1/tools/005-evidence-kubectl_get_yaml.summary.txt"}

