data: {"id": "bf605f143c68470a-thinking-parallel_evidence-1497", "run_id": "bf605f143c68470a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is failing to create pod sandbox due to missing network-attachment-definition 'unavailable-network', resulting in repeated 'NoNetworkFound' war", "duration_seconds": null, "iteration": 1, "ts_ms": 1788783470064, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_486169d3eb8d48faa091179a", "tool_sequence": 2, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is failing to create pod sandbox due to missing network-attachment-definition 'unavailable-network', resulting in repeated 'NoNetworkFound' warnings over 86 minutes.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Error: Failed to create pod sandbox\", \"Root Cause: Missing network-attachment-definition 'unavailable-network'\", \"Event Type: Warning\", \"Reason: NoNetworkFound / FailedCreatePodSandBox\", \"Duration: 86m (379 combined events)\", \"Specific Error: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\"]", "raw_ref": "/tmp/aiops/reports/context_archives/bf605f143c68470a-g1/tools/004-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/bf605f143c68470a-g1/tools/004-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/bf605f143c68470a-g1/tools/004-evidence-kubectl_events.summary.txt"}

