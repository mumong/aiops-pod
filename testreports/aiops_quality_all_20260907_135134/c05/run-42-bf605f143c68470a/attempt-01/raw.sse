data: {"id": "bf605f143c68470a-thinking-parallel_evidence-1499", "run_id": "bf605f143c68470a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state due to missing NetworkAttachmentDefinition 'unavailable-network' required by Multus CNI. The pod requests network 'un", "duration_seconds": null, "iteration": 1, "ts_ms": 1788783476273, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_652983d5bd6e440b8c5d6814", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state due to missing NetworkAttachmentDefinition 'unavailable-network' required by Multus CNI. The pod requests network 'unavailable-network' via annotation but the resource does not exist in the namespace.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx (namespace: aiops-case-05, node: node2/10.2.0.50)\", \"Status: Pending (ContainerCreating)\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Event: Warning NoNetworkFound (multus): cannot find network-attachment-definition 'unavailable-network' in namespace aiops-case-05\", \"Event Frequency: Repeated continuously from 60m ago to current (x hundreds)\", \"Error: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\"]", "raw_ref": "/tmp/aiops/reports/context_archives/bf605f143c68470a-g1/tools/006-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/bf605f143c68470a-g1/tools/006-evidence-kubect