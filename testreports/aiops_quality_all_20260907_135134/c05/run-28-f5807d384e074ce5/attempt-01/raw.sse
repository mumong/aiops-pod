data: {"id": "f5807d384e074ce5-thinking-parallel_evidence-519", "run_id": "f5807d384e074ce5", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is failing to create pod sandbox due to missing network attachment definition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbws", "duration_seconds": null, "iteration": 1, "ts_ms": 1788781944949, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_fb4a2ec760d6496788523e47", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is failing to create pod sandbox due to missing network attachment definition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Error: Failed to create pod sandbox: failed to setup network\", \"Reason: NoNetworkFound\", \"Specific Failure: network-attachment-definition 'unavailable-network' not found in aiops-case-05\", \"Frequency: Repeated ~264 times over 61 minutes\"]", "raw_ref": "/tmp/aiops/reports/context_archives/f5807d384e074ce5-g1/tools/006-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/f5807d384e074ce5-g1/tools/006-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/f5807d384e074ce5-g1/tools/006-evidence-kubectl_events.summary.txt"}

