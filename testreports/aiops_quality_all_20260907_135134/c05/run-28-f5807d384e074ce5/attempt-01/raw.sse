data: {"id": "f5807d384e074ce5-thinking-parallel_evidence-518", "run_id": "f5807d384e074ce5", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state due to multus CNI failure. The error indicates that the requested network-attachment-definition 'unavailable-network'", "duration_seconds": null, "iteration": 1, "ts_ms": 1788781940935, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_02089e4b0b204e5092e3dda4", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state due to multus CNI failure. The error indicates that the requested network-attachment-definition 'unavailable-network' does not exist in the namespace.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx, Namespace: aiops-case-05, Node: node2/10.2.0.50\", \"Status: Pending, Container State: Waiting (Reason: ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Events: Repeated Warning 'NoNetworkFound' from multus agent (duration >60m)\", \"Error: network-attachment-definitions.k8s.cni.cncf.io 'unavailable-network' not found in aiops-case-05\"]", "raw_ref": "/tmp/aiops/reports/context_archives/f5807d384e074ce5-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/f5807d384e074ce5-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/f5807d384e074ce5-g1/tools/005-evidence-kubectl_describe.summary.txt"}

