data: {"id": "c734c21c784b4369-thinking-parallel_evidence-1578", "run_id": "c734c21c784b4369", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is Pending due to multus CNI failure. Event logs show repeated 'FailedCreatePodSandBox' and 'NoNetworkFound' warnings indicating the network-at", "duration_seconds": null, "iteration": 1, "ts_ms": 1788779701039, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_3b75780093a84a9fb26beba6", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is Pending due to multus CNI failure. Event logs show repeated 'FailedCreatePodSandBox' and 'NoNetworkFound' warnings indicating the network-attachment-definition 'unavailable-network' cannot be found in the target namespace.\nkey_facts: [\"Pod Name: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Events: Multiple 'Warning FailedCreatePodSandBox' (kubelet) and 'Warning NoNetworkFound' (multus)\", \"Error Message: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"Start Time: Mon, 07 Sep 2026 10:49:27 +0000\"]", "raw_ref": "/tmp/aiops/reports/context_archives/c734c21c784b4369-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/c734c21c784b4369-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_a