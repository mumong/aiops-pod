data: {"id": "385b0d19895c4086-thinking-parallel_evidence-2094", "run_id": "385b0d19895c4086", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state. The pod has an annotation requesting the 'unavailable-network' network attachment definition, which does not exist i", "duration_seconds": null, "iteration": 1, "ts_ms": 1788782781767, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_661ef9c3fd714812a4089566", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state. The pod has an annotation requesting the 'unavailable-network' network attachment definition, which does not exist in the namespace. Events show repeated failures from both kubelet (FailedCreatePodSandBox) and multus (NoNetworkFound) regarding the missing network-attachment-definition.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx (Namespace: aiops-case-05)\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Container State: Waiting (Reason: ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: network-attachment-definition 'unavailable-network' not found in namespace 'aiops-case-05'\", \"Event Type: Warning (Reason: NoNetworkFound, Source: multus)\", \"Event Type: Warning (Reason: FailedCreatePodSandBox, Source: kubelet)\", \"Failed Event Count: 'NoNetworkFound' repeated approx. 60+ times over 60m; 'FailedCreatePodSandBox' x335 over 75m (from raw_ref)\"]\nconflicts: [\"raw_preview shows 'NoNetworkFound' events dominating the list, while current_summary mentions 'FailedCreatePodSandBox' first. raw_preview confirms the annotation causing the issue is 'k8s.v1.cni.cncf.io/networks: unavailable-network'.\"]\nmissing: [\"Details on the ReplicaSet status\", \"Node conditions\"]", "raw_ref": "/tmp/aiops/reports/context_archives/385b0d19895c4086-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/385b0d19895c4086-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/385b0d19895c4086-g1/tools/005-evidence-kubectl_describe.summary.txt"}

