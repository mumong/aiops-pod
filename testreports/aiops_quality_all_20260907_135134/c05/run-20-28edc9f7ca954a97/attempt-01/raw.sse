data: {"id": "28edc9f7ca954a97-node_complete-parallel_evidence", "run_id": "28edc9f7ca954a97", "seq": 2311, "ts_ms": 1788781290691, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 42.083, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/28edc9f7ca954a97-g1/lane_artifacts/g1/artifact.json", "sha256": "78a34d988259037e3c8fbfdb211881395c4b8c8695da1edb3937f2a4ad0387b0", "bytes": 2452}, "snapshot_sha256": "1776f09cc2d6c8c0def551e9c14cd8fb95e68bc57d94e369a371d7a1fa4b09dc"}]}, "handoff_summary": ""}

