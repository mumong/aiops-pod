data: {"id": "d1bbeef931d0433f-thinking-parallel_evidence-2724", "run_id": "d1bbeef931d0433f", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state on node2. The failure is caused by Multus CNI plugin unable to find the requested NetworkAttachmentDefinition 'unavai", "duration_seconds": null, "iteration": 1, "ts_ms": 1788783577584, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_8eb2f840e5064c0b9abe900c", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state on node2. The failure is caused by Multus CNI plugin unable to find the requested NetworkAttachmentDefinition 'unavailable-network' in the target namespace, resulting in continuous FailedCreatePodSandBox errors.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Status: Pending (Reason: ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: Failed to create pod sandbox: rpc error: code = Unknown desc = failed to setup network for sandbox... plugin type=multus... failed (add)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/d1bbeef931d0433f-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/d1bbeef931d0433f-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/d1bbeef931d0433f-g1/tools/005-evidence-kubectl_describe.summary.txt"}

