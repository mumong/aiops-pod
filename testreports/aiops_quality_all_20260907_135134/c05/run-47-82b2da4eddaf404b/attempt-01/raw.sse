data: {"id": "82b2da4eddaf404b-thinking-parallel_evidence-788", "run_id": "82b2da4eddaf404b", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state. The pod requests a network-attachment-definition named 'unavailable-network' via annotation 'k8s.v1.cni.cncf.io/netw", "duration_seconds": null, "iteration": 1, "ts_ms": 1788783915871, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_5db86e4bef3d4dfc9b2c8935", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state. The pod requests a network-attachment-definition named 'unavailable-network' via annotation 'k8s.v1.cni.cncf.io/networks', but this resource is missing from the namespace, causing repeated Multus failures and sandbox creation errors.\nkey_facts: [\"Resource: Pod workload-5dbb5dcd6c-kbwsx (namespace: aiops-case-05)\", \"Node: node2/10.2.0.50\", \"Status: Pending (ContainerCreating)\", \"Container: app using image xnet.registry.io:8443/observability/python:3-alpine\", \"Network Config: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error Reason: NoNetworkFound / FailedCreatePodSandBox\", \"Error Source: multus kubelet\", \"Error Message: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Frequency: Events repeated over 59m+ (timestamps range 59m down to 51m)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/82b2da4eddaf404b-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/82b2da4eddaf404b-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/82b2da4eddaf404b-g1/tools/005-evidence-kubectl_describe.summary.txt"}

