data: {"id": "a94405013c094c64-thinking-parallel_evidence-1131", "run_id": "a94405013c094c64", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state due to Multus CNI network attachment failures. Events show repeated 'NoNetworkFound' and 'FailedCreatePodSandBox' err", "duration_seconds": null, "iteration": 1, "ts_ms": 1788781082394, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_a9b5f860b5b341b685bdfb49", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state due to Multus CNI network attachment failures. Events show repeated 'NoNetworkFound' and 'FailedCreatePodSandBox' errors because the network-attachment-definition 'unavailable-network' does not exist in the namespace.\nkey_facts: [\"Name: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error Reason: NoNetworkFound, FailedCreatePodSandBox\", \"Error Message: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05): network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"Timeline: Events started 48m ago, repeating every minute down to 45m ago\"]\nmissing: [\"Current Summary text was truncated in input, but raw_preview contained full event history; no conflicts found in available data.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/a94405013c094c64-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/a94405013c094c64-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/a94405013c094c64-g1/tools/004-evidence-kubectl_describe.summary.txt"}

