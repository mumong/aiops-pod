data: {"id": "6ff836bb74984594-thinking-parallel_evidence-507", "run_id": "6ff836bb74984594", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod 'workload-5dbb5dcd6c-kbwsx' in namespace 'aiops-case-05' is stuck in 'Pending' status on node 'node2'. The pod specifies a network attachment 'unavailable-network' via annotation 'k8s.v1.cni.cncf.", "duration_seconds": null, "iteration": 1, "ts_ms": 1788779865808, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_15291ab9daa64b8295c88ea2", "tool_sequence": 1, "semantic_success": true, "result": "Pod 'workload-5dbb5dcd6c-kbwsx' in namespace 'aiops-case-05' is stuck in 'Pending' status on node 'node2'. The pod specifies a network attachment 'unavailable-network' via annotation 'k8s.v1.cni.cncf.io/networks', but the corresponding NetworkAttachmentDefinition resource is missing in the namespace, causing Multus CNI to fail creating the pod sandbox repeatedly.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: FailedCreatePodSandBox (kubelet) & NoNetworkFound (multus)\", \"Message: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\"]", "raw_ref": "/tmp/aiops/reports/context_archives/6ff836bb74984594-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/6ff836bb74984594-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/6ff836bb74984594-g1/tools/005-evidence-kubectl_describe.summary.txt"}

