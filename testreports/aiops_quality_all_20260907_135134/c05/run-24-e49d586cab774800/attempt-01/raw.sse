data: {"id": "e49d586cab774800-node_complete-parallel_evidence", "run_id": "e49d586cab774800", "seq": 1276, "ts_ms": 1788781662294, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 44.272, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e49d586cab774800-g1/lane_artifacts/g1/artifact.json", "sha256": "6afae92917ac1c0da514ed8f70a72902c17c964e3083cdeaa05ef0e01644e734", "bytes": 2452}, "snapshot_sha256": "43704108490436aac7d38dac73871c69bab0b25aabb2ada749279ce9f7857da4"}]}, "handoff_summary": ""}

