data: {"id": "119ea61b5e944719-thinking-parallel_evidence-249", "run_id": "119ea61b5e944719", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 repeatedly fails to create pod sandbox due to missing NetworkAttachmentDefinition 'unavailable-network', resulting in continuous CNI plugin fai", "duration_seconds": null, "iteration": 1, "ts_ms": 1788782037682, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_954f9f4ce33e464a86a49b4a", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 repeatedly fails to create pod sandbox due to missing NetworkAttachmentDefinition 'unavailable-network', resulting in continuous CNI plugin failures.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Event Type: Warning\", \"Reason: NoNetworkFound\", \"Error: network-attachment-definition 'unavailable-network' not found in aiops-case-05\", \"Duration: Events observed over at least 10 minutes (60m to 50m ago)\", \"Count: 264 over 62m (cumulative)\"]\nmissing: [\"No specific node information provided in event list\", \"Container image details not shown in events\"]", "raw_ref": "/tmp/aiops/reports/context_archives/119ea61b5e944719-g1/tools/005-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/119ea61b5e944719-g1/tools/005-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/119ea61b5e944719-g1/tools/005-evidence-kubectl_events.summary.txt"}

