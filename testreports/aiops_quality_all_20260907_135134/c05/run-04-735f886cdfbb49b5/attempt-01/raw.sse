data: {"id": "735f886cdfbb49b5-thinking-parallel_evidence-51", "run_id": "735f886cdfbb49b5", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in aiops-case-05 is stuck in Pending status due to Multus CNI failure. The pod references a non-existent network-attachment-definition named 'unavailable-network' which d", "duration_seconds": null, "iteration": 1, "ts_ms": 1788778494351, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_e4af2b20ae6b49d2adb77c61", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in aiops-case-05 is stuck in Pending status due to Multus CNI failure. The pod references a non-existent network-attachment-definition named 'unavailable-network' which does not exist in the namespace.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx, Namespace: aiops-case-05, Node: node2/10.2.0.50\", \"Status: Pending, Reason: ContainerCreating\", \"Container Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Event: multus Warning NoNetworkFound: cannot find network-attachment-definition 'unavailable-network' in namespace aiops-case-05\", \"Event: kubelet Warning FailedCreatePodSandBox: failed to setup network, plugin multus failed (add)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/735f886cdfbb49b5-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/735f886cdfbb49b5-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/735f886cdfbb49b5-g1/tools/004-evidence-kubectl_describe.summary.txt"}

event: thinking
data: {"id": "735f886cdfbb49b5-thinking-parallel_evidence-52", "run_id": "735f886cdfbb49b5", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx (ns: aiops-case-05) scheduled on node2 fails with repeated Warning events NoNetworkFound and FailedCreatePodSandBox due to missing network-attachment-definition 'unavaila", "duration_seconds": null, "iteration": 1, "ts_ms": 1788778499888, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_46d9c5ff77dd439397a61294", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx (ns: aiops-case-05) scheduled on node2 fails with repeated Warning events NoNetworkFound and FailedCreatePodSandBox due to missing network-attachment-definition 'unavailable-network'. Multus CNI plugin consistently reports the error across multiple sandbox creation attempts over the last ~6 minutes.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx (Namespace: aiops-case-05)\", \"Node: node2 (Scheduled Successfully)\", \"Error: NoNetworkFound / FailedCreatePodSandBox\", \"Root Cause Message: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Missing Resource: network-attachment-definition.k8s.cni.cncf.io \\\"unavailable-network\\\"\", \"Plugin: multus-cni-network\", \"Frequency: Repeated warnings from 5m22s ago to 88s ago\"]", "raw_ref": "/tmp/aiops/reports/context_archives/735f886cdfbb49b5-g1/tools/005-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/735f886cdfbb49b5-g1/tools/005-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/73