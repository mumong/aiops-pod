data: {"id": "d496513908cb4799-node_complete-parallel_evidence", "run_id": "d496513908cb4799", "seq": 1201, "ts_ms": 1788783672945, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 46.415, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d496513908cb4799-g1/lane_artifacts/g1/artifact.json", "sha256": "af9b4d16a7e1922f6eec23aa3ed3cf467efff1c6f3860129a34fb543dccd1365", "bytes": 2452}, "snapshot_sha256": "36588338960607a1b3620dc33817ad7ea3163432db0c1ab2e8a81f606327b498"}]}, "handoff_summary": ""}

