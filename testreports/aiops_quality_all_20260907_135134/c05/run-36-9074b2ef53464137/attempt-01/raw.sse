data: {"id": "9074b2ef53464137-thinking-parallel_evidence-931", "run_id": "9074b2ef53464137", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx (ns: aiops-case-05) is in Pending state on node2. The pod references a non-existent network attachment definition 'unavailable-network' via k8s.v1.cni.cncf.io/networks an", "duration_seconds": null, "iteration": 1, "ts_ms": 1788782953015, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_a55c39a7743d4d8ea12bf9fc", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx (ns: aiops-case-05) is in Pending state on node2. The pod references a non-existent network attachment definition 'unavailable-network' via k8s.v1.cni.cncf.io/networks annotation. Multus and kubelet are repeatedly failing to create the pod sandbox due to this missing network resource.\nkey_facts: [\"Name: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app, Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Event: Warning NoNetworkFound from multus\", \"Event: Warning FailedCreatePodSandBox from kubelet\", \"Error: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Repetition: NoNetworkFound events span 60m-52m; FailedCreatePodSandBox occurred x335 over 77m\"]", "raw_ref": "/tmp/aiops/reports/context_archives/9074b2ef53464137-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/9074b2ef53464137-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/9074b2ef53464137-g1/tools/004-evidence-kubectl_describe.summary.txt"}

