data: {"id": "09711460104440bc-thinking-parallel_evidence-908", "run_id": "09711460104440bc", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state. Multus CNI plugin failed to create pod sandbox because the referenced network-attachment-definition 'unavailable-net", "duration_seconds": null, "iteration": 1, "ts_ms": 1788780159527, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_1d9da6bda26740f491b826e5", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending state. Multus CNI plugin failed to create pod sandbox because the referenced network-attachment-definition 'unavailable-network' does not exist in the namespace.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx (namespace: aiops-case-05, node: node2/10.2.0.50)\", \"Status: Pending (ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: Network-attachment-definition 'unavailable-network' not found in namespace aiops-case-05\", \"Events: Warning NoNetworkFound (multus), Warning FailedCreatePodSandBox (kubelet) repeated approx. every 1 minute from 33m to 30m ago\"]\nconflicts: [\"current_summary contains partial/cut-off error messages; raw_preview provides complete event logs and Pod metadata details (e.g., annotations, container state, image).\"]", "raw_ref": "/tmp/aiops/reports/context_archives/09711460104440bc-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/09711460104440bc-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/09711460104440bc-g1/tools/004-evidence-kubectl_describe.summary.txt"}

