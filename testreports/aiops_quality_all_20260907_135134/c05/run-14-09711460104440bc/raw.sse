data: {"id": "09711460104440bc-thinking-parallel_evidence-910", "run_id": "09711460104440bc", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 repeatedly fails to create pod sandbox due to missing NetworkAttachmentDefinition 'unavailable-network'. The pod was successfully scheduled to ", "duration_seconds": null, "iteration": 1, "ts_ms": 1788780164737, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_b94c78ff615746fb98d0a23e", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 repeatedly fails to create pod sandbox due to missing NetworkAttachmentDefinition 'unavailable-network'. The pod was successfully scheduled to node2, but Multus CNI plugin fails to find the required network definition, triggering continuous NoNetworkFound and FailedCreatePodSandBox warnings over the last 33 minutes.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2\", \"Error: cannot find a network-attachment-definition (unavailable-network)\", \"Reason: NoNetworkFound, FailedCreatePodSandBox\", \"Plugin: multus-cni-network\", \"Duration: Events observed from 33m ago to 29m ago\", \"Status: Scheduled but not running due to network setup failure\"]", "raw_ref": "/tmp/aiops/reports/context_archives/09711460104440bc-g1/tools/006-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/09711460104440bc-g1/tools/006-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/09711460104440bc-g1/tools/006-evidence-kubectl_events.s