data: {"id": "11992a5fb3a2439f-node_complete-parallel_evidence", "run_id": "11992a5fb3a2439f", "seq": 1314, "ts_ms": 1788783242613, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 48.477, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/11992a5fb3a2439f-g1/lane_artifacts/g1/artifact.json", "sha256": "1a20c6cce93588510d7194c420b553e0cdf85dbe462123d3a53162ebf98db331", "bytes": 2452}, "snapshot_sha256": "eee095ebd733cc46886fd4c455c3eaf838b0b75a5aa59b4ef9febd8aa306a11e"}]}, "handoff_summary": ""}

