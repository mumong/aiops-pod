data: {"id": "11992a5fb3a2439f-thinking-parallel_evidence-678", "run_id": "11992a5fb3a2439f", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx 在 namespace aiops-case-05 中处于 Pending 状态，ContainerCreating 中。事件显示因找不到 network-attachment-definition 'unavailable-network' 导致 Multus CNI 插件失败，Pod 无法创建 Sandbox。\nkey_facts: ", "duration_seconds": null, "iteration": 1, "ts_ms": 1788783217099, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_698d1dd49b524238882eaa5a", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx 在 namespace aiops-case-05 中处于 Pending 状态，ContainerCreating 中。事件显示因找不到 network-attachment-definition 'unavailable-network' 导致 Multus CNI 插件失败，Pod 无法创建 Sandbox。\nkey_facts: [\"name: workload-5dbb5dcd6c-kbwsx\", \"namespace: aiops-case-05\", \"node: node2/10.2.0.50\", \"status: Pending\", \"container: app, image: xnet.registry.io:8443/observability/python:3-alpine, state: Waiting, Reason: ContainerCreating\", \"annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Warning NoNetworkFound: cannot find network-attachment-definition 'unavailable-network' in namespace aiops-case-05\", \"Warning FailedCreatePodSandBox: failed to setup network for sandbox, plugin multus failed\"]", "raw_ref": "/tmp/aiops/reports/context_archives/11992a5fb3a2439f-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/11992a5fb3a2439f-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/11992a5fb3a2439f-g1/tools/004-evidence-kubectl_describe.summary.txt"}

