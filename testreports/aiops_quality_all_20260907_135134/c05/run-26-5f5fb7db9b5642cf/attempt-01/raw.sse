data: {"id": "5f5fb7db9b5642cf-thinking-parallel_evidence-239", "run_id": "5f5fb7db9b5642cf", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending status due to failed network setup. The pod references a non-existent NetworkAttachmentDefinition 'unavailable-network', ca", "duration_seconds": null, "iteration": 1, "ts_ms": 1788781783309, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_8925e22e80de4a12b4df4cf3", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 is stuck in Pending status due to failed network setup. The pod references a non-existent NetworkAttachmentDefinition 'unavailable-network', causing repeated failures by kubelet and multus plugins.\nkey_facts: [\"Pod Name: workload-5dbb5dcd6c-kbwsx\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Container State: Waiting (Reason: ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Warning Event (multus, 60m-57m): 'NoNetworkFound' - cannot find network-attachment-definition 'unavailable-network' in namespace 'aiops-case-05'\", \"Warning Event (kubelet, 60m-58m): 'FailedCreatePodSandBox' - failed to setup network for sandbox due to missing delegate 'unavailable-network'\"]", "raw_ref": "/tmp/aiops/reports/context_archives/5f5fb7db9b5642cf-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/5f5fb7db9b5642cf-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/5f5fb7db9b5642cf-g1/tools/005-evidence-kubectl_describe.summary.txt"}

