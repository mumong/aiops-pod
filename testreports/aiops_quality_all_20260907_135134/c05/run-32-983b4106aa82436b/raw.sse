data: {"id": "983b4106aa82436b-thinking-parallel_evidence-158", "run_id": "983b4106aa82436b", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 fails to create sandbox due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Object: Pod/workload-5dbb5dcd6c-kbwsx, N", "duration_seconds": null, "iteration": 2, "ts_ms": 1788782588087, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-kbwsx"}, "dimension": "kubernetes"}, "tool_call_id": "call_1ace42a53e3e416a83ed4646", "tool_sequence": 4, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-kbwsx in namespace aiops-case-05 fails to create sandbox due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Object: Pod/workload-5dbb5dcd6c-kbwsx, Namespace: aiops-case-05\", \"Error: FailedCreatePodSandBox\", \"Root Cause: Network-attachment-definition 'unavailable-network' not found in namespace aiops-case-05\", \"Frequency: Event 'NoNetworkFound' repeated ~311 times over 71m; 'FailedCreatePodSandBox' combined warning present\", \"Reason: NoNetworkFound\", \"Timeframe: Events span from 60m ago to recent\"]", "raw_ref": "/tmp/aiops/reports/context_archives/983b4106aa82436b-g1/tools/007-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/983b4106aa82436b-g1/tools/007-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/983b4106aa82436b-g1/tools/007-evidence-kubectl_events.summary.txt"}

