data: {"id": "64c9abd2d67d4007-node_complete-parallel_evidence", "run_id": "64c9abd2d67d4007", "seq": 1625, "ts_ms": 1788823719664, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 38.161, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/64c9abd2d67d4007-g1/lane_artifacts/g1/artifact.json", "sha256": "aaeca50c010bd2fac16df5e12c966636c46aa60d8081ccdc1d7d43c9511ada1f", "bytes": 2418}, "snapshot_sha256": "8b2ce61b9df49ea335271c853017b0ed52fce11a2988328821ea9468902f7bdd"}]}, "handoff_summary": ""}

