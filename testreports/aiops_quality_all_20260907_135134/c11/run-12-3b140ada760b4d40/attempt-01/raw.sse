data: {"id": "3b140ada760b4d40-thinking-parallel_evidence-771", "run_id": "3b140ada760b4d40", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "read_context_archive", "content": null, "status": "success", "result_preview": "read_context_archive 输出摘要: raw_chars=790 lines=3\nquery_pod_tracing on aiops-case-11/workload (node2) found 2 HTTP /ready requests to 172.16.104.48 at 07:09:46, both 200 OK; no failed/timeout flows, no", "duration_seconds": null, "iteration": 10, "ts_ms": 1788823981606, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "other"}, "tool_call_id": "call_803a8ce028464a27b5a8717b", "tool_sequence": 22, "semantic_success": true, "result": "read_context_archive 输出摘要: raw_chars=790 lines=3\nquery_pod_tracing on aiops-case-11/workload (node2) found 2 HTTP /ready requests to 172.16.104.48 at 07:09:46, both 200 OK; no failed/timeout flows, no tempo spans (absent).\nkey_facts: [\"Pod: aiops-case-11/workload (uid 1cc226c9-d72d-4505-a057-b5022eaf5111) on node2, IP 172.16.104.48, container app\", \"Queried L7 flows in 23:09:00Z-23:09:46Z (UTC); returned 2 flows\", \"Flow 1: src 10.2.0.50 -> 172.16.104.48 HTTP GET /ready code=200 dur=1030us\", \"Flow 2: src 10.2.0.50 -> 172.16.104.48 HTTP GET /ready code=200 dur=394us\", \"No failed/timeout HTTP/gRPC requests found in window\", \"Telemetry: deepflow present; tempo absent (reason: no_valid_trace_ids; span_count=0)\"]\nmissing: [\"No failed or timed out L7 requests in the queried window\", \"No tempo span data available (no valid trace IDs)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/3b140ada760b4d40-g1/tools/024-evidence-read_context_archive.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/3b140ada760b4d40-g1/tools/024-evidence-read_context_archive.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/3b140ada760b4d40-g1/tools/024-evidence-read_context_archive.summary.txt"}

