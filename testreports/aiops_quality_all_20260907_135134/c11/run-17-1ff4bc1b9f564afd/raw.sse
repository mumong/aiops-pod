data: {"id": "1ff4bc1b9f564afd-node_complete-parallel_evidence", "run_id": "1ff4bc1b9f564afd", "seq": 868, "ts_ms": 1788824480102, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 31.294, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/1ff4bc1b9f564afd-g1/lane_artifacts/g1/artifact.json", "sha256": "2be0dfd625c40afaa14bcfcb28b25555402965da01699b2c5e780fe05ecc0f02", "bytes": 2418}, "snapshot_sha256": "cca5ec4cc27e5b696b6861358547c21c3f56301b015348339b977afdf3e5288e"}]}, "handoff_summary": ""}

