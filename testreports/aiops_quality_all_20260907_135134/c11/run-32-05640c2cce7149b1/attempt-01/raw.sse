data: {"id": "05640c2cce7149b1-node_complete-parallel_evidence", "run_id": "05640c2cce7149b1", "seq": 1169, "ts_ms": 1788825590785, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.361, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 0, "inconclusive_count": 1, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "inconclusive", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/05640c2cce7149b1-g1/lane_artifacts/g1/artifact.json", "sha256": "14eb897b1521d62206b1c67fb248063b47c0f8367fb5061e73339b6e4204e3ec", "bytes": 2420}, "snapshot_sha256": "550b2f681ed1384ea145d3f1cc03caaf31f7b9f23aca7ae49310598cd99825b6"}]}, "handoff_summary": ""}

