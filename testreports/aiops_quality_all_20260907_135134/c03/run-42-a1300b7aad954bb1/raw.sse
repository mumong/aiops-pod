data: {"id": "a1300b7aad954bb1-node_complete-parallel_evidence", "run_id": "a1300b7aad954bb1", "seq": 2573, "ts_ms": 1788772858792, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 36.56, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-2xgjz"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/a1300b7aad954bb1-g1/lane_artifacts/g1/artifact.json", "sha256": "70a0659c4213a3402a4a41eb6048c4acd9d2c026d62c5f5bbbb47f4bf44d8cbe", "bytes": 2452}, "snapshot_sha256": "071320cebf9be8d31f375fd65ff76dc8c7d45d32048da866100680e47a37b5b5"}]}, "handoff_summary": ""}

