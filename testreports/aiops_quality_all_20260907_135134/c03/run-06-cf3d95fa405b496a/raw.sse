data: {"id": "cf3d95fa405b496a-node_complete-parallel_evidence", "run_id": "cf3d95fa405b496a", "seq": 1181, "ts_ms": 1788768980032, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 33.1, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-2xgjz"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/cf3d95fa405b496a-g1/lane_artifacts/g1/artifact.json", "sha256": "88b6586797b6a4a2f3d87b9b315a28e237da4b937d5262da974e60a430ba5866", "bytes": 2452}, "snapshot_sha256": "ccd7fa7833c0f8c51e2a529bcf1778c2d4a966532307887adaf81a687f8f57f0"}]}, "handoff_summary": ""}

