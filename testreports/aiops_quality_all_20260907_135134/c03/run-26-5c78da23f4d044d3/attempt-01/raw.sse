data: {"id": "5c78da23f4d044d3-node_complete-parallel_evidence", "run_id": "5c78da23f4d044d3", "seq": 1292, "ts_ms": 1788771202370, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.245, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-2xgjz"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5c78da23f4d044d3-g1/lane_artifacts/g1/artifact.json", "sha256": "35511b6f0456e4dd33ff12c533f428f5ae00b5a241b02bd8bb03dd1f6feb45da", "bytes": 2452}, "snapshot_sha256": "dd1211530a9cb8157f72feb4b71c0c97ab44ef8087ce4760a68b725031edbdcd"}]}, "handoff_summary": ""}

