data: {"id": "1e4a4138bc02478c-node_complete-parallel_evidence", "run_id": "1e4a4138bc02478c", "seq": 536, "ts_ms": 1788772506055, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 547.722, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-2xgjz"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/1e4a4138bc02478c-g1/lane_artifacts/g1/artifact.json", "sha256": "7243deb71dc5930df4283452f0ffe8abb2574a90065ba774df9808592c7157fa", "bytes": 2451}, "snapshot_sha256": "cb06e2a91c6ced75e583cd13b30b2c448f2fb63ee9f48393955863c8db9b1aac"}]}, "handoff_summary": ""}

