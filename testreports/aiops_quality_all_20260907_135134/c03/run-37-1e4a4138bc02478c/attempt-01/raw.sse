 \"possible_scenarios\": [{\"scenario\": \"PV Pending 导致 PVC 无法绑定及 Pod 挂载失败\", \"probability\": \"high\", \"reason\": \"monitor 命名空间下多个 byconity 相关的 PV 长期处于 Pending 状态，表明存储供给存在问题（如本地盘不可用、亲和性不匹配或容量不足），这会导致依赖这些卷的 PVC 无法绑定，进而导致相关 Pod (如 workload-5b5fc86c8c-2xgjz 或其他 byconity Pod) 处于 ContainerCreating 或 Pending 状态，引发 VolumeMountFailed。\"}, {\"scenario\": \"特定 Pod 的 Volume 配置错误\", \"probability\": \"medium\", \"reason\": \"workload-5b5fc86c8c-2xgjz 在 aiops-case-03 命名空间下长时间 ContainerCreating，可能是其引用的 ConfigMap/Secret 不存在或 PVC 未绑定，导致卷挂载失败。\"}], \"abnormal_groups\": [{\"group_id\": \"g1\", \"status_keywords\": [\"ContainerCreating\"], \"pod_abnormal_type\": \"ContainerCreating\", \"compatible_layers\": [], \"entities\": [{\"kind\": \"Pod\", \"namespace\": \"aiops-case-03\", \"name\": \"workload-5b5fc86c8c-2xgjz\"}], \"evidence_plan\": [], \"possible_scenarios\": [{\"scenario\": \"ContainerCreating 的直接原因待验证\", \"probability\": \"未知\", \"reason\": \"当前阶段只定位异常；根因必须由后续实时 canonical facts 确认\"}], \"matched_runbooks\": [\"pod-volume-mount-failed.md\"]}], \"issue_groups\": [{\"group_id\": \"g1\", \"status_keywords\": [\"ContainerCreating\"], \"pod_abnormal_type\": \"ContainerCreating\", \"compatible_layers\": [], \"entities\": [{\"kind\": \"Pod\", \"namespace\": \"aiops-case-03\", \"name\": \"workload-5b5fc86c8c-2xgjz\"}], \"evidence_plan\": [], \"possible_scenarios\": [{\"scenario\": \"ContainerCreating 的直接原因待验证\", \"probability\": \"未知\", \"reason\": \"当前阶段只定位异常；根因必须由后续实时 canonical facts 确认\"}], \"matched_runbooks\": [\"pod-volume-mount-failed.md\"]}], \"current_abnormal_summary\": {\"source\": \"kubectl_get_by_name\", \"status_counts\": {\"ContainerCreating\": 1}, \"total_abnormal\": 1, \"selected_rows\": [\"workload-5b5fc86c8c-2xgjz   0/1     ContainerCreating   0          56m   <none>   node2   <none>           <none>            aiops.lab/case-id=c03,app.kubernetes.io/name=workload,pod-template-hash=5b5fc86c8c\"], \"raw_ref\": \"/tmp/aiops/reports/context_archives/1e4a4138bc024