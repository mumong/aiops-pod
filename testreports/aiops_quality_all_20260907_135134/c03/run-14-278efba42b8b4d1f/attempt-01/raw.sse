data: {"id": "278efba42b8b4d1f-node_complete-parallel_evidence", "run_id": "278efba42b8b4d1f", "seq": 1287, "ts_ms": 1788770073078, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 45.382, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-2xgjz"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/278efba42b8b4d1f-g1/lane_artifacts/g1/artifact.json", "sha256": "67f8f56126a79f47aad13e41dda37cbcbb0cf7812889fb7badc9231f37a09a2b", "bytes": 2452}, "snapshot_sha256": "96dd9f7d50919cd3ee398a71023ff134d9ddfd4c9d14866b6ee6f3d6290f249c"}]}, "handoff_summary": ""}

