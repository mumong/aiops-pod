data: {"id": "df028417f0b54ce8-node_complete-parallel_evidence", "run_id": "df028417f0b54ce8", "seq": 478, "ts_ms": 1788766451958, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 27.157, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-nqrzv"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/df028417f0b54ce8-g1/lane_artifacts/g1/artifact.json", "sha256": "f0dc9704a290b2033284fcdde763eeead703d18442c689ecf7a8440cc67dd382", "bytes": 2632}, "snapshot_sha256": "00947ae2b10c52782c82f5a227126efe34fb9a7e827f234c6cee518472963646"}]}, "handoff_summary": ""}

