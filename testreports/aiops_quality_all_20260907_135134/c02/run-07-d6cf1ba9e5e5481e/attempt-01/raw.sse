data: {"id": "d6cf1ba9e5e5481e-node_complete-parallel_evidence", "run_id": "d6cf1ba9e5e5481e", "seq": 1216, "ts_ms": 1788765100662, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 35.28, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-nqrzv"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d6cf1ba9e5e5481e-g1/lane_artifacts/g1/artifact.json", "sha256": "e9a883a2f3e4b7e0d1ff83ddad40aa3c93fb5fc624f7ee09453976a89ef763e5", "bytes": 2633}, "snapshot_sha256": "a168cefae43e7e3f107fbd7175375dc30cf7ebf448082150347e42b18e414794"}]}, "handoff_summary": ""}

