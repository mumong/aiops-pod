data: {"id": "7937440848fe497b-node_complete-parallel_evidence", "run_id": "7937440848fe497b", "seq": 979, "ts_ms": 1788766851318, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 27.518, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-nqrzv"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/7937440848fe497b-g1/lane_artifacts/g1/artifact.json", "sha256": "ba291d42c9197620c3a6063134e496d769c0cb792045eae855336cb7d40ba39c", "bytes": 2633}, "snapshot_sha256": "05f412d8e572f42708b1d0f62a8c9d49def9a975dd599c9f3590838bc7f92338"}]}, "handoff_summary": ""}

