data: {"id": "6bdb7332588d4cbe-node_complete-parallel_evidence", "run_id": "6bdb7332588d4cbe", "seq": 1371, "ts_ms": 1788766071004, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 87.186, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-nqrzv"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/6bdb7332588d4cbe-g1/lane_artifacts/g1/artifact.json", "sha256": "5822db99dc98993e076ce8ea5fadaa9fc73f4630abe8d22fe4687e80377287ad", "bytes": 2451}, "snapshot_sha256": "3fb8bde5177dda01f084e452b8b1d9fbeab7ffde355a11553461965356992fa8"}]}, "handoff_summary": ""}

