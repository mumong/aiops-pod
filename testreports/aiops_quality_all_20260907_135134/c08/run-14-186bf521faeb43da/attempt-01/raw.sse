data: {"id": "186bf521faeb43da-node_complete-parallel_evidence", "run_id": "186bf521faeb43da", "seq": 1076, "ts_ms": 1788801092847, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 63.866, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-wmjhr"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/186bf521faeb43da-g1/lane_artifacts/g1/artifact.json", "sha256": "40c05ff1b89dd31ecd6458cd19ae5b9baa954070f3610d28efa8c2e4ace53388", "bytes": 2452}, "snapshot_sha256": "b1e6a68703abfa4757b2a9247cd3a5bc05e8811a8365ce8c556e4ce505991908"}]}, "handoff_summary": ""}

