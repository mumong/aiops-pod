0.6s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-08/workload-5c9c7b6489-wmjhr**: pod-oomkilled\n", "answer_source": "workflow", "elapsed_seconds": 188.563, "metrics": {"run_id": "bb352188770c46c4", "mttr": {"value": "3.1m", "seconds": 188.56937432289124, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-oomkilled", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-oomkilled"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 188569.37432289124, "llm_calls": 22, "llm_duration_ms": 94567.35825538635, "tool_calls": 36, "executed_tool_calls": 28, "deduplicated_tool_calls": 7, "successful_tool_calls": 35, "failed_tool_calls": 1, "tool_duration_ms": 194138.1688117981, "tool_wall_duration_ms": 93510.28060913086}, "nodes": {"layer": {"name": "问题定位", "duratio