data: {"id": "7dd74c9abd224784-node_complete-parallel_evidence", "run_id": "7dd74c9abd224784", "seq": 390, "ts_ms": 1788806356381, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 69.58, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-wmjhr"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/7dd74c9abd224784-g1/lane_artifacts/g1/artifact.json", "sha256": "cf808cc66c81c92c881b5c3984ece56a062edb492edc1806052e6ec1c54275f9", "bytes": 2452}, "snapshot_sha256": "d618b56874969757acca4a2859d614b0611b949c53a3b3d8840e0535201823f1"}]}, "handoff_summary": ""}

