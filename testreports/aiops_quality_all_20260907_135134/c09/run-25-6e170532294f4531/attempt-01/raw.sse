data: {"id": "6e170532294f4531-thinking-parallel_evidence-563", "run_id": "6e170532294f4531", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "read_context_archive", "content": null, "status": "success", "result_preview": "Pod workload-5f4fb9ff45-7b77l (ns: aiops-case-09) is Running on node2 but stuck in NotReady state. Readiness probes fail repeatedly: initial connection refused, followed by persistent 503 errors (935 ", "duration_seconds": null, "iteration": 4, "ts_ms": 1788810213461, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "other"}, "tool_call_id": "call_f77a43474c1344c88910c191", "tool_sequence": 11, "semantic_success": true, "result": "Pod workload-5f4fb9ff45-7b77l (ns: aiops-case-09) is Running on node2 but stuck in NotReady state. Readiness probes fail repeatedly: initial connection refused, followed by persistent 503 errors (935 times over 47m). Container 'app' is Running with 0 restarts.\nkey_facts: [\"Pod: workload-5f4fb9ff45-7b77l | Namespace: aiops-case-09 | Node: node2/10.2.0.50\", \"Container 'app': Image xnet.registry.io:8443/observability/python:3-alpine, Port 8080/TCP, State: Running, Restart Count: 0\", \"Readiness Probe: http://:http/ready (delay=2s, timeout=1s)\", \"Conditions: Initialized=True, Ready=False, ContainersReady=False, PodScheduled=True\", \"Events: Warning Unhealthy 47m ago - connection refused\", \"Events: Warning Unhealthy 2m12s (x935 over 47m) - HTTP probe failed with statuscode: 503\", \"Environment: FAILURE_MODE=readiness_fail\"]\nmissing: [\"No specific Exit Code provided (Container is Running, not Terminated)\", \"No Liveness probe events reported\", \"No OOMKilled or CrashLoopBackOff indicators\"]", "raw_ref": "/tmp/aiops/reports/context_archives/6e170532294f4531-g1/tools/014-evidence-read_context_archive.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/6e17