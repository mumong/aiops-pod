data: {"id": "92e2145d88b64fdc-node_complete-parallel_evidence", "run_id": "92e2145d88b64fdc", "seq": 1099, "ts_ms": 1788810648975, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 46.411, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/92e2145d88b64fdc-g1/lane_artifacts/g1/artifact.json", "sha256": "696c4b160b2a38a25a3d3521513f04d391986c808c96fee1b9fad1f23db5ee2b", "bytes": 2452}, "snapshot_sha256": "b3022f2872df1186264d26da8098ace7c3a551fb8feb935d2e94e8a281ecbab3"}]}, "handoff_summary": ""}

