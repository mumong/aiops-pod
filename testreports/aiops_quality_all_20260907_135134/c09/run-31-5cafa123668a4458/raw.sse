data: {"id": "5cafa123668a4458-node_complete-parallel_evidence", "run_id": "5cafa123668a4458", "seq": 565, "ts_ms": 1788810864886, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 65.602, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5cafa123668a4458-g1/lane_artifacts/g1/artifact.json", "sha256": "e2e08487e469dedf06e05f5c9608c536398e0a856f5802789f875bdeb87429f0", "bytes": 2452}, "snapshot_sha256": "bbc98ec8621ea6ca4d2fe869a6e79e96229bfd589408ed014475560a42b7230e"}]}, "handoff_summary": ""}

