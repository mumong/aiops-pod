data: {"id": "907d4209a852407f-node_complete-parallel_evidence", "run_id": "907d4209a852407f", "seq": 1840, "ts_ms": 1788810106622, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 95.824, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/907d4209a852407f-g1/lane_artifacts/g1/artifact.json", "sha256": "af03627fbb11962f41c53fad609e4d0d1619d681a1ba1995d5b291104e516ca4", "bytes": 2452}, "snapshot_sha256": "52ca9b1d9f1be6c78ae83547994b3a373b772c3bfffd85d2444a35f0e403a3c4"}]}, "handoff_summary": ""}

