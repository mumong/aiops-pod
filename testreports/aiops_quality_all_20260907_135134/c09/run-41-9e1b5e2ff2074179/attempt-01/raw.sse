data: {"id": "9e1b5e2ff2074179-node_complete-parallel_evidence", "run_id": "9e1b5e2ff2074179", "seq": 1822, "ts_ms": 1788812467885, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 184.744, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/9e1b5e2ff2074179-g1/lane_artifacts/g1/artifact.json", "sha256": "a6741b0501b500aae5e91f9a3888173458981d06feb5535d490ee25bf80ec4cd", "bytes": 2452}, "snapshot_sha256": "fdeb27d0e51eeb706efda6d8b441ff65090c95e42ab1f4954154579eb0711464"}]}, "handoff_summary": ""}

