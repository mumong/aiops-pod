data: {"id": "77721463c8564621-node_complete-parallel_evidence", "run_id": "77721463c8564621", "seq": 1365, "ts_ms": 1788808463928, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 71.634, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/77721463c8564621-g1/lane_artifacts/g1/artifact.json", "sha256": "099a8a928fdc99740f540ae5e0e057e4cdb7193ca118d47d5e161b0f19465ab1", "bytes": 2452}, "snapshot_sha256": "1da1e742a7441062a364157c09a3bfb78f52b66ae62750d571f2824e3a10537a"}]}, "handoff_summary": ""}

