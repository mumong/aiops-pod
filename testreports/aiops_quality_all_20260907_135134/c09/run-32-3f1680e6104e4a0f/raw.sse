e": "workflow", "elapsed_seconds": 184.502, "metrics": {"run_id": "3f1680e6104e4a0f", "mttr": {"value": "3.1m", "seconds": 184.50859260559082, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "50%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-notready-probe-failed", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-notready-probe-failed"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.9, "weighted_score": 0.18, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 90%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 184508.59260559082, "llm_calls": 18, "llm_duration_ms": 123755.39970397949, "tool_calls": 30, "executed_tool_calls": 17, "deduplicated_tool_calls": 13, "successful_tool_calls": 29, "failed_tool_calls": 1, "tool_duration_ms": 65486.67788505554, "tool_wall_duration_ms": 44445.579528808594}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 20601.728916168213, "success": true}, "parallel_evidence": {"name": "并发证据采