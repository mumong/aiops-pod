data: {"id": "3f1680e6104e4a0f-thinking-parallel_evidence-2295", "run_id": "3f1680e6104e4a0f", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_get_yaml", "content": null, "status": "success", "result_preview": "Pod workload-5f4fb9ff45-7b77l in aiops-case-09 is in Running phase but conditions indicate it is not ready. The container 'app' has not started successfully, as shown by Ready=False and ContainersNotR", "duration_seconds": null, "iteration": 10, "ts_ms": 1788811045304, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}, "dimension": "kubernetes"}, "tool_call_id": "call_e7f423879b914895979cc57c", "tool_sequence": 23, "semantic_success": false, "result": "Pod workload-5f4fb9ff45-7b77l in aiops-case-09 is in Running phase but conditions indicate it is not ready. The container 'app' has not started successfully, as shown by Ready=False and ContainersNotReady reason.\nkey_facts: [\"Pod: workload-5f4fb9ff45-7b77l, Namespace: aiops-case-09, Node: node2\", \"Phase: Running, Creation: 2026-09-07T18:55:18Z\", \"Container 'app' image: xnet.registry.io:8443/observability/python:3-alpine\", \"Conditions: Ready=False, ContainersReady=False, Reason=ContainersNotReady, Message=containers with unready status: [app]\", \"ContainerStatus: app ready=False, restarts=0, exitCode=None\", \"Volumes: code (configMap: workload-code)\"]\nconflicts: [\"current_summary states 'phase: Running' but implies health by omission of errors; raw_preview clarifies Running phase but with explicit Ready=False and ContainersNotReady conditions.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/3f1680e6104e4a0f-g1/tools/026-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/3f1680e6104e4a0f-g1/tools/026-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/3f1680e6104e4a0f-g1/tools/026-evidence-kubectl_get_yaml.summary.txt"}

