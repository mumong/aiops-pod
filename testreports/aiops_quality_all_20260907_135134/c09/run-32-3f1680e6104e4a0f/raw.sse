data: {"id": "3f1680e6104e4a0f-thinking-parallel_evidence-2294", "run_id": "3f1680e6104e4a0f", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5f4fb9ff45-7b77l (ns: aiops-case-09, node: node2) is Running but failing readiness probes due to connection refused and HTTP 503 on port 8080.\nkey_facts: [\"name: workload-5f4fb9ff45-7b77l", "duration_seconds": null, "iteration": 10, "ts_ms": 1788811039397, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}, "dimension": "kubernetes"}, "tool_call_id": "call_b59a95ffd39c452eb389ab9a", "tool_sequence": 22, "semantic_success": true, "result": "Pod workload-5f4fb9ff45-7b77l (ns: aiops-case-09, node: node2) is Running but failing readiness probes due to connection refused and HTTP 503 on port 8080.\nkey_facts: [\"name: workload-5f4fb9ff45-7b77l\", \"namespace: aiops-case-09\", \"node: node2/10.2.0.50\", \"status: Running\", \"Container ID: 2e98dd2\", \"Warning: Readiness probe failed: connect connection refused (60m ago)\", \"Warning: Readiness probe failed: HTTP 503 (x1246 over 60m)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/3f1680e6104e4a0f-g1/tools/025-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/3f1680e6104e4a0f-g1/tools/025-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/3f1680e6104e4a0f-g1/tools/025-evidence-kubectl_describe.summary.txt"}

