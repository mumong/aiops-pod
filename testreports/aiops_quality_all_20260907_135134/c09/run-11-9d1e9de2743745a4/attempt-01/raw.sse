w\",\"trace_type\":\"flow\"},{\"confidence\":\"low\",\"data\":{\"attributes\":{\"aiops.observed_mode\":\"readiness_fail\",\"http.request.method\":\"GET\",\"http.response.status_code\":503,\"http.route\":\"/work\"},\"end\":\"2026-09-07T19:05:06.937119Z\",\"name\":\"GET /work\",\"service\":\"aiops-lab-workload\",\"span_id\":\"57c4f3287af76d7a\",\"start\":\"2026-09-07T19:05:06.937115Z\",\"timestamp\":{\"utc\":\"2026-09-07T19:05:06.937115Z\"},\"trace_id\":\"31ec3d8c25090102beff7a23fe74e0ee\"},\"directness\":\"related_context\",\"id\":\"fact-a7a2daf8adb9\",\"pattern_count\":3,\"pattern_exemplar\":\"head\",\"source_system\":\"tempo\",\"trace_type\":\"span\"},{\"confidence\":\"high\",\"data\":{\"dst_ip\":\"172.16.104.35\",\"duration_us\":\"10394\",\"protocol\":\"HTTP\",\"request_resource\":\"/work\",\"request_type\":\"GET\",\"response_code\":503,\"response_status\":3,\"span_id\":\"d12c9e3a2f725481\",\"src_ip\":\"172.16.104.55\",\"syscall_trace_id_request\":\"594331182594051457\",\"syscall_trace_id_response\":\"594331182594051461\",\"timestamp\":{\"utc\":\"2026-09-07T19:13:40Z\"},\"trace_id\":\"0f30411dfcb6175380ad648706d4e7de\"},\"directness\":\"direct\",\"id\":\"fact-67cb5f29b5ea\",\"pattern_count\":20,\"pattern_exemplar\":\"tail\",\"source_system\":\"deepflow\",\"trace_type\":\"flow\"}],\"retrieval\":{\"mcp_response_complete\":true,\"raw_ref\":\"/tmp/aiops/reports/context_archives/9d1e9de2743745a4-g1/tools/003-evidence-query_pod_tracing.raw.txt\",\"tool\":\"read_context_archive\"},\"source_coverage\":{\"deepflow\":{\"coverage\":\"present\",\"directness\":\"direct\"},\"tempo\":{\"coverage\":\"present\",\"executed\":true,\"failed_trace_count\":0,\"queried_trace_count\":5,\"successful_lookup_count\":5}},\"source_system\":\"deepflow+tempo\",\"status\":\"query_succeeded\",\"summary_selection\":{\"omitted\":20,\"selected\":3,\"strategy\":\"information_ranked_pattern_round_robin_budget_scan_no_fault_names\"},\"tool\":\"query_pod_tracing\",\"truncation\":{\"mcp_response_truncated\":false,\"reason_detail_complete\":true,\"reasons\":[\"sql_limit_reached_possible_more_rows\",\"source_or_collection_limit\"],\"source_or_collection_truncated\":true,\"truncated\":true},\"window\":{\"end\":\"2026-09-07T19:15:05.903574Z\",\"start\":\"2026-09-07T18:45:05.903574Z\"}}", "raw_ref": "/tmp/aiops/reports/context_archives/9d1e9de2743745a4-g1/tools/003-evidence-query_pod_tracing.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/9d1e9de2743745a4-g1/tools/003-evidence-query_pod_tracing.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/9d1e9de2743745a4-g1/tools/003-evidence-query_pod_tracing.summary.txt"}

