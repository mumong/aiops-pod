data: {"id": "0f5be6efafb84398-node_complete-parallel_evidence", "run_id": "0f5be6efafb84398", "seq": 1524, "ts_ms": 1788807758016, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 87.958, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0f5be6efafb84398-g1/lane_artifacts/g1/artifact.json", "sha256": "d2432492a95eabca489d33ef1807d517eb2b384446adbc3d94997c75ce3de9a5", "bytes": 2452}, "snapshot_sha256": "9284cf4c98afb975ec0453c12da4ef9822601143bdb9024d78cec5122b650579"}]}, "handoff_summary": ""}

