data: {"id": "c930f9afa05f46eb-node_complete-parallel_evidence", "run_id": "c930f9afa05f46eb", "seq": 1345, "ts_ms": 1788811343689, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 256.929, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-7b77l"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/c930f9afa05f46eb-g1/lane_artifacts/g1/artifact.json", "sha256": "3ccaf176ea0456c79dfc37d55d7f771dfe1997d132a828087d0771870ef3a995", "bytes": 2451}, "snapshot_sha256": "dd81b29cb263cc147b7dbdf3556a60eccf58a41d14601ef058dd0c4d3f808214"}]}, "handoff_summary": ""}

