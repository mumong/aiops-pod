data: {"id": "32e6484ae7cc4bb4-node_complete-parallel_evidence", "run_id": "32e6484ae7cc4bb4", "seq": 1259, "ts_ms": 1788792893133, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 73.295, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-fkzvn"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/32e6484ae7cc4bb4-g1/lane_artifacts/g1/artifact.json", "sha256": "699b6030be1d18a6f2ac61884d4eda9a4e43521b39833f22acbd618944b29933", "bytes": 2450}, "snapshot_sha256": "e4c0aa9ea5048b970e84d637f44c75acd4bd96cf3067e9f41c5b4f6f0eb0ab02"}]}, "handoff_summary": ""}

