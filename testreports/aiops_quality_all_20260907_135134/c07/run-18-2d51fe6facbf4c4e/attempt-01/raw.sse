data: {"id": "2d51fe6facbf4c4e-node_complete-parallel_evidence", "run_id": "2d51fe6facbf4c4e", "seq": 1658, "ts_ms": 1788794041634, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 397.787, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 2, "expected_group_count": 2, "terminal_group_count": 2, "join_complete": true, "diagnosed_count": 2, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-fkzvn"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g1/lane_artifacts/g1/artifact.json", "sha256": "64be8896155d6390c1ba3b45b70364fa65465b6d4560c40994ccca500bb3b137", "bytes": 2450}, "snapshot_sha256": "0d198ba3510cfba50f72c2472ecd68c762e75b30f0c34f0793852e1a8e2f0e93"}, {"group_id": "g2", "presentation_index": 1, "entities": [{"kind": "Pod", "namespace": "monitor", "name": "prometheus-observability-prometheus-0"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/lane_artifacts/g2/artifact.json", "sha256": "d40857901cd19f55278f21b21005ae240e365d7f129628165fff58ca47aa15e3", "bytes": 2658}, "snapshot_sha256": "d017abbcea9cfbb9bac1f09782807552b91ea8f8ad8896a87f65f24dd7383809"}]}, "handoff_summary": ""}

