data: {"id": "2d51fe6facbf4c4e-thinking-parallel_evidence-1142", "run_id": "2d51fe6facbf4c4e", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "read_context_archive", "content": null, "status": "success", "result_preview": "read_context_archive 输出摘要: raw_chars=461 lines=10\n<context_archive>\narchive_path: /tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/010-evidence-kubectl_events.raw.txt\noffset: 0\nreturned_c", "duration_seconds": null, "iteration": 3, "ts_ms": 1788794018289, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g2", "dimension": "other"}, "tool_call_id": "call_687ac4c34bcb4dffa8e9f9aa", "tool_sequence": 12, "semantic_success": true, "result": "read_context_archive 输出摘要: raw_chars=461 lines=10\n<context_archive>\narchive_path: /tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/010-evidence-kubectl_events.raw.txt\noffset: 0\nreturned_chars: 256\ntotal_chars: 256\ncontent:\nkubectl_events 摘要:\n关键诊断行:\n7m26s (x146 over 19d)   Warning   Unhealthy   Pod/prometheus-observability-prometheus-0   Readiness probe failed: Get \"http://172.16.166.165:9090/-/ready\": context deadline exceeded (Client.Timeout exceeded while awaiting headers)\n</context_archive>", "raw_ref": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/015-evidence-read_context_archive.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/015-evidence-read_context_archive.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/015-evidence-read_context_archive.summary.txt"}

