data: {"id": "2d51fe6facbf4c4e-thinking-parallel_evidence-1112", "run_id": "2d51fe6facbf4c4e", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\n关键诊断行:\nPod prometheus-observability-prometheus-0 in monitor namespace is Running on node1 but shows history of OOMKilled (Exit Code 137) and persistent Readiness probe timeouts ov", "duration_seconds": null, "iteration": 2, "ts_ms": 1788793988203, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g2", "entity": {"kind": "Pod", "namespace": "monitor", "name": "prometheus-observability-prometheus-0"}, "dimension": "kubernetes"}, "tool_call_id": "call_c68d9011af8e445182db7067", "tool_sequence": 6, "semantic_success": true, "result": "kubectl_describe 摘要:\n关键诊断行:\nPod prometheus-observability-prometheus-0 in monitor namespace is Running on node1 but shows history of OOMKilled (Exit Code 137) and persistent Readiness probe timeouts over 19 days. Prometheus container restarted 2 times, last terminated due to OOMKilled.\nkey_facts: [\"Pod: prometheus-observability-prometheus-0 | Namespace: monitor | Node: node1/10.2.0.49\", \"Container: prometheus | Image: xnet.registry.io:8443/observability/prometheus/prometheus:v3.4.1\", \"Current State: Running (Started: Thu, 03 Sep 2026 01:14:21)\", \"Last State: Terminated, Reason: OOMKilled, Exit Code: 137 (Finished: Thu, 03 Sep 2026 01:14:19)\", \"Restart Count: 2\", \"Resource Limits: cpu=100m, memory=512Mi\", \"Warning Event: Readiness probe failed x146 over 19d - context deadline exceeded (Client.Timeout exceeded while awaiting headers)\", \"Error Log (OOMKilled): found duplicate series for the match group ... many-to-many matching not allowed\"]\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/009-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/009-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/2d51fe6facbf4c4e-g2/tools/009-evidence-kubectl_describe.summary.txt"}

