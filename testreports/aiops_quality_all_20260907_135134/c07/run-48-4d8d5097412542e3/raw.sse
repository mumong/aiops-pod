data: {"id": "4d8d5097412542e3-node_complete-parallel_evidence", "run_id": "4d8d5097412542e3", "seq": 937, "ts_ms": 1788797624124, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 64.448, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-fkzvn"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/4d8d5097412542e3-g1/lane_artifacts/g1/artifact.json", "sha256": "aea5577914e5eca66a977cfbf9feec2c13549394a4d192fbac25b67385d09b83", "bytes": 2450}, "snapshot_sha256": "b83100cfa85c257dde279279712b69d048129f24a58ebd0e149b5f19eec4345a"}]}, "handoff_summary": ""}

