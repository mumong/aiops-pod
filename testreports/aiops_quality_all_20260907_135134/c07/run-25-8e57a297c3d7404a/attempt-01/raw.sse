data: {"id": "8e57a297c3d7404a-node_complete-parallel_evidence", "run_id": "8e57a297c3d7404a", "seq": 1180, "ts_ms": 1788794717354, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 72.183, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-fkzvn"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8e57a297c3d7404a-g1/lane_artifacts/g1/artifact.json", "sha256": "753fbee2799bd92a4c7a06c0d4f3e1143d398ace83a5d0699d181a0e3d223afe", "bytes": 2450}, "snapshot_sha256": "5c5f7d0e612b59d2720ee290593c67f68abfd4012a2fe8c0871ae389a2da3d44"}]}, "handoff_summary": ""}

