data: {"id": "4afb303c63c64751-node_complete-parallel_evidence", "run_id": "4afb303c63c64751", "seq": 1892, "ts_ms": 1788793394052, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 40.332, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-fkzvn"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/4afb303c63c64751-g1/lane_artifacts/g1/artifact.json", "sha256": "0153dd61656fdf92ed6203dfba2b7a0c45c5514aa0741e4481ae71da8c71c492", "bytes": 2449}, "snapshot_sha256": "c150859d862887d621655959a639b43a7c9a0c83b77f37d88a63ab1d93ba3783"}]}, "handoff_summary": ""}

