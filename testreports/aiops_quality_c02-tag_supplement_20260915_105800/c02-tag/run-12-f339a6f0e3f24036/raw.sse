data: {"id": "f339a6f0e3f24036-node_complete-parallel_evidence", "run_id": "f339a6f0e3f24036", "seq": 1632, "ts_ms": 1789441959820, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 31.036, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v07", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/f339a6f0e3f24036-g1/lane_artifacts/g1/artifact.json", "sha256": "9254ef6094a5951903335e9dbe7551bc505f2a50ecc0c3cdfa8189e6f4c63278", "bytes": 2569}, "snapshot_sha256": "1e6a45f81a1f1e52487c351cd8e315be70c48d536a857927fd1c8e8af0c902ca"}]}, "handoff_summary": ""}

