data: {"id": "1ec3cea6b2104579-node_complete-parallel_evidence", "run_id": "1ec3cea6b2104579", "seq": 1211, "ts_ms": 1789443767190, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 34.736, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v07", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/1ec3cea6b2104579-g1/lane_artifacts/g1/artifact.json", "sha256": "cf4c78a7b891e518cace98fb58f21c2a3a6fb81f9c1944db0a400c4cc6dd81b9", "bytes": 2420}, "snapshot_sha256": "a58ec0281546f7f0f69ee3c9e929296db211afecc6718fb3550a981df6cf99aa"}]}, "handoff_summary": ""}

