data: {"id": "7ce43a165d2a4c5b-node_complete-parallel_evidence", "run_id": "7ce43a165d2a4c5b", "seq": 858, "ts_ms": 1789148185916, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 41.838, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/7ce43a165d2a4c5b-g1/lane_artifacts/g1/artifact.json", "sha256": "5dd0dedf3d6796dbaefcbfda1d03197ff9ee0dcca6b837178a6c1675f52efcda", "bytes": 2569}, "snapshot_sha256": "cfd8b9ac44a8ee82391bec7ca2262581117316c5e64ac804297a286c4f40b85b"}]}, "handoff_summary": ""}

