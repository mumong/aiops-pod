data: {"id": "4b208167ddd74fcf-node_complete-parallel_evidence", "run_id": "4b208167ddd74fcf", "seq": 850, "ts_ms": 1789148417542, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 38.851, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/4b208167ddd74fcf-g1/lane_artifacts/g1/artifact.json", "sha256": "51698715839e7c3418b30574fa0a5694972bb0a814d28fe95fb88b5eb35973bf", "bytes": 2420}, "snapshot_sha256": "8d0c2d9f2ebc949fba88df640cfb3ab247ae57b308261b3b13f81432a2c05177"}]}, "handoff_summary": ""}

