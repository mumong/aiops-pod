data: {"id": "08f19a34734f4c58-node_complete-parallel_evidence", "run_id": "08f19a34734f4c58", "seq": 1192, "ts_ms": 1789360698728, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 556.765, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/08f19a34734f4c58-g1/lane_artifacts/g1/artifact.json", "sha256": "460b894d67476da8612959a29a822ed4e71bd2684d683529bf8dde64838a9e7a", "bytes": 2569}, "snapshot_sha256": "7c78dfb980d91a315aa8eebb84eedd551a614984ebe1a830ad0fd4680bd242dc"}]}, "handoff_summary": ""}

