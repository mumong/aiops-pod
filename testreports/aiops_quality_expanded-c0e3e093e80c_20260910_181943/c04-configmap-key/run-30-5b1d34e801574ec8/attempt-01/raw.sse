\n📋 Runbook 参考\n\n- **g1 aiops-case-v11/workload**: pod-config-error\n", "answer_source": "workflow", "elapsed_seconds": 51.397, "metrics": {"run_id": "5b1d34e801574ec8", "mttr": {"value": "51.4s", "seconds": 51.40165328979492, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "42%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-config-error", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-config-error"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 51401.65328979492, "llm_calls": 14, "llm_duration_ms": 46145.69449424744, "tool_calls": 13, "executed_tool_calls": 12, "deduplicated_tool_calls": 0, "successful_tool_calls": 8, "failed_tool_calls": 5, "tool_duration_ms": 12788.512468338013, "tool_wall_duration_ms": 4934.441089630127}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 18331.225872