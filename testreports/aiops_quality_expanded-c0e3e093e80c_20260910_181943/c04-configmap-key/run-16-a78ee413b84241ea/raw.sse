data: {"id": "a78ee413b84241ea-node_complete-parallel_evidence", "run_id": "a78ee413b84241ea", "seq": 1050, "ts_ms": 1789147409549, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 37.174, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/a78ee413b84241ea-g1/lane_artifacts/g1/artifact.json", "sha256": "152ad7fe0be9ce324052fc641fbf3c2511772896bca21feb11d53fab3651aa38", "bytes": 2420}, "snapshot_sha256": "c90db969c7d16e7f97c622f2617796b4b848aa1afbe0b1ecc13d8a6259b5c678"}]}, "handoff_summary": ""}

