data: {"id": "71f9258d0a604652-node_complete-parallel_evidence", "run_id": "71f9258d0a604652", "seq": 1649, "ts_ms": 1789135216973, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 35.621, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v08", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/71f9258d0a604652-g1/lane_artifacts/g1/artifact.json", "sha256": "83f5fd2aaff46660e38aa260a02e3420e574e9967597dbab1ca22792b2fc0521", "bytes": 2420}, "snapshot_sha256": "767c5958b80729fb55f6626aeb6aa754fb2faebd6a4f122817f46b4ae8e18104"}]}, "handoff_summary": ""}

