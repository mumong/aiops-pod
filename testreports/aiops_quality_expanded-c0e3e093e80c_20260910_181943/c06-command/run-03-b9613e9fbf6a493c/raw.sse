illed\n", "answer_source": "workflow", "elapsed_seconds": 73.777, "metrics": {"run_id": "b9613e9fbf6a493c", "mttr": {"value": "1.2m", "seconds": 73.78472304344177, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "45%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-oomkilled, pod-crashloop-runtime", "pass": true, "score": 0.85, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.3, "weighted_score": 0.09}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.3, "weighted_score": 0.06}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.8, "weighted_score": 0.12, "description": "Runbook 匹配质量", "detail": "已匹配（未识别核心）"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.8, "weighted_score": 0.16, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 80%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 73784.72304344177, "llm_calls": 10, "llm_duration_ms": 69773.72741699219, "tool_calls": 12, "executed_tool_calls": 12, "deduplicated_tool_calls": 0, "successful_tool_calls": 11, "failed_tool_calls": 1, "tool_duration_ms": 8588.048219680786, "tool_wall_duration_ms": 3726.2232303619385}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 22261.382579803467, "success": true}, "parallel_evidence": {"