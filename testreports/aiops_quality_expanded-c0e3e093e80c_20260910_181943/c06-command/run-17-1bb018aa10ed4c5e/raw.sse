data: {"id": "1bb018aa10ed4c5e-node_complete-parallel_evidence", "run_id": "1bb018aa10ed4c5e", "seq": 1100, "ts_ms": 1789133039547, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 46.144, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v08", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/1bb018aa10ed4c5e-g1/lane_artifacts/g1/artifact.json", "sha256": "89c39cc6c8686a311b9aa9ccd352421d93b954d741cde110dadcce17be14e6eb", "bytes": 2420}, "snapshot_sha256": "f2d61d75903e6ee23a0d7958f15ada16466cdd93fea3bb714944ebae5ac4f0b1"}]}, "handoff_summary": ""}

