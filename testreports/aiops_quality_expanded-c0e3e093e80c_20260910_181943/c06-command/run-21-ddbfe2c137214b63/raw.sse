data: {"id": "ddbfe2c137214b63-node_complete-parallel_evidence", "run_id": "ddbfe2c137214b63", "seq": 1668, "ts_ms": 1789133318489, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 36.886, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v08", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/ddbfe2c137214b63-g1/lane_artifacts/g1/artifact.json", "sha256": "8921bf1a32edddac907cfc05967b7a4e7a267042d4eef5b247f404fd55ecb3c7", "bytes": 2420}, "snapshot_sha256": "73889827b0ac98179e7b2046f5644ef96c5f2fc2a0dfba1753dbf57ca1254530"}]}, "handoff_summary": ""}

