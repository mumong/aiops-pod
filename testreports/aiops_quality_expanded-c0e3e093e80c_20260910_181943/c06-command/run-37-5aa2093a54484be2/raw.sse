data: {"id": "5aa2093a54484be2-node_complete-parallel_evidence", "run_id": "5aa2093a54484be2", "seq": 856, "ts_ms": 1789134427023, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 35.537, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v08", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5aa2093a54484be2-g1/lane_artifacts/g1/artifact.json", "sha256": "257f038bbcf0eec4dad16ec7008b588a6703d1ca7dc1021e8e3a066f8bc29d41", "bytes": 2420}, "snapshot_sha256": "4bb286e04c0f491a2a6bdda1d23a15cf465d5b20633db2ed26ae6a4caeb6275f"}]}, "handoff_summary": ""}

