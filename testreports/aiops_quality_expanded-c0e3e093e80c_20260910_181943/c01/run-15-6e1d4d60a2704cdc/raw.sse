data: {"id": "6e1d4d60a2704cdc-node_complete-parallel_evidence", "run_id": "6e1d4d60a2704cdc", "seq": 991, "ts_ms": 1789037112505, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 32.969, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-gtzc8"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/6e1d4d60a2704cdc-g1/lane_artifacts/g1/artifact.json", "sha256": "72562700c0daec23b23aeea0a332f3f3678773a396f4dc0decac07637710adc5", "bytes": 2451}, "snapshot_sha256": "b90fbae7c894efd58c089a7e65a5b0bed41f7ce776286136f1242afb61f2b456"}]}, "handoff_summary": ""}

