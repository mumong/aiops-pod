data: {"id": "772b8aff28de41e8-node_complete-parallel_evidence", "run_id": "772b8aff28de41e8", "seq": 3027, "ts_ms": 1789038239412, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 419.318, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 2, "expected_group_count": 2, "terminal_group_count": 2, "join_complete": true, "diagnosed_count": 2, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-gtzc8"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/772b8aff28de41e8-g1/lane_artifacts/g1/artifact.json", "sha256": "16dd7d4564fd7c3cbf20d41c5074914b962802f0ff3738f24f3d884e6417f5df", "bytes": 2451}, "snapshot_sha256": "2bc380f18c7ffca77d059b9588b0240c34fffb3e9a9ef66367bf9109828a5e76"}, {"group_id": "g2", "presentation_index": 1, "entities": [{"kind": "Pod", "namespace": "monitor", "name": "prometheus-observability-prometheus-0"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/772b8aff28de41e8-g2/lane_artifacts/g2/artifact.json", "sha256": "1274e4756bf2a8bf0438144ea429aa09fcb887bb3b87823f2df4bb6c7e83516c", "bytes": 2658}, "snapshot_sha256": "aabc86a2dfdc221058ff8e740687ae07dbbf9bbe47f9dd08fd41abc3910f9f57"}]}, "handoff_summary": ""}

