data: {"id": "772b8aff28de41e8-thinking-parallel_evidence-450", "run_id": "772b8aff28de41e8", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_logs", "content": null, "status": "success", "result_preview": "Prometheus rule evaluation logs show repeated WARN level errors indicating duplicate series for multiple match groups, preventing rule execution for Kubernetes resource and Kubelet metrics.\nkey_facts:", "duration_seconds": null, "iteration": 1, "ts_ms": 1789037854110, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g2", "entity": {"kind": "Pod", "namespace": "monitor", "name": "prometheus-observability-prometheus-0"}, "dimension": "kubernetes"}, "tool_call_id": "call_d9b17c6bb0ba4291be077924", "tool_sequence": 4, "semantic_success": true, "result": "Prometheus rule evaluation logs show repeated WARN level errors indicating duplicate series for multiple match groups, preventing rule execution for Kubernetes resource and Kubelet metrics.\nkey_facts: [\"Error Pattern: 'found duplicate series for the match group ... on the right hand-side of the operation ... many-to-many matching not allowed: matching labels must be unique on one side'\", \"Affected Group kubernetes-resources: Rule 'CPUThrottlingHigh' (index=7) failed repeatedly.\", \"Affected Instance (kubernetes-resources): {instance=\\\"10.2.0.48:10250\\\", namespace=\\\"admin\\\", pod=\\\"gpu-operator-849b44c54c-52sbm\\\"}\", \"Duplicate Service Labels (kubernetes-resources): 'obsstable-observability-kubelet' vs 'obs-sizecheck-observabilit-kubelet'\", \"Affected Group kubelet.rules: Rules 'node_quantile:kubelet_pleg_relist_duration_seconds:histogram_quantile' (indices 0, 1, 2) and 'KubeletPodStartUpLatencyHigh' (index=7) failed.\", \"Affected Instance (kubelet.rules): {instance=\\\"10.2.0.48:10250\\\"}\", \"Duplicate Service Labels (kubelet.rules): 'observability-kubelet' vs 'obsstable-observability-kubelet'\", \"Timestamps: Errors observed between 2026-09-10T10:51:44 and 10:52:27\"]", "raw_ref": "/tmp/aiops/reports/context_archives/772b8aff28de41e8-g2/tools/004-evidence-kubectl_logs.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/772b8aff28de41e8-g2/tools/004-evidence-kubectl_logs.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/772b8aff28de41e8-g2/tools/004-evidence-kubectl_logs.summary.txt"}

