od-pending-unschedulable\n", "answer_source": "workflow", "elapsed_seconds": 57.603, "metrics": {"run_id": "2f42174d1cd4484b", "mttr": {"value": "57.6s", "seconds": 57.609426736831665, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "42%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-pending-unschedulable", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-pending-unschedulable"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 57609.426736831665, "llm_calls": 11, "llm_duration_ms": 54835.40153503418, "tool_calls": 10, "executed_tool_calls": 10, "deduplicated_tool_calls": 0, "successful_tool_calls": 10, "failed_tool_calls": 0, "tool_duration_ms": 6330.586910247803, "tool_wall_duration_ms": 2475.231170654297}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 17233.69026184082, "success": true},