data: {"id": "bcdc67de217c4645-node_complete-parallel_evidence", "run_id": "bcdc67de217c4645", "seq": 1572, "ts_ms": 1789096846332, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 546.289, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-bsn84"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/bcdc67de217c4645-g1/lane_artifacts/g1/artifact.json", "sha256": "70b46b91add904ac9bcb576be2a4b27e3d55b2b541fa31e072708792c4ff416f", "bytes": 2452}, "snapshot_sha256": "9344d3d4d16e4ed654aba204f76093c677ef026da6d8d7077c24aeecbbef8879"}]}, "handoff_summary": ""}

