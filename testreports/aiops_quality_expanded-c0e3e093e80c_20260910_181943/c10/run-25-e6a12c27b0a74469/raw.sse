data: {"id": "e6a12c27b0a74469-node_complete-parallel_evidence", "run_id": "e6a12c27b0a74469", "seq": 1699, "ts_ms": 1789354084552, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 74.698, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-48j8r"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e6a12c27b0a74469-g1/lane_artifacts/g1/artifact.json", "sha256": "5ad12bfc06a0b026d534bd1fd74d0c849610e2757e798d7c4ac13fb9fe865466", "bytes": 2452}, "snapshot_sha256": "137cd915718b9fa54dcfc38e76162e9c7f4c8a1c1afa1c09861e68607dfc71ac"}]}, "handoff_summary": ""}

