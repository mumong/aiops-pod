"id\":\"fact-49f0905984a2\",\"pattern_count\":20,\"pattern_exemplar\":\"head\",\"source_system\":\"deepflow\",\"trace_type\":\"flow\"},{\"confidence\":\"low\",\"data\":{\"attributes\":{\"aiops.observed_mode\":\"liveness_fail\",\"http.request.method\":\"GET\",\"http.response.status_code\":200,\"http.route\":\"/work\"},\"end\":\"2026-09-14T02:28:29.240198Z\",\"name\":\"GET /work\",\"service\":\"aiops-lab-workload\",\"span_id\":\"fe1be0c3f00361f0\",\"start\":\"2026-09-14T02:28:29.240195Z\",\"timestamp\":{\"utc\":\"2026-09-14T02:28:29.240195Z\"},\"trace_id\":\"f62cf6a899f219c2a5169d492da4ee0b\"},\"directness\":\"related_context\",\"id\":\"fact-dee2a9ec7642\",\"pattern_count\":3,\"pattern_exemplar\":\"head\",\"source_system\":\"tempo\",\"trace_type\":\"span\"},{\"confidence\":\"high\",\"data\":{\"dst_ip\":\"172.16.104.34\",\"duration_us\":\"11827\",\"protocol\":\"HTTP\",\"request_resource\":\"/work\",\"request_type\":\"GET\",\"response_code\":200,\"response_status\":0,\"span_id\":\"dbdf66c74db80f14\",\"src_ip\":\"172.16.104.33\",\"timestamp\":{\"utc\":\"2026-09-14T02:28:11Z\"},\"trace_id\":\"fcbfac7c52116a7329b4d75153b82c5d\"},\"directness\":\"direct\",\"id\":\"fact-f0cb863ff302\",\"pattern_count\":20,\"pattern_exemplar\":\"middle\",\"source_system\":\"deepflow\",\"trace_type\":\"flow\"}],\"retrieval\":{\"mcp_response_complete\":true,\"raw_ref\":\"/tmp/aiops/reports/context_archives/54b02371fa18403d-g1/tools/003-evidence-query_pod_tracing.raw.txt\",\"tool\":\"read_context_archive\"},\"source_coverage\":{\"deepflow\":{\"coverage\":\"present\",\"directness\":\"direct\"},\"tempo\":{\"coverage\":\"present\",\"executed\":true,\"failed_trace_count\":0,\"queried_trace_count\":5,\"successful_lookup_count\":5}},\"source_system\":\"deepflow+tempo\",\"status\":\"query_succeeded\",\"summary_selection\":{\"omitted\":20,\"selected\":3,\"strategy\":\"information_ranked_pattern_round_robin_budget_scan_no_fault_names\"},\"tool\":\"query_pod_tracing\",\"truncation\":{\"mcp_response_truncated\":false,\"reason_detail_complete\":true,\"reasons\":[\"sql_limit_reached_possible_more_rows\",\"source_or_collection_limit\"],\"source_or_collection_truncated\":true,\"truncated\":true},\"window\":{\"end\":\"2026-09-14T02:35:58.029336Z\",\"start\":\"2026-09-14T02:05:58.029336Z\"}}", "raw_ref": "/tmp/aiops/reports/context_archives/54b02371fa18403d-g1/tools/003-evidence-query_pod_tracing.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/54b02371fa18403d-g1/tools/003-evidence-query_pod_tracing.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/54b02371fa18403d-g1/tools/003-evidence-query_pod_tracing.summary.txt"}

