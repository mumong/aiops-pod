data: {"id": "54b02371fa18403d-node_complete-parallel_evidence", "run_id": "54b02371fa18403d", "seq": 2051, "ts_ms": 1789353443762, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 100.071, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-48j8r"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/54b02371fa18403d-g1/lane_artifacts/g1/artifact.json", "sha256": "df741fb94f1760d1fababbe5d4d649aeb403da980a3d5965016ad6b86719d069", "bytes": 2452}, "snapshot_sha256": "8cc3c573ab028c99b74b44cd507b78e8f779afc8c15ccb755e482c073af8c54e"}]}, "handoff_summary": ""}

