data: {"id": "ce4829f0b465421e-node_complete-parallel_evidence", "run_id": "ce4829f0b465421e", "seq": 1048, "ts_ms": 1789097701742, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 53.507, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-bsn84"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/ce4829f0b465421e-g1/lane_artifacts/g1/artifact.json", "sha256": "2bf2be04001b058d6773d7bbcab67f15aa014f854468cf9b3dd607a8efe82077", "bytes": 2451}, "snapshot_sha256": "bec0b6534d315be142019a6f7833d9e0161f4904da06ba753079748d1e8d7fe0"}]}, "handoff_summary": ""}

