data: {"id": "d78d9c8d98874307-node_complete-parallel_evidence", "run_id": "d78d9c8d98874307", "seq": 2711, "ts_ms": 1789095824172, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 175.058, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-bsn84"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d78d9c8d98874307-g1/lane_artifacts/g1/artifact.json", "sha256": "f559e7a6226f3eec3db69aae56813ff4901759ed92db490a80e06d1aaca3e4db", "bytes": 2452}, "snapshot_sha256": "43b368e4106ca44948a362174783a72dd863e236e2a576b96686b976a8ed639e"}]}, "handoff_summary": ""}

