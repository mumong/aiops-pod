data: {"id": "7a95bb906d9a452f-node_complete-parallel_evidence", "run_id": "7a95bb906d9a452f", "seq": 1677, "ts_ms": 1789104281204, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.404, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/7a95bb906d9a452f-g1/lane_artifacts/g1/artifact.json", "sha256": "3cfe5b61f1a09a639aa69d20dcf04191c91f3425091afc56f2f79244793915e8", "bytes": 2418}, "snapshot_sha256": "8bdd6bd61b88d6a186425ffe2aefb57909c95943184ed68d43011129bfc3d3ab"}]}, "handoff_summary": ""}

