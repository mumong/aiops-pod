data: {"id": "414bfe4d3c344a6f-node_complete-parallel_evidence", "run_id": "414bfe4d3c344a6f", "seq": 925, "ts_ms": 1789100954591, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 36.083, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/414bfe4d3c344a6f-g1/lane_artifacts/g1/artifact.json", "sha256": "f7ff06efc0f604140e3fac326292c4db61d72fc06ce3816703ee6e183d21d4ee", "bytes": 2418}, "snapshot_sha256": "399da608a7a1809e46c0b58ee0c5c544666adeec9371616309f82f07b1cfb429"}]}, "handoff_summary": ""}

