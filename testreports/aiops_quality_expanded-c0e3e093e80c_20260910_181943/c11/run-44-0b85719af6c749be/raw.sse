data: {"id": "0b85719af6c749be-node_complete-parallel_evidence", "run_id": "0b85719af6c749be", "seq": 1803, "ts_ms": 1789103409640, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 83.779, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0b85719af6c749be-g1/lane_artifacts/g1/artifact.json", "sha256": "e093c2fadd4a0cb51f97e0947207c757657caf2ba40d08d23e2195a36a0c9b5e", "bytes": 2418}, "snapshot_sha256": "ca80f788f9bf50fc87e837bc0c9f39542c5e079ba4beddd9e9dffec685a35c4a"}]}, "handoff_summary": ""}

