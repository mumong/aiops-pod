data: {"id": "62b67368efcf44e4-thinking-parallel_evidence-620", "run_id": "62b67368efcf44e4", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in aiops-case-05 is stuck in Pending state. Events show repeated failures to create pod sandbox because the network-attachment-definition 'unavailable-network' referenced", "duration_seconds": null, "iteration": 1, "ts_ms": 1789063335608, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_3689640969a743bea7bf3c99", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in aiops-case-05 is stuck in Pending state. Events show repeated failures to create pod sandbox because the network-attachment-definition 'unavailable-network' referenced in pod annotations is missing in the namespace.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh, Namespace: aiops-case-05, Node: node2/10.2.0.50\", \"Status: Pending, Container State: Waiting (Reason: ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Event Reason: NoNetworkFound (multus) - missing network-attachment-definition 'unavailable-network' in namespace aiops-case-05\", \"Annotations include k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Events span from 51m to 59m ago (repeated warnings)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/62b67368efcf44e4-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/62b67368efcf44e4-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/62b67368efcf44e4-g1/tools/004-evidence-kubectl_describe.summary.txt"}

