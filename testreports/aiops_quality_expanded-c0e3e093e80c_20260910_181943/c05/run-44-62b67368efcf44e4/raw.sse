data: {"id": "62b67368efcf44e4-thinking-parallel_evidence-622", "run_id": "62b67368efcf44e4", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 repeatedly fails to start due to missing CNI network attachment definition.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-cas", "duration_seconds": null, "iteration": 1, "ts_ms": 1789063340656, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_0abe2539bd8c4a91af7f6455", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 repeatedly fails to start due to missing CNI network attachment definition.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Error: Failed to create pod sandbox: rpc error: code = Unknown desc = failed to setup network for sandbox\", \"Root Cause: network-attachment-definition.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"Frequency: Warning NoNetworkFound events repeated over 94 minutes (e.g., 39m (x425))\"]\nmissing: [\"Node information not present in events\", \"Container/InitContainer status details not explicitly detailed beyond sandbox failure\", \"Image information not present in events\"]", "raw_ref": "/tmp/aiops/reports/context_archives/62b67368efcf44e4-g1/tools/006-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/62b67368efcf44e4-g1/tools/006-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/62b67368efcf44e4-g1/tools/006-evidence-kubectl_events.summary.txt"}

