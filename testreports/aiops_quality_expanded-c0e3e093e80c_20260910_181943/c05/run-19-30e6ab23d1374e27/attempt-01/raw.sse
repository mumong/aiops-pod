data: {"id": "30e6ab23d1374e27-thinking-parallel_evidence-93", "run_id": "30e6ab23d1374e27", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh (ns: aiops-case-05) is Pending and failing to create sandbox because the requested network-attachment-definition 'unavailable-network' does not exist in the namespace.\nke", "duration_seconds": null, "iteration": 1, "ts_ms": 1789060317259, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_ea12f2f3468d45428d172332", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh (ns: aiops-case-05) is Pending and failing to create sandbox because the requested network-attachment-definition 'unavailable-network' does not exist in the namespace.\nkey_facts: [\"Name: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine, State: Waiting/Reason: ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Event Warning: NoNetworkFound from multus: cannot find network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Event Warning: FailedCreatePodSandBox from kubelet: plugin type=multus name=multus-cni-network failed (add): rpc error: code = Unknown desc = failed to setup network... network-attachment-definition 'unavailable-network' not found\", \"Events repeated for approx 45m down to 42m ago\", \"IP: <none>, Pods: <none>\"]\nconflicts: [\"None\"]", "raw_ref": "/tmp/aiops/reports/context_archives/30e6ab23d1374e27-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/30e6ab23d1374e27-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/30e6ab23d1374e27-g1/tools/004-evidence-kubectl_describe.summary.txt"}

