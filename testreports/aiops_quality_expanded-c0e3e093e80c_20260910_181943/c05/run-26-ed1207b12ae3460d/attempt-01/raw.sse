se-05/workload-5dbb5dcd6c-bntfh**: pod-volume-mount-failed\n", "answer_source": "workflow", "elapsed_seconds": 378.614, "metrics": {"run_id": "ed1207b12ae3460d", "mttr": {"value": "6.3m", "seconds": 378.62505412101746, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-volume-mount-failed", "pass": true, "score": 0.9, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.5, "weighted_score": 0.1}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-volume-mount-failed"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 378625.05412101746, "llm_calls": 16, "llm_duration_ms": 68580.98864555359, "tool_calls": 18, "executed_tool_calls": 11, "deduplicated_tool_calls": 6, "successful_tool_calls": 16, "failed_tool_calls": 2, "tool_duration_ms": 341399.2578983307, "tool_wall_duration_ms": 309569.4410800934}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 22463.9