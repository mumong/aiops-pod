data: {"id": "ed1207b12ae3460d-thinking-parallel_evidence-232", "run_id": "ed1207b12ae3460d", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is failing to create sandbox due to missing network-attachment-definition 'unavailable-network', generating repeated Warning events over 64 min", "duration_seconds": null, "iteration": 1, "ts_ms": 1789061538766, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_561babd5267e4e1498b58dc0", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is failing to create sandbox due to missing network-attachment-definition 'unavailable-network', generating repeated Warning events over 64 minutes.\nkey_facts: [\"Object: Pod/workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Error: Failed to create pod sandbox: rpc error... failed to setup network for sandbox\", \"Root Cause: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"Frequency: Event repeated over 64 minutes (last seen 40s ago with x288 count; raw preview shows continuous warnings from 59m to 49m)\"]\nmissing: [\"Current Pod phase/status (e.g., ContainerCreating, Pending)\", \"Node name where pod is scheduled\", \"Specific Multus/CNI plugin logs beyond K8s event summary\"]", "raw_ref": "/tmp/aiops/reports/context_archives/ed1207b12ae3460d-g1/tools/004-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/ed1207b12ae3460d-g1/tools/004-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/ed1207b12ae3