data: {"id": "7042b67dfff64ecc-thinking-parallel_evidence-159", "run_id": "7042b67dfff64ecc", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is stuck in Pending status due to missing NetworkAttachmentDefinition. Multus CNI plugin fails to find the network definition 'unavailable-netw", "duration_seconds": null, "iteration": 1, "ts_ms": 1789061370205, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_380d54bc6fe9491a927a1fa3", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is stuck in Pending status due to missing NetworkAttachmentDefinition. Multus CNI plugin fails to find the network definition 'unavailable-network', causing continuous 'FailedCreatePodSandBox' errors.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh | Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending | Container State: Waiting (Reason: ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Event: Warning NoNetworkFound (multus) - cannot find network-attachment-definition 'unavailable-network' in namespace aiops-case-05\", \"Event: Warning FailedCreatePodSandBox (kubelet) - rpc error: failed to setup network for sandbox\"]\nconflicts: [\"current_summary mentions 'x266 over 61m' for FailedCreatePodSandBox; raw_preview shows NoNetworkFound events spanning 60m to 51m and FailedCreatePodSandBox starting 2m52s ago (implies shorter duration/frequency in current snapshot). Raw data prevails.\"]\nmissing: [\"No NetworkAtt