data: {"id": "9fee4a6a09a84bcb-node_complete-parallel_evidence", "run_id": "9fee4a6a09a84bcb", "seq": 4090, "ts_ms": 1789059679570, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 45.541, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/9fee4a6a09a84bcb-g1/lane_artifacts/g1/artifact.json", "sha256": "03e3ce93ba5fe00c55378b643f372e4f8b6893e8b80e4bb3ccc6c67f2effefc8", "bytes": 2634}, "snapshot_sha256": "5f5bbea261b08c719c07fab066ce8d1afa4d7b76c1e0ed4b7bd36554144d06e5"}]}, "handoff_summary": ""}

