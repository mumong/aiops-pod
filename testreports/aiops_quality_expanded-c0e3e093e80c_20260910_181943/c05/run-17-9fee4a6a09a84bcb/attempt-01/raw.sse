data: {"id": "9fee4a6a09a84bcb-thinking-parallel_evidence-2732", "run_id": "9fee4a6a09a84bcb", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is stuck in Pending/ContainerCreating state. Repeated failures due to missing Multus NetworkAttachmentDefinition 'unavailable-network'.\nkey_fac", "duration_seconds": null, "iteration": 1, "ts_ms": 1789059652131, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_776f51a038be49558fe7554d", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is stuck in Pending/ContainerCreating state. Repeated failures due to missing Multus NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Resource: Pod workload-5dbb5dcd6c-bntfh, Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine), State: Waiting (Reason: ContainerCreating)\", \"Annotations: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Event Warning NoNetworkFound (multus): cannot find network-attachment-definition (unavailable-network) in namespace aiops-case-05\", \"Event Warning FailedCreatePodSandBox (kubelet): Failed to create pod sandbox: failed to setup network for sandbox... plugin type=multus name=multus-cni-network failed... cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05): network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"Errors repeated for at least 3 minutes (34m to 31m ago)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/9f