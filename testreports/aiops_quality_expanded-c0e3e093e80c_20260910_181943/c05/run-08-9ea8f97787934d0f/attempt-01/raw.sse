data: {"id": "9ea8f97787934d0f-thinking-parallel_evidence-291", "run_id": "9ea8f97787934d0f", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 failed to create sandbox due to missing Multus network-attachment-definition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh", "duration_seconds": null, "iteration": 1, "ts_ms": 1789058574405, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_dbc30778f2904800a5c157bd", "tool_sequence": 2, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 failed to create sandbox due to missing Multus network-attachment-definition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Node: node2 (Assigned)\", \"Error: FailedCreatePodSandBox / NoNetworkFound\", \"Root Cause: Cannot find network-attachment-definition 'unavailable-network'\", \"CNI Plugin: multus-cni-network\", \"Error Message: 'unavailable-network' not found\", \"Recency: Errors repeated every ~1m from 16m ago to 12m ago\"]", "raw_ref": "/tmp/aiops/reports/context_archives/9ea8f97787934d0f-g1/tools/004-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/9ea8f97787934d0f-g1/tools/004-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/9ea8f97787934d0f-g1/tools/004-evidence-kubectl_events.summary.txt"}

