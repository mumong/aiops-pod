data: {"id": "585bf8f24fbd4ba2-thinking-parallel_evidence-1396", "run_id": "585bf8f24fbd4ba2", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod `workload-5dbb5dcd6c-bntfh` in namespace `aiops-case-05` is stuck in `Pending` state with container `app` waiting for `ContainerCreating`. Events indicate repeated failures to create pod sandbox d", "duration_seconds": null, "iteration": 1, "ts_ms": 1789057677053, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_1c344f3e0f4e49f8a6ea3211", "tool_sequence": 1, "semantic_success": true, "result": "Pod `workload-5dbb5dcd6c-bntfh` in namespace `aiops-case-05` is stuck in `Pending` state with container `app` waiting for `ContainerCreating`. Events indicate repeated failures to create pod sandbox due to missing CNI network attachment definition.\nkey_facts: [\"Pod Name: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending\", \"Container: app, Image: xnet.registry.io:8443/observability/python:3-alpine, State: Waiting (Reason: ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: Network-attachment-definitions.k8s.cni.cncf.io 'unavailable-network' not found in namespace aiops-case-05\", \"Events: Repeated 'Warning FailedCreatePodSandBox' from kubelet and 'Warning NoNetworkFound' from multus plugin between 83s ago and 13s ago\"]\nmissing: [\"kubectl get networkattachmentdefinition unavailable-network -n aiops-case-05 to confirm existence\", \"kubectl get net-attach-def -n aiops-case-05 to list available definitions\"]", "raw_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/005-evidence-kubectl_describe.summary.txt"}

