data: {"id": "585bf8f24fbd4ba2-thinking-parallel_evidence-1784", "run_id": "585bf8f24fbd4ba2", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubernetes_tabular_query", "content": null, "status": "success", "result_preview": "kubernetes_tabular_query 输出摘要: raw_chars=294 lines=3\nCommand failed (exit 1):\nkubectl get pods --all-namespaces -o custom-columns='metadata.name,status.phase,spec.nodeName,metadata.annotations' | (hea", "duration_seconds": null, "iteration": 4, "ts_ms": 1789057688805, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "kubernetes"}, "tool_call_id": "call_b9c4b5f7946845b79ab07284", "tool_sequence": 6, "semantic_success": false, "result": "kubernetes_tabular_query 输出摘要: raw_chars=294 lines=3\nCommand failed (exit 1):\nkubectl get pods --all-namespaces -o custom-columns='metadata.name,status.phase,spec.nodeName,metadata.annotations' | (head -n 1; tail -n +2 | grep -E 'workload-5dbb5dcd6c-bntfh')\nerror: unexpected custom-columns spec: metadata.name, expected <header>:<json-path-expr>", "raw_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/009-evidence-kubernetes_tabular_query.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/009-evidence-kubernetes_tabular_query.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/009-evidence-kubernetes_tabular_query.summary.txt"}

