data: {"id": "585bf8f24fbd4ba2-thinking-parallel_evidence-1785", "run_id": "585bf8f24fbd4ba2", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is failing to create sandbox due to missing NetworkAttachmentDefinition 'unavailable-network' referenced by Multus CNI. Scheduled to node2.\nkey", "duration_seconds": null, "iteration": 4, "ts_ms": 1789057693534, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_b31847b6136845cca0204266", "tool_sequence": 7, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is failing to create sandbox due to missing NetworkAttachmentDefinition 'unavailable-network' referenced by Multus CNI. Scheduled to node2.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Node: node2\", \"Warning: FailedCreatePodSandBox\", \"Reason: NoNetworkFound / FailedCreatePodSandBox\", \"Error: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Tool: multus-cni-network\", \"Frequency: Repeated errors from 102s to 5s ago\"]", "raw_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/010-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/010-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/585bf8f24fbd4ba2-g1/tools/010-evidence-kubectl_events.summary.txt"}

