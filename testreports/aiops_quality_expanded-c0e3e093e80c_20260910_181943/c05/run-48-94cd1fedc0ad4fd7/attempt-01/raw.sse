data: {"id": "94cd1fedc0ad4fd7-thinking-parallel_evidence-608", "run_id": "94cd1fedc0ad4fd7", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is repeatedly failing to create pod sandbox due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5d", "duration_seconds": null, "iteration": 1, "ts_ms": 1789064582869, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_0b9e134a1cbe45e8aebb90fc", "tool_sequence": 2, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is repeatedly failing to create pod sandbox due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Event Reason: NoNetworkFound, FailedCreatePodSandBox\", \"Error: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Frequency: Repeated warnings from 83s ago over ~114m (combined from similar events) and continuous NoNetworkFound events over last 60m\", \"Failed Network Attachment Definition: unavailable-network\"]", "raw_ref": "/tmp/aiops/reports/context_archives/94cd1fedc0ad4fd7-g1/tools/004-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/94cd1fedc0ad4fd7-g1/tools/004-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/94cd1fedc0ad4fd7-g1/tools/004-evidence-kubectl_events.summary.txt"}

