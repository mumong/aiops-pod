data: {"id": "aea25602f4f24d3e-thinking-parallel_evidence-917", "run_id": "aea25602f4f24d3e", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is failing to start due to repeated Multus CNI errors indicating a missing NetworkAttachmentDefinition.\nkey_facts: [\"Object: Pod/workload-5dbb5", "duration_seconds": null, "iteration": 3, "ts_ms": 1789057767473, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_9e494400f6534232a85a0b34", "tool_sequence": 4, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is failing to start due to repeated Multus CNI errors indicating a missing NetworkAttachmentDefinition.\nkey_facts: [\"Object: Pod/workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Assigned Node: node2\", \"Error Reason: FailedCreatePodSandBox / NoNetworkFound\", \"Error Message: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05): network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\", \"CNI Plugin: multus-cni-network\", \"Event Frequency: Repeated warnings observed from 2m56s ago to 6s ago (current window)\"]\nmissing: [\"Node details beyond name 'node2'\", \"Specific container image or restart counts\"]", "raw_ref": "/tmp/aiops/reports/context_archives/aea25602f4f24d3e-g1/tools/007-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/aea25602f4f24d3e-g1/tools/007-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/aea25602f4f24d3e-g1/tools/007-evidence-kubectl_event