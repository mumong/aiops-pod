data: {"id": "3a5e37de8e4747df-thinking-parallel_evidence-584", "run_id": "3a5e37de8e4747df", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 remains in Pending/ContainerCreating status due to network attachment failures. The pod references network-attachment-definition 'unavailable-n", "duration_seconds": null, "iteration": 1, "ts_ms": 1789059130278, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_5c73b79914074414a0e36070", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 remains in Pending/ContainerCreating status due to network attachment failures. The pod references network-attachment-definition 'unavailable-network', which is missing in the namespace, causing persistent 'NoNetworkFound' and 'FailedCreatePodSandBox' errors.\nkey_facts: [\"name: workload-5dbb5dcd6c-bntfh\", \"namespace: aiops-case-05\", \"node: node2/10.2.0.50\", \"status: Pending\", \"container: app, image: xnet.registry.io:8443/observability/python:3-alpine, state: Waiting/Reason: ContainerCreating\", \"annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: 'unavailable-network' network-attachment-definition not found in namespace aiops-case-05\", \"Event: NoNetworkFound from multus (repeated 25m/24m/23m/22m)\", \"Event: FailedCreatePodSandBox from kubelet (failed to setup network)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/3a5e37de8e4747df-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/3a5e37de8e4747df-g1/tools/004-evidence-kubectl_describe.s