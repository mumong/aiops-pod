data: {"id": "bf802d11c6e3446e-thinking-parallel_evidence-2047", "run_id": "bf802d11c6e3446e", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is stuck in Pending state due to missing network-attachment-definition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Na", "duration_seconds": null, "iteration": 4, "ts_ms": 1789061288498, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-bntfh"}, "dimension": "kubernetes"}, "tool_call_id": "call_fa8bf2d447304e8685a9c2d7", "tool_sequence": 8, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-bntfh in namespace aiops-case-05 is stuck in Pending state due to missing network-attachment-definition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-bntfh\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Status: Pending, Reason: ContainerCreating\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: Failed to create pod sandbox: rpc error: code = Unknown desc = failed to setup network\", \"Root Cause: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Event Frequency: NoNetworkFound warnings repeated frequently over 60m\"]", "raw_ref": "/tmp/aiops/reports/context_archives/bf802d11c6e3446e-g1/tools/015-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/bf802d11c6e3446e-g1/tools/015-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/bf802d11c6e3446e-g1/tools/015-evidence-kubectl_describe.summar