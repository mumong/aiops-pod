data: {"id": "2c75d3ed2f4a4c02-node_complete-parallel_evidence", "run_id": "2c75d3ed2f4a4c02", "seq": 1498, "ts_ms": 1789391127325, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 37.155, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v16", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2c75d3ed2f4a4c02-g1/lane_artifacts/g1/artifact.json", "sha256": "796af9000da8829b932e681ff2aeb27852bd7b90a980a5998ecef4bfa4f71887", "bytes": 2420}, "snapshot_sha256": "4ba0aef5eedb86c2d9c1be9bdf31b58b0aec116a97a270432d754ccb3635f47a"}]}, "handoff_summary": ""}

