data: {"id": "0527b3274e6443e3-node_complete-parallel_evidence", "run_id": "0527b3274e6443e3", "seq": 1608, "ts_ms": 1789387852754, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 41.714, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v16", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0527b3274e6443e3-g1/lane_artifacts/g1/artifact.json", "sha256": "2bbb0cde2dfabef3ece4a1ddd4b1f6969c89871264d19db84819d417887f651b", "bytes": 2569}, "snapshot_sha256": "35a4b039ec70a1b4fff4c0cca75f9d93b435996494b0b854600a0a155bf08330"}]}, "handoff_summary": ""}

