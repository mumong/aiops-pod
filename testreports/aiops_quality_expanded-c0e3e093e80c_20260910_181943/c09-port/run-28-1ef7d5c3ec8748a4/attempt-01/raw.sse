data: {"id": "1ef7d5c3ec8748a4-node_complete-parallel_evidence", "run_id": "1ef7d5c3ec8748a4", "seq": 1624, "ts_ms": 1789389574283, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 46.336, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v16", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/1ef7d5c3ec8748a4-g1/lane_artifacts/g1/artifact.json", "sha256": "43a6fccdc11659badc0860bb39c53c30eb54968425237b60e3ef8f53dfe68625", "bytes": 2420}, "snapshot_sha256": "da4b23ab3f0c6103d556c9eb96771e0e03278f235b1192a9926ba258fe69c0dc"}]}, "handoff_summary": ""}

