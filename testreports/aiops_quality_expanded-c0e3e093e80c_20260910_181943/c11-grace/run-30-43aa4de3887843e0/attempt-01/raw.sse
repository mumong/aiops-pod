ence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "42%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-terminating-stuck", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-terminating-stuck"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 73417.12021827698, "llm_calls": 15, "llm_duration_ms": 61739.41922187805, "tool_calls": 17, "executed_tool_calls": 14, "deduplicated_tool_calls": 2, "successful_tool_calls": 16, "failed_tool_calls": 1, "tool_duration_ms": 18572.888374328613, "tool_wall_duration_ms": 11317.809104919434}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 24716.75968170166, "success": true}, "parallel_evidence": {"name": "并发证据采集", "duration_ms": 41479.70199584961, "success": true}, "evidence": {"name": "evidence", "duration_ms": 0.0, "success": true}, "rca": {"name": "rca", "duration_ms": 0.0, "success": true}, "conclusion