d:\n      python3\n      -u\n      -c\n      from pathlib import Path\n      import signal, time\n    State:          Running\n      Started:      Mon, 14 Sep 2026 07:19:33 +0000\n    Ready:          True\n    Restart Count:  0\n    Limits:\n      cpu:     50m\n      memory:  32Mi\n    Requests:\n      cpu:        5m\n      memory:     8Mi\n    Readiness:    exec [python3 -c import os; assert os.path.exists('/proc/1/status')] delay=3s timeout=1s period=2s #success=1 #failure=3\n    Environment:  <none>\n    Mounts:\nVolumes:\n  state:\n    Type:        EmptyDir (a temporary directory that shares a pod's lifetime)\nEvents:\n  Normal  Killing         39s   kubelet            Stopping container app\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/8b394cb01de540b7-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/8b394cb01de540b7-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/8b394cb01de540b7-g1/tools/004-evidence-kubectl_describe.summary.txt"}

