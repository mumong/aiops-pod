data: {"id": "d2673bc54f1c4543-node_complete-parallel_evidence", "run_id": "d2673bc54f1c4543", "seq": 976, "ts_ms": 1789368300020, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 54.483, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v13", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d2673bc54f1c4543-g1/lane_artifacts/g1/artifact.json", "sha256": "0904fe97e44c0e8df2d486ce6bad6b86e81a4d6f4d324493af0095c7e90e5f47", "bytes": 2420}, "snapshot_sha256": "f43dffcb2c84e8c239bc02539abe3e1d9aa144c4d9bebcd34e24c7c2220c67fa"}]}, "handoff_summary": ""}

