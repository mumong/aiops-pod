ime('2026-09-14 07:23:48', 'UTC') AND flow.time <= toDateTime('2026-09-14 07:53:48', 'UTC') AND (ip4_0 = '172.16.104.20' OR ip4_1 = '172.16.104.20') ORDER BY (trace_id != '') DESC, response_duration DESC, flow.time DESC LIMIT 20 FORMAT JSON\",\"filtered_match_count\":0,\"time_range\":{\"start\":\"2026-09-14T07:23:48.126396Z\",\"end\":\"2026-09-14T07:53:48.126396Z\"},\"pod_ip\":\"172.16.104.20\",\"direction\":\"any\",\"tempo_trace_ids\":[],\"invalid_tempo_trace_id_count\":0,\"tempo\":{}},\"facts\":[],\"samples\":[],\"flows\":[],\"spans\":[],\"correlations\":[],\"telemetry\":{\"deepflow\":{\"coverage\":\"empty\",\"directness\":\"direct\"},\"tempo\":{\"coverage\":\"absent\",\"executed\":false,\"query_meta\":{},\"reason\":\"no_valid_trace_ids\"}},\"limitations\":[],\"evidence_refs\":[],\"counts\":{\"matched\":null,\"retrieved\":0,\"normalized\":0,\"returned\":0,\"dropped\":0,\"flow_count\":0,\"span_count\":0},\"truncation\":{\"truncated\":false,\"stages\":[]},\"truncated\":false,\"limits\":{\"max_records\":50,\"requested_max_records\":20,\"max_traces\":5,\"response_serialization\":\"lossless\"},\"serialization\":{\"policy\":\"lossless\",\"response_truncated\":false,\"serialized_bytes\":2023}}\n</context_archive>", "raw_ref": "/tmp/aiops/reports/context_archives/8675758576f9475a-g1/tools/021-evidence-read_context_archive.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/8675758576f9475a-g1/tools/021-evidence-read_context_archive.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/8675758576f9475a-g1/tools/021-evidence-read_context_archive.summary.txt"}

