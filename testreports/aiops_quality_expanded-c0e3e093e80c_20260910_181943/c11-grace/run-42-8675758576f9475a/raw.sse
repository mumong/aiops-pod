data: {"id": "8675758576f9475a-thinking-parallel_evidence-719", "run_id": "8675758576f9475a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v13\nnode: node2/10.2.0.50\nstatus: Terminating (lasts <invalid>)\n关键诊断行:\n  Warning  Unhealthy       112s   kubelet            Readiness probe fa", "duration_seconds": null, "iteration": 5, "ts_ms": 1789372501447, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v13", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_4f5dc5aca5494ab68ae94422", "tool_sequence": 20, "semantic_success": true, "result": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v13\nnode: node2/10.2.0.50\nstatus: Terminating (lasts <invalid>)\n关键诊断行:\n  Warning  Unhealthy       112s   kubelet            Readiness probe failed: command \"python3 -c import os; assert os.path.exists('/proc/1/status')\" timed out\nAnnotations:               cni.projectcalico.org/containerID: 62e6d3e138823926bd14aa43b250e850985c9deb103d6625b3bc2b776d703893\n                           cni.projectcalico.org/podIP: 172.16.104.20/32\n                           cni.projectcalico.org/podIPs: 172.16.104.20/32\n                           k8s.v1.cni.cncf.io/network-status:\n                           k8s.v1.cni.cncf.io/networks-status:\n  Normal   Killing         2m7s   kubelet            Stopping container app\nPod 关键区块:\nTermination Grace Period:  3900s\nQoS Class: Burstable\nNode-Selectors: <none>\nTolerations: node.kubernetes.io/not-ready:NoExecute op=Exists for 300s\nContainers:\n  app:\n    Container ID:  containerd://ec10ad25ac02acdafa941c7b5f9c7486f695816a5cb938d7e56e4c7f1b184e7c\n    Image:         xnet.registry.io:8443/observability/python:3-alpine\n    Image ID:      xnet.registry.io:8443/observability/python@sha256:3638eee7d584c52c0ce943653346383230c503b856e708fa7ecea8d9975adde3\n    Command:\n      python3\n      -u\n      -c\n      from pathlib import Path\n      import signal, time\n    State:          Running\n      Started:      Mon, 14 Sep 2026 07:52:48 +0000\n    Ready:          True\n    Restart Count:  0\n    Limits:\n      cpu:     50m\n      memory:  32Mi\n    Requests:\n      cpu:        5m\n      memory:     8Mi\n    Readiness:    exec [python3 -c import os; assert os.path.exists('/proc/1/status')] delay=3s timeout=1s period=2s #success=1 #failure=3\n    Environment:  <none>\n    Mounts:\nVolumes:\n  state:\n    Type:        EmptyDir (a temporary directory that shares a pod's lifetime)\nEvents:\n  Normal   Killing         2m7s   kubelet            Stopping container app\n  Warning  Unhealthy       112s   kubelet            Readiness probe failed: command \"python3 -c import os; assert os.path.exists('/proc/1/status')\" timed out\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/8675758576f9475a-g1/tools/023-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/8675758576f9475a-g1/tools/023-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/8675758576f9475a-g1/tools/023-evidence-kubectl_describe.summary.txt"}

