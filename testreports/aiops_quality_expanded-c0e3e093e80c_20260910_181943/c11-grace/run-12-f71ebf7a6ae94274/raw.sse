data: {"id": "f71ebf7a6ae94274-node_complete-parallel_evidence", "run_id": "f71ebf7a6ae94274", "seq": 1249, "ts_ms": 1789368814347, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.257, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v13", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/f71ebf7a6ae94274-g1/lane_artifacts/g1/artifact.json", "sha256": "a068a73142332409462b4de65ac187edba7d42bb2c8936f11e16772756e0c500", "bytes": 2420}, "snapshot_sha256": "56c9060b101197a09777839463350456501d90dde9b836185890f378c7373496"}]}, "handoff_summary": ""}

