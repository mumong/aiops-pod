1 aiops-case-v13/workload: 40.8s (Evidence 31.4s, RCA 9.3s)\n└─ 汇总总结: 10.3s\n```\n\n📋 Runbook 参考\n\n- 未调用 Runbook\n", "answer_source": "workflow", "elapsed_seconds": 61.752, "metrics": {"run_id": "34f2d19a2ddb4510", "mttr": {"value": "1.0m", "seconds": 61.75495171546936, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "32%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": false, "runbook_id": null, "pass": false, "score": 0.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 0.0, "weighted_score": 0.0}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.0, "weighted_score": 0.0}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.0, "weighted_score": 0.0}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.3, "weighted_score": 0.045, "description": "Runbook 匹配质量", "detail": "未匹配"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 61754.95171546936, "llm_calls": 9, "llm_duration_ms": 57558.971643447876, "tool_calls": 8, "executed_tool_calls": 8, "deduplicated_tool_calls": 0, "successful_tool_calls": 8, "failed_tool_calls": 0, "tool_duration_ms": 10437.302827835083, "tool_wall_duration_ms": 3831.458330154419}, "nodes": {"layer": {"name": "问题定位", "duration_ms"