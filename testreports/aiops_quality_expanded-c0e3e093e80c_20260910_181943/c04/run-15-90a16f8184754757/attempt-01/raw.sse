data: {"id": "90a16f8184754757-node_complete-parallel_evidence", "run_id": "90a16f8184754757", "seq": 910, "ts_ms": 1789053593402, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 36.668, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-h4lt9"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/90a16f8184754757-g1/lane_artifacts/g1/artifact.json", "sha256": "2063eda0228eb7b47dae1b801aebb03dc4b56a277ede893779cfc4e952296174", "bytes": 2452}, "snapshot_sha256": "10e2da2cfc015f1cf55c09fffe74cf61e9b7b24a800ba2caca4b5a22af2eda03"}]}, "handoff_summary": ""}

