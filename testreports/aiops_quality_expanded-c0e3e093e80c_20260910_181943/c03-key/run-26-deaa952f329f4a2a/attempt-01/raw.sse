data: {"id": "deaa952f329f4a2a-node_complete-parallel_evidence", "run_id": "deaa952f329f4a2a", "seq": 1093, "ts_ms": 1789123746070, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 43.921, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v05", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/deaa952f329f4a2a-g1/lane_artifacts/g1/artifact.json", "sha256": "a20262793abe96c3076fa83f5c2fae987c38ad8113f24eeb11485d9b927df495", "bytes": 2420}, "snapshot_sha256": "e525f9010959d3f7429e47a6b20234e38ba839203481ddc583b1f81fd91fdd8b"}]}, "handoff_summary": ""}

