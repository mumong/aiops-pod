data: {"id": "5d675651b3654666-node_complete-parallel_evidence", "run_id": "5d675651b3654666", "seq": 3083, "ts_ms": 1789122511128, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 28.448, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v05", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5d675651b3654666-g1/lane_artifacts/g1/artifact.json", "sha256": "f9ecbc71d20015c59e84df65d1b20d338c92d15d2622aa4e722115ecdc8cb7d1", "bytes": 2420}, "snapshot_sha256": "f124edc306a6ff0d7fd188a49a810cfcf8d1af356577e1fc7875a64b2d353bb3"}]}, "handoff_summary": ""}

