data: {"id": "ccc38d80d9764419-node_complete-parallel_evidence", "run_id": "ccc38d80d9764419", "seq": 583, "ts_ms": 1789122658755, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 33.033, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v05", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/ccc38d80d9764419-g1/lane_artifacts/g1/artifact.json", "sha256": "1dd1112b7150b8d7d5d70d00bf3b12c42f8ff9415da2e143f6208c3c3d0ca975", "bytes": 2569}, "snapshot_sha256": "b733f5e30c9ad3f25f05e2bdae9a7b0299e27ef7452d6e4b568c9e138d5d4822"}]}, "handoff_summary": ""}

