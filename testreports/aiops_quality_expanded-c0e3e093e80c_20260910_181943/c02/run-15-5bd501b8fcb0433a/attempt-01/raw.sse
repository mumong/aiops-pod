data: {"id": "5bd501b8fcb0433a-node_complete-parallel_evidence", "run_id": "5bd501b8fcb0433a", "seq": 1072, "ts_ms": 1789042717684, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 31.529, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-z7kdp"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5bd501b8fcb0433a-g1/lane_artifacts/g1/artifact.json", "sha256": "7a97173f9f214e1b61413e8d1109ac175968017130c989e626d3b4e675303fee", "bytes": 2634}, "snapshot_sha256": "bbbce7eb7dd8f22996d2b0ac03ea07790403fcd27fa98458c097385c74dedce7"}]}, "handoff_summary": ""}

