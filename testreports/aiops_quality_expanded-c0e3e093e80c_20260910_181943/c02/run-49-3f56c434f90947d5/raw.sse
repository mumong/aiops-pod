data: {"id": "3f56c434f90947d5-node_complete-parallel_evidence", "run_id": "3f56c434f90947d5", "seq": 1435, "ts_ms": 1789352768385, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 29.704, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-jmq6b"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/3f56c434f90947d5-g1/lane_artifacts/g1/artifact.json", "sha256": "9a8b669a5967605d456ed31c71e5a6b51b430a70b3d605268eff5d175d5310d0", "bytes": 2633}, "snapshot_sha256": "6a2d7c797f9beaa237adcba3e6e96772f934db3fe7d12c27bc6f988bcef06fd6"}]}, "handoff_summary": ""}

