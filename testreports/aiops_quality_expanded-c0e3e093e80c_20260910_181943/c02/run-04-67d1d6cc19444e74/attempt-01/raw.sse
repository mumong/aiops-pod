data: {"id": "67d1d6cc19444e74-node_complete-parallel_evidence", "run_id": "67d1d6cc19444e74", "seq": 1143, "ts_ms": 1789041426521, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 45.016, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-z7kdp"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/67d1d6cc19444e74-g1/lane_artifacts/g1/artifact.json", "sha256": "6459ff130352eea6a4a2d643eb7bccee7ba66fcd9b747774df7db9c27680117e", "bytes": 2451}, "snapshot_sha256": "d37b2f6cac9edb82f8c4f2c50d1f795aa0e5b27f544e26c0de69ce6ae71d6c98"}]}, "handoff_summary": ""}

