data: {"id": "5046832526c746ef-node_complete-parallel_evidence", "run_id": "5046832526c746ef", "seq": 1310, "ts_ms": 1789352711235, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.305, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-jmq6b"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5046832526c746ef-g1/lane_artifacts/g1/artifact.json", "sha256": "5760d706451c424bbb6986eda703eb39bc6a85ddbc981bfa6a7845bcfa95954e", "bytes": 2452}, "snapshot_sha256": "8dbf99bd0329b6ee6afba58e26a4312e7c81768586cc2eb20a538d4be257b1b2"}]}, "handoff_summary": ""}

