data: {"id": "85527a5a2a8343a0-thinking-parallel_evidence-1189", "run_id": "85527a5a2a8343a0", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v03\nnode: <none>\nstatus: Pending\n关键诊断行:\n  Warning  FailedScheduling  33m                  default-scheduler  0/3 nodes are available: persiste", "duration_seconds": null, "iteration": 1, "ts_ms": 1789115777961, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v03", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_7e20f5a46b57465fb6371915", "tool_sequence": 1, "semantic_success": true, "result": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v03\nnode: <none>\nstatus: Pending\n关键诊断行:\n  Warning  FailedScheduling  33m                  default-scheduler  0/3 nodes are available: persistentvolumeclaim \"unavailable-claim\" not found. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n  Warning  FailedScheduling  8m41s (x5 over 28m)  default-scheduler  0/3 nodes are available: persistentvolumeclaim \"unavailable-claim\" not found. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\nPod 关键区块:\nQoS Class: Burstable\nNode-Selectors: <none>\nTolerations: node.kubernetes.io/not-ready:NoExecute op=Exists for 300s\nContainers:\n  app:\n    Image:      xnet.registry.io:8443/observability/python:3-alpine\n    Command:\n      python3\n      -u\n      -c\n      import time; print('application started', flush=True); time.sleep(86400)\n    Limits:\n      cpu:     50m\n      memory:  32Mi\n    Requests:\n      cpu:        5m\n      memory:     8Mi\n    Environment:  <none>\n    Mounts:\nVolumes:\n  input:\n    Type:        PersistentVolumeClaim (a reference to a PersistentVolumeClaim in the same namespace)\n    ClaimName:   unavailable-claim\nEvents:\n  Warning  FailedScheduling  33m                  default-scheduler  0/3 nodes are available: persistentvolumeclaim \"unavailable-claim\" not found. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n  Warning  FailedScheduling  8m41s (x5 over 28m)  default-scheduler  0/3 nodes are available: persistentvolumeclaim \"unavailable-claim\" not found. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/85527a5a2a8343a0-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/85527a5a2a8343a0-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/85527a5a2a8343a0-g1/tools/004-evidence-kubectl_describe.summary.txt"}

