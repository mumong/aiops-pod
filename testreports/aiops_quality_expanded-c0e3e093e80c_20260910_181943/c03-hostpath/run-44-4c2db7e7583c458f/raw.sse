data: {"id": "4c2db7e7583c458f-node_complete-parallel_evidence", "run_id": "4c2db7e7583c458f", "seq": 1694, "ts_ms": 1789131315321, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 29.048, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v06", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/4c2db7e7583c458f-g1/lane_artifacts/g1/artifact.json", "sha256": "2f466fdcf42e43e7f3246e60f86547c5eb9e9e69c779b3600d93b2e1516ef6b7", "bytes": 2420}, "snapshot_sha256": "5b63387d3e336a8920a2d39312d85cc6955ce75adfe098600587388666d64cb6"}]}, "handoff_summary": ""}

