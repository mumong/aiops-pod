data: {"id": "0d26fc19fead4b17-node_complete-parallel_evidence", "run_id": "0d26fc19fead4b17", "seq": 2984, "ts_ms": 1789127758470, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 38.594, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v06", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0d26fc19fead4b17-g1/lane_artifacts/g1/artifact.json", "sha256": "b6497adb6125c09361bce35905ef0d9067b119a9fedb8173c2f3e21013cb2334", "bytes": 2420}, "snapshot_sha256": "a47145ad0c93650f64f3cfb9a4aadb2532c3d57f620d3b836ad1eddffd4483d5"}]}, "handoff_summary": ""}

