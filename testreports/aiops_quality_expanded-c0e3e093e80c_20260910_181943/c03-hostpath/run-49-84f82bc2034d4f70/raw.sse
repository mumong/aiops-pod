data: {"id": "84f82bc2034d4f70-node_complete-parallel_evidence", "run_id": "84f82bc2034d4f70", "seq": 814, "ts_ms": 1789131637976, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 29.765, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v06", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/84f82bc2034d4f70-g1/lane_artifacts/g1/artifact.json", "sha256": "0085ebb1c2dc086802096be4ea830593cdb083cc52b1505d61f0c579b764768e", "bytes": 2420}, "snapshot_sha256": "82957cc0c2040d1772df63ff53d9d04f0c4af49113c2c05f99efe8a08ede3567"}]}, "handoff_summary": ""}

