: 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 248368.06750297546, "llm_calls": 13, "llm_duration_ms": 198312.87360191345, "tool_calls": 18, "executed_tool_calls": 16, "deduplicated_tool_calls": 2, "successful_tool_calls": 18, "failed_tool_calls": 0, "tool_duration_ms": 96164.2062664032, "tool_wall_duration_ms": 49467.94581413269}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 20266.427516937256, "success": true}, "parallel_evidence": {"name": "并发证据采集", "duration_ms": 213710.82973480225, "success": true}, "evidence": {"name": "evidence", "duration_ms": 0.0, "success": true}, "rca": {"name": "rca", "duration_ms": 0.0, "success": true}, "conclusion": {"name": "汇总总结", "duration_ms": 14350.55947303772, "success": true}}, "success": true, "errors": []}}

