data: {"id": "7e25fca5a76c4af1-thinking-parallel_evidence-941", "run_id": "7e25fca5a76c4af1", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_get_yaml", "content": null, "status": "success", "result_preview": "Deployment workload in namespace aiops-case-09 is unavailable and has timed out progressing. The readiness probe is configured to fail intentionally via env var FAILURE_MODE=readiness_fail.\nkey_facts:", "duration_seconds": null, "iteration": 4, "ts_ms": 1789090704922, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "kubernetes"}, "tool_call_id": "call_2cb2a4f88a4b477785f97d44", "tool_sequence": 10, "semantic_success": true, "result": "Deployment workload in namespace aiops-case-09 is unavailable and has timed out progressing. The readiness probe is configured to fail intentionally via env var FAILURE_MODE=readiness_fail.\nkey_facts: [\"Kind: Deployment\", \"Name: workload\", \"Namespace: aiops-case-09\", \"Replicas: 1 (unavailableReplicas: 1)\", \"Container name: app\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Container Command: python3 /opt/aiops/server.py\", \"Env: FAILURE_MODE=readiness_fail\", \"Readiness Probe: httpGet path=/ready, failureThreshold=1, initialDelaySeconds=2, periodSeconds=3\", \"Status Condition Available: status=False, reason=MinimumReplicasUnavailable\", \"Status Condition Progressing: status=False, reason=ProgressDeadlineExceeded, message='ReplicaSet workload-5f4fb9ff45 has timed out progressing.'\", \"Labels: app.kubernetes.io/name=workload, aiops.lab/case-id=c09\"]", "raw_ref": "/tmp/aiops/reports/context_archives/7e25fca5a76c4af1-g1/tools/013-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/7e25fca5a76c4af1-g1/tools/013-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives