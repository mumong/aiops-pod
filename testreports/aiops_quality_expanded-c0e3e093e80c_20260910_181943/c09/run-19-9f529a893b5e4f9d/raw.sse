data: {"id": "9f529a893b5e4f9d-thinking-parallel_evidence-1199", "run_id": "9f529a893b5e4f9d", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "Pod workload-5f4fb9ff45-5mlnc 存在持续的 Readiness Probe 失败事件，表现为 1039 次 503 错误和连接拒绝。\nkey_facts: [\"Pod: workload-5f4fb9ff45-5mlnc\", \"Warning: Readiness probe failed (Reason: Unhealthy)\", \"Event 1: HTTP pro", "duration_seconds": null, "iteration": 10, "ts_ms": 1789089925512, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-5mlnc"}, "dimension": "kubernetes"}, "tool_call_id": "call_ff33667b078845b789414683", "tool_sequence": 28, "semantic_success": true, "result": "Pod workload-5f4fb9ff45-5mlnc 存在持续的 Readiness Probe 失败事件，表现为 1039 次 503 错误和连接拒绝。\nkey_facts: [\"Pod: workload-5f4fb9ff45-5mlnc\", \"Warning: Readiness probe failed (Reason: Unhealthy)\", \"Event 1: HTTP probe 503 (Count: x1039 over 51m, Last seen: 67s)\", \"Event 2: dial tcp connection refused on 172.16.104.16:8080/ready (Last seen: 51m)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/9f529a893b5e4f9d-g1/tools/031-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/9f529a893b5e4f9d-g1/tools/031-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/9f529a893b5e4f9d-g1/tools/031-evidence-kubectl_events.summary.txt"}

