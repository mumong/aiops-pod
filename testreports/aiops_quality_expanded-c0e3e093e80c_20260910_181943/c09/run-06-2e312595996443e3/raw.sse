data: {"id": "2e312595996443e3-node_complete-parallel_evidence", "run_id": "2e312595996443e3", "seq": 1045, "ts_ms": 1789088156882, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 105.894, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-5mlnc"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2e312595996443e3-g1/lane_artifacts/g1/artifact.json", "sha256": "965ab0f6eaeca2320f502a275d00baf4251c3262bec325f1421d93e21ebaf6c2", "bytes": 2452}, "snapshot_sha256": "6c517471a69c05d3ea04bc2aca965b3065ede30ee4132d15b2d4eb4b72fe6069"}]}, "handoff_summary": ""}

