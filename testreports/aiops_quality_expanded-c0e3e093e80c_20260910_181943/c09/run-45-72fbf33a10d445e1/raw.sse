data: {"id": "72fbf33a10d445e1-node_complete-parallel_evidence", "run_id": "72fbf33a10d445e1", "seq": 1536, "ts_ms": 1789093524330, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 70.828, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-5mlnc"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/72fbf33a10d445e1-g1/lane_artifacts/g1/artifact.json", "sha256": "4c5d50a58958f4e3d833b82b59d8751504a4b38a8f8474e44fead7fb25f4f8c5", "bytes": 2452}, "snapshot_sha256": "18e0ecd14768de54bf6699ffa33e03f9a87dd7e78088912140b98f84119d1d39"}]}, "handoff_summary": ""}

