data: {"id": "773684f6e6f1498d-thinking-layer-204", "run_id": "773684f6e6f1498d", "node": "layer", "node_name": "问题定位", "thinking_type": "ai_message", "tool_name": null, "content": "Pod `workload-5f4fb9ff45-5mlnc` 状态为 `Running` 但 `READY` 为 `0/1`。这通常意味着容器正在运行，但未通过就绪探针（Readiness Probe）或启动探针（Startup Probe）的探测，或者容器处于“未就绪”状态。\n\n根据异常分类规则，这属于 `NotReadyProbeFailed` 类型的异常。我将获取相应的 Runbook 以指导后续的深入诊断。\n\n", "status": null, "result_preview": null, "duration_seconds": null, "iteration": 3, "ts_ms": 1789089274691}

