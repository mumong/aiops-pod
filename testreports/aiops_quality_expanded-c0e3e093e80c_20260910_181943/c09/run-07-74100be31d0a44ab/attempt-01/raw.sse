data: {"id": "74100be31d0a44ab-node_complete-parallel_evidence", "run_id": "74100be31d0a44ab", "seq": 792, "ts_ms": 1789088258780, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 70.014, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-5mlnc"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/74100be31d0a44ab-g1/lane_artifacts/g1/artifact.json", "sha256": "ccc2452bdf345295b3ed36f2d28ed3254d748745d584e6da8af7d1ebdcdec66a", "bytes": 2451}, "snapshot_sha256": "ad32c878a322bee44009e3e17d29d26bf460d2674ed9708c4cf843343bcf60d8"}]}, "handoff_summary": ""}

