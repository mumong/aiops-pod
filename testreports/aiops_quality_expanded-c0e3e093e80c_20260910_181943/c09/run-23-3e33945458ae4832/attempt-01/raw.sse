data: {"id": "3e33945458ae4832-node_complete-parallel_evidence", "run_id": "3e33945458ae4832", "seq": 1744, "ts_ms": 1789090594294, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 166.126, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-5mlnc"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/3e33945458ae4832-g1/lane_artifacts/g1/artifact.json", "sha256": "21874eb528f37f46eb5b488d466bca4c1e6496d402328044643089fd9bde08ed", "bytes": 2452}, "snapshot_sha256": "d59148493799e7d8ea3bc1b312e05e478287dc2373cc3fb015cfd1596b5c11b0"}]}, "handoff_summary": ""}

