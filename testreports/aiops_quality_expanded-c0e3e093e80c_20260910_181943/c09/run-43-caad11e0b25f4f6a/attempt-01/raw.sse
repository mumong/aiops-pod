\n- **g1 aiops-case-09/workload-5f4fb9ff45-5mlnc**: pod-notready-probe-failed\n", "answer_source": "workflow", "elapsed_seconds": 96.512, "metrics": {"run_id": "caad11e0b25f4f6a", "mttr": {"value": "1.6m", "seconds": 96.5324056148529, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-notready-probe-failed", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-notready-probe-failed"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 96532.4056148529, "llm_calls": 11, "llm_duration_ms": 67348.89578819275, "tool_calls": 12, "executed_tool_calls": 12, "deduplicated_tool_calls": 0, "successful_tool_calls": 12, "failed_tool_calls": 0, "tool_duration_ms": 60790.83442687988, "tool_wall_duration_ms": 28720.00813484192}, "nodes": {"layer": {"name": "问题定位", "dur