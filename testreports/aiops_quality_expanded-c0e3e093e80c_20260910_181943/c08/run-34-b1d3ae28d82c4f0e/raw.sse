data: {"id": "b1d3ae28d82c4f0e-node_complete-parallel_evidence", "run_id": "b1d3ae28d82c4f0e", "seq": 384, "ts_ms": 1789083830572, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 49.094, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-p8462"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/b1d3ae28d82c4f0e-g1/lane_artifacts/g1/artifact.json", "sha256": "7ef8743e3c0bf13b77a58293df0dc8ecd1d848727b4f09ac133a7e35b767817e", "bytes": 2452}, "snapshot_sha256": "6184ed6357e9f88c1a49407a4d3a2911839f197afbc75d0147e439de13a7ad01"}]}, "handoff_summary": ""}

