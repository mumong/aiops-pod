data: {"id": "ccb3530716bb4280-node_complete-parallel_evidence", "run_id": "ccb3530716bb4280", "seq": 1927, "ts_ms": 1789084562018, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 83.571, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-p8462"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/ccb3530716bb4280-g1/lane_artifacts/g1/artifact.json", "sha256": "914d8e4e2542c6c3f65019bec0e2ee6970fe4885f1f65317e972e03e6849e38a", "bytes": 2452}, "snapshot_sha256": "0b2c2cb452a7666e67ef465f5e909bbbf7de430e522ebd0d8aa488255cbfd849"}]}, "handoff_summary": ""}

event: node_start
data: {"id": "ccb3530716bb4280-node_start-conclusion", "run_id": "ccb3530716bb4280", "seq": 1928, "ts_ms": 1789084562019, "node": "conclusion", "node_name": "汇总总结"}

