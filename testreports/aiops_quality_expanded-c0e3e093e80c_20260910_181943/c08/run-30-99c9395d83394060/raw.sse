data: {"id": "99c9395d83394060-node_complete-parallel_evidence", "run_id": "99c9395d83394060", "seq": 857, "ts_ms": 1789083222614, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 82.078, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-p8462"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/99c9395d83394060-g1/lane_artifacts/g1/artifact.json", "sha256": "09e128fdb23c11c9920d0593af0120f6e4427f2debaa044be8b7125c2a544ca4", "bytes": 2452}, "snapshot_sha256": "08eeaaedf68dfe351bf07006fcdeffd2c62b2c96893bfe264908e41c3ecb9be2"}]}, "handoff_summary": ""}

