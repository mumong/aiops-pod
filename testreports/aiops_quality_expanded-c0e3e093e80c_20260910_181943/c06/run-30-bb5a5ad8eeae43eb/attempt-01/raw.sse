data: {"id": "bb5a5ad8eeae43eb-node_complete-parallel_evidence", "run_id": "bb5a5ad8eeae43eb", "seq": 1333, "ts_ms": 1789069078332, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 64.029, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-n5vp8"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/bb5a5ad8eeae43eb-g1/lane_artifacts/g1/artifact.json", "sha256": "e4c7ed5a32587a95665032bdfaf54e756b883819754c789aba9efee5763e9d26", "bytes": 2450}, "snapshot_sha256": "9e7fa82050198a3d4461b05f5e73cdf1a0b7ea28b44ccc1a96f62830ff9a0321"}]}, "handoff_summary": ""}

