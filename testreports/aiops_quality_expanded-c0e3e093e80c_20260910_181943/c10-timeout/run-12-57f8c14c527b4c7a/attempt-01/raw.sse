data: {"id": "57f8c14c527b4c7a-thinking-parallel_evidence-1521", "run_id": "57f8c14c527b4c7a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "ai_message", "tool_name": null, "content": "已采集事实、冲突与缺口如下：\n\n### 1. 已采集事实\n*   **生命周期状态：** Pod `workload` 当前状态为 `CrashLoopBackOff`，已重启 11 次，属于活跃异常期。\n*   **根因信号 (Exit Code 137)：** `kubectl describe` 明确记录上一次容器终止原因为 `OOMKilled` (Exit Code 137)。\n*   **资源瓶颈 (Memory vs Limit)：** Metrics 显示当前工作内存约 3.2 MiB，远低于 64Mi 的 Limit。事件日志记录 `Killing` 原因，确认是被 OOMKilled，而非磁盘或配置错误。\n*   **阻塞根因 (Code vs Liveness)：** \n    *   日志显示主进程成功监听 `18080` 端口并正常响应健康检查。\n    *   `kubectl describe` 显示 Liveness Probe 失败原因为 `context deadline exceeded`。\n    *   二者冲突表明：应用实际上已启动，但因代码", "status": null, "result_preview": null, "duration_seconds": null, "iteration": 3, "ts_ms": 1789392603889, "lane_stage": "evidence"}

event: node_complete
data: {"id": "57f8c14c527b4c7a-node_complete-parallel_evidence", "run_id": "57f8c14c527b4c7a", "seq": 1522, "ts_ms": 1789392616308, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 82.342, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/57f8c14c527b4c7a-g1/lane_artifacts/g1/artifact.json", "sha256": "e1ce5c7b52a293cc1dcdddc90c575c0f0d14de51c772cbdf3aba947babbc0c41", "bytes": 2420}, "snapshot_sha256": "df38bc4b5cd6795408b9e364e02475b5a989615be4e8878a159d5eb68e32d867"}]}, "handoff_summary": ""}

