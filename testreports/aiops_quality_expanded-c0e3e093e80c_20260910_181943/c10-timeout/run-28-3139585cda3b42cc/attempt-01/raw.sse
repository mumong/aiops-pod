iceAccountToken\\\":false,\\\"containers\\\":[{\\\"command\\\":[\\\"python3\\\",\\\"-u\\\",\\\"-c\\\",\\\"from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\\\nimport time\\\\nclass Handler(BaseHTTPRequestHandler):\\\\n    def do_GET(self):\\\\n        if self.path == '/health': time.sleep(3)\\\\n        self.send_response(200)\\\\n        self.end_headers()\\\\n        try: self.wfile.write(b'ok')\\\\n        except BrokenPipeError: pass\\\\nprint('listening on 18080', flush=True)\\\\nThreadingHTTPServer(('0.0.0.0',18080),Handler).serve_forever()\\\\n\\\"],\\\"image\\\":\\\"xnet.registry.io:8443/observability/python:3-alpine\\\",\\\"imagePullPolicy\\\":\\\"IfNotPresent\\\",\\\"livenessProbe\\\":{\\\"failureThreshold\\\":2,\\\"httpGet\\\":{\\\"path\\\":\\\"/health\\\",\\\"port\\\":18080},\\\"initialDelaySeconds\\\":10,\\\"periodSeconds\\\":5,\\\"timeoutSeconds\\\":1},\\\"name\\\":\\\"app\\\",\\\"readinessProbe\\\":{\\\"httpGet\\\":{\\\"path\\\":\\\"/ready\\\",\\\"port\\\":18080},\\\"initialDelaySeconds\\\":3,\\\"periodSeconds\\\":3},\\\"resources\\\":{\\\"limits\\\":{\\\"cpu\\\":\\\"200m\\\",\\\"memory\\\":\\\"64Mi\\\"},\\\"requests\\\":{\\\"cpu\\\":\\\"5m\\\",\\\"memory\\\":\\\"8Mi\\\"}},\\\"securityContext\\\":{\\\"allowPrivilegeEscalation\\\":false,\\\"capabilities\\\":{\\\"drop\\\":[\\\"ALL\\\"]},\\\"readOnlyRootFilesystem\\\":true}}],\\\"restartPolicy\\\":\\\"Always\\\",\\\"securityContext\\\":{\\\"fsGroup\\\":1000,\\\"runAsGroup\\\":1000,\\\"runAsNonRoot\\\":true,\\\"runAsUser\\\":1000,\\\"seccompProfile\\\":{\\\"type\\\":\\\"RuntimeDefault\\\"}},\\\"terminationGracePeriodSeconds\\\":5}}\\n  creationTimestamp: \\\"2026-09-14T13:05:55Z\\\"\\n  labels:\\n    aiops.lab/case-id: v17\\n    app.kubernetes.io/name: workload\\n  name: workload\\n  namespace: aiops-case-v17\\n  resourceVersion: \\\"103822607\\\"\\n  uid: 85aece07-6ffa-41db-9e5a-f351771a8864\\nspec:\\n  automountServiceAccountToken: false\\n  containers:\\n  - command:\\n    - python3\