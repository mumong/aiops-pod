data: {"id": "c614923441104179-node_complete-parallel_evidence", "run_id": "c614923441104179", "seq": 1580, "ts_ms": 1789396498566, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 71.851, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/c614923441104179-g1/lane_artifacts/g1/artifact.json", "sha256": "76ea35eb52f6f31fb1d24be1d352560887d87b637c8e23441a0d56fe7bdb93cd", "bytes": 2420}, "snapshot_sha256": "0be83aa6c42735bba78429af93664445288c6dc81b9754a880767c5a9c2ec4f6"}]}, "handoff_summary": ""}

