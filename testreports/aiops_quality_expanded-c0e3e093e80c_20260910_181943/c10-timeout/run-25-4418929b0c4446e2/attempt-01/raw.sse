data: {"id": "4418929b0c4446e2-thinking-parallel_evidence-123", "run_id": "4418929b0c4446e2", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "kubectl_events 摘要:\n关键诊断行:\n56m (x2 over 57m)       Warning   Unhealthy        Pod/workload   Readiness probe failed: Get \"http://172.16.104.36:18080/ready\": dial tcp 172.16.104.36:18080: connect: conne", "duration_seconds": null, "iteration": 2, "ts_ms": 1789394632697, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_5ea959603e5b4dc8874295be", "tool_sequence": 4, "semantic_success": true, "result": "kubectl_events 摘要:\n关键诊断行:\n56m (x2 over 57m)       Warning   Unhealthy        Pod/workload   Readiness probe failed: Get \"http://172.16.104.36:18080/ready\": dial tcp 172.16.104.36:18080: connect: connection refused\n2m19s (x45 over 57m)    Warning   Unhealthy        Pod/workload   Liveness probe failed: Get \"http://172.16.104.36:18080/health\": context deadline exceeded (Client.Timeout exceeded while awaiting headers)\n7m19s (x211 over 55m)   Warning   BackOff          Pod/workload   Back-off restarting failed container app in pod workload_aiops-case-v17(85aece07-6ffa-41db-9e5a-f351771a8864)\n56m (x3 over 57m)       Normal    Killing          Pod/workload   Container app failed liveness probe, will be restarted", "raw_ref": "/tmp/aiops/reports/context_archives/4418929b0c4446e2-g1/tools/007-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/4418929b0c4446e2-g1/tools/007-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/4418929b0c4446e2-g1/tools/007-evidence-kubectl_events.summary.txt"}

