led, pod-config-error\n", "answer_source": "workflow", "elapsed_seconds": 85.885, "metrics": {"run_id": "4418929b0c4446e2", "mttr": {"value": "1.4m", "seconds": 85.89674043655396, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "45%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-oomkilled, pod-config-error, pod-crashloop-runtime", "pass": true, "score": 0.85, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.3, "weighted_score": 0.09}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.3, "weighted_score": 0.06}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.8, "weighted_score": 0.12, "description": "Runbook 匹配质量", "detail": "已匹配（未识别核心）"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 85896.74043655396, "llm_calls": 15, "llm_duration_ms": 57190.19627571106, "tool_calls": 15, "executed_tool_calls": 10, "deduplicated_tool_calls": 4, "successful_tool_calls": 14, "failed_tool_calls": 1, "tool_duration_ms": 17665.174961090088, "tool_wall_duration_ms": 11433.866262435913}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 14745.903491973877, "success