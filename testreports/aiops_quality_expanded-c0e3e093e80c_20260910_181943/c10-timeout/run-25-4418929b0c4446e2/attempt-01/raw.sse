data: {"id": "4418929b0c4446e2-thinking-parallel_evidence-121", "run_id": "4418929b0c4446e2", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\n关键诊断行:\nPod workload in namespace aiops-case-v17 on node2 is in CrashLoopBackOff. The app container (python:3-alpine) restarts continuously (23 times) with Exit Code 137 (SIGKILL).", "duration_seconds": null, "iteration": 2, "ts_ms": 1789394615914, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_f7016ec2fc014ffe96a65c5f", "tool_sequence": 3, "semantic_success": true, "result": "kubectl_describe 摘要:\n关键诊断行:\nPod workload in namespace aiops-case-v17 on node2 is in CrashLoopBackOff. The app container (python:3-alpine) restarts continuously (23 times) with Exit Code 137 (SIGKILL). Liveness probes to http://172.16.104.36:18080/health are timing out (context deadline exceeded), and readiness probes to /ready are refusing connections.\nkey_facts: [\"Pod: workload, Namespace: aiops-case-v17, Node: node2/10.2.0.50\", \"Container: app, Image: xnet.registry.io:8443/observability/python:3-alpine\", \"State: Waiting (CrashLoopBackOff), Last State: Terminated (Error, Exit Code 137)\", \"Restart Count: 23\", \"Pod IP: 172.16.104.36\", \"Liveness Probe: http://172.16.104.36:18080/health (timeout=1s, period=5s) - Failed: context deadline exceeded\", \"Readiness Probe: http://172.16.104.36:18080/ready (timeout=1s, period=3s) - Failed: connection refused\", \"Command: python3 -c ... ThreadingHTTPServer(('0.0.0.0',18080) ... do_GET /health time.sleep(3)\"]\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/4418929b0c4446e2-g1/tools/006-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/4418929b0c4446e2-g1/tools/006-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/4418929b0c4446e2-g1/tools/006-evidence-kubectl_describe.summary.txt"}

