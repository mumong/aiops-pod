xt\n├─ 总耗时: 1.4m\n├─ 问题定位: 16.2s\n├─ 并发证据采集: 55.0s\n│  └─ g1 aiops-case-v17/workload: 55.0s (Evidence 45.0s, RCA 9.8s)\n└─ 汇总总结: 11.7s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-v17/workload**: pod-crashloop-runtime\n", "answer_source": "workflow", "elapsed_seconds": 82.938, "metrics": {"run_id": "6cbc95dd3a3f4ec1", "mttr": {"value": "1.4m", "seconds": 82.94251990318298, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-crashloop-runtime", "pass": true, "score": 0.9333, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.6666666666666666, "weighted_score": 0.1333}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-crashloop-runtime"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 82942.51990318298, "llm_calls": 15, "llm_duration_ms": 71372.60055541992, "tool_calls": 15, "executed_tool_calls": 11, "deduplicated_tool_calls": 3, "successful_tool_calls": 