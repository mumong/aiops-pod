odScheduled: status=True reason=None\ncontainerStatuses:\n- app: ready=True restarts=17 reason=Error exitCode=137", "raw_ref": "/tmp/aiops/reports/context_archives/6171f679b89a404b-g1/tools/009-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/6171f679b89a404b-g1/tools/009-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/6171f679b89a404b-g1/tools/009-evidence-kubectl_get_yaml.summary.txt"}

