meout=1s\"]", "raw_ref": "/tmp/aiops/reports/context_archives/7566f8c019a14297-g1/tools/019-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/7566f8c019a14297-g1/tools/019-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/7566f8c019a14297-g1/tools/019-evidence-kubectl_describe.summary.txt"}

