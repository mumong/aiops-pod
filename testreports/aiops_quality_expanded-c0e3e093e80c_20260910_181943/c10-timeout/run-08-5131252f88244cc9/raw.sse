data: {"id": "5131252f88244cc9-node_complete-parallel_evidence", "run_id": "5131252f88244cc9", "seq": 2041, "ts_ms": 1789392116928, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 98.817, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 0, "inconclusive_count": 1, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}], "diagnostic_status": "inconclusive", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5131252f88244cc9-g1/lane_artifacts/g1/artifact.json", "sha256": "8718f9d9a8d905c2e70d8eccafd4dcb0bdd7c837751ef561111c8484ac945a0f", "bytes": 2424}, "snapshot_sha256": "41048a788b46f95ccde1b14b4e0c280760b06e704c8948e2b2d8f2d7050bdc2c"}]}, "handoff_summary": ""}

