data: {"id": "5131252f88244cc9-thinking-parallel_evidence-1074", "run_id": "5131252f88244cc9", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload in namespace aiops-case-v17 is in CrashLoopBackOff state. Container app (python:3-alpine) is repeatedly crashing with Exit Code 137 and failing liveness/readiness probes due to connection", "duration_seconds": null, "iteration": 1, "ts_ms": 1789392065188, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_b86c86c8b31f478b969a16ed", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload in namespace aiops-case-v17 is in CrashLoopBackOff state. Container app (python:3-alpine) is repeatedly crashing with Exit Code 137 and failing liveness/readiness probes due to connection refused and timeout issues on port 18080.\nkey_facts: [\"Name: workload\", \"Namespace: aiops-case-v17\", \"Node: node2/10.2.0.50\", \"Pod IP: 172.16.104.36\", \"Container Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Status: Running (but Ready: False, CrashLoopBackOff)\", \"Container State: Waiting (Reason: CrashLoopBackOff)\", \"Last State: Terminated (Reason: Error, Exit Code: 137)\", \"Restart Count: 9\", \"Liveness Probe: http-get http://:18080/health, Failed with 'context deadline exceeded'\", \"Readiness Probe: http-get http://:18080/ready, Failed with 'connection refused'\", \"Events: Warning BackOff (x40 over 12m), Warning Unhealthy (Liveness x13 over 14m, Readiness x2 over 14m)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/5131252f88244cc9-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/5131252f88244cc9-g1/tools/0