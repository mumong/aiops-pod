data: {"id": "d78aa47db8864ec1-thinking-parallel_evidence-646", "run_id": "d78aa47db8864ec1", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_events", "content": null, "status": "success", "result_preview": "kubectl_events 摘要:\n关键诊断行:\n11m (x2 over 12m)      Warning   Unhealthy        Pod/workload   Readiness probe failed: Get \"http://172.16.104.36:18080/ready\": dial tcp 172.16.104.36:18080: connect: connec", "duration_seconds": null, "iteration": 1, "ts_ms": 1789391939821, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_8c0b4db1c3a546e6ae53307c", "tool_sequence": 2, "semantic_success": true, "result": "kubectl_events 摘要:\n关键诊断行:\n11m (x2 over 12m)      Warning   Unhealthy        Pod/workload   Readiness probe failed: Get \"http://172.16.104.36:18080/ready\": dial tcp 172.16.104.36:18080: connect: connection refused\n7m57s (x13 over 12m)   Warning   Unhealthy        Pod/workload   Liveness probe failed: Get \"http://172.16.104.36:18080/health\": context deadline exceeded (Client.Timeout exceeded while awaiting headers)\n2m55s (x40 over 10m)   Warning   BackOff          Pod/workload   Back-off restarting failed container app in pod workload_aiops-case-v17(85aece07-6ffa-41db-9e5a-f351771a8864)\n11m (x3 over 12m)      Normal    Killing          Pod/workload   Container app failed liveness probe, will be restarted", "raw_ref": "/tmp/aiops/reports/context_archives/d78aa47db8864ec1-g1/tools/006-evidence-kubectl_events.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/d78aa47db8864ec1-g1/tools/006-evidence-kubectl_events.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/d78aa47db8864ec1-g1/tools/006-evidence-kubectl_events.summary.txt"}

