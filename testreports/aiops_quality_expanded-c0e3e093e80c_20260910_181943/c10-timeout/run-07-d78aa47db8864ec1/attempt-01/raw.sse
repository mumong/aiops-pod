data: {"id": "d78aa47db8864ec1-thinking-parallel_evidence-645", "run_id": "d78aa47db8864ec1", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload in aiops-case-v17 namespace is stuck in CrashLoopBackOff (7 restarts). Container app exited with Code 137 (OOMKilled) and is failing Liveness/Readiness probes on port 18080 due to timeout", "duration_seconds": null, "iteration": 1, "ts_ms": 1789391939802, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_6e9a6726849b4b72973c2ea8", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload in aiops-case-v17 namespace is stuck in CrashLoopBackOff (7 restarts). Container app exited with Code 137 (OOMKilled) and is failing Liveness/Readiness probes on port 18080 due to timeout/connection refused.\nkey_facts: [\"Pod: workload, Namespace: aiops-case-v17, Node: node2/10.2.0.50\", \"Container: app, Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Status: Running, Reason: CrashLoopBackOff, Restart Count: 7\", \"Last Exit Code: 137 (Started 13:13:56, Finished 13:14:21)\", \"Limits: cpu 200m, memory 64Mi; Requests: cpu 5m, memory 8Mi\", \"Warning Unhealthy (Readiness): connection refused on 172.16.104.36:18080/ready\", \"Warning Unhealthy (Liveness): context deadline exceeded on 172.16.104.36:18080/health\", \"Warning BackOff: 40 times over 10m\"]", "raw_ref": "/tmp/aiops/reports/context_archives/d78aa47db8864ec1-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/d78aa47db8864ec1-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/d78aa47db8864ec1-g1/tools/005-evidence-kubectl_describe.summary.txt"}

