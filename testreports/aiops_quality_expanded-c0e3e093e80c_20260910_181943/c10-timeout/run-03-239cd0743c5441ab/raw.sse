data: {"id": "239cd0743c5441ab-node_complete-parallel_evidence", "run_id": "239cd0743c5441ab", "seq": 1562, "ts_ms": 1789391499615, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 78.871, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/239cd0743c5441ab-g1/lane_artifacts/g1/artifact.json", "sha256": "ca0fc4a9c1411ff5e8b30ae2dbf71110cbf53c7148785aaf31db7706ce9bcbf0", "bytes": 2420}, "snapshot_sha256": "4d6ea453f43dfec89de7d4a20ecf05241c3e7f8a57e000376cf3cad56f6d2c88"}]}, "handoff_summary": ""}

