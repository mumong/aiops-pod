tatus: [app]\n- ContainersReady: status=False reason=ContainersNotReady message=containers with unready status: [app]\n- PodScheduled: status=True reason=None\ncontainerStatuses:\n- app: ready=False restarts=11 reason=CrashLoopBackOff exitCode=137\n  message: back-off 5m0s restarting failed container=app pod=workload_aiops-case-v17(85aece07-6ffa-41db-9e5a-f351771a8864)", "raw_ref": "/tmp/aiops/reports/context_archives/6d314d1e8f2a4a7e-g1/tools/005-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/6d314d1e8f2a4a7e-g1/tools/005-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/6d314d1e8f2a4a7e-g1/tools/005-evidence-kubectl_get_yaml.summary.txt"}

