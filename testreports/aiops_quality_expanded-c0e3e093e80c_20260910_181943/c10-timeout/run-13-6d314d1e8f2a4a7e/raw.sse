data: {"id": "6d314d1e8f2a4a7e-thinking-parallel_evidence-316", "run_id": "6d314d1e8f2a4a7e", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod 'workload' in namespace 'aiops-case-v17' on node 'node2' is in CrashLoopBackOff. The container 'app' (python:3-alpine) exits with code 137 (OOMKilled) repeatedly. Health probes fail: Liveness prob", "duration_seconds": null, "iteration": 1, "ts_ms": 1789392685660, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_27378fc2316149e989889137", "tool_sequence": 1, "semantic_success": true, "result": "Pod 'workload' in namespace 'aiops-case-v17' on node 'node2' is in CrashLoopBackOff. The container 'app' (python:3-alpine) exits with code 137 (OOMKilled) repeatedly. Health probes fail: Liveness probe times out on /health (sleep 3s > 1s timeout), Readiness probe fails with connection refused on /ready (endpoint not implemented).\nkey_facts: [\"Resource: Pod workload (aiops-case-v17) on node node2/10.2.0.50\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"Status: Waiting/CrashLoopBackOff, Ready: False, Restart Count: 11\", \"Last State: Terminated, Exit Code: 137, Reason: Error\", \"Liveness Probe Failure: http-get http://:18080/health timeout (Client.Timeout exceeded)\", \"Readiness Probe Failure: dial tcp 172.16.104.36:18080: connect: connection refused\", \"Back-off restarting failed container: x104 over 23m\", \"App Logic: Listens on 18080, /health sleeps 3s, /ready not implemented\"]", "raw_ref": "/tmp/aiops/reports/context_archives/6d314d1e8f2a4a7e-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/6d314d1e