data: {"id": "75180c356ce54336-node_complete-parallel_evidence", "run_id": "75180c356ce54336", "seq": 2524, "ts_ms": 1789397060090, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 90.519, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/75180c356ce54336-g1/lane_artifacts/g1/artifact.json", "sha256": "681fa36241569829b5b04617cfa05bedf70df4fd7bb949a20bfb6a2c96feb7b7", "bytes": 2420}, "snapshot_sha256": "3e6529122005a478b6d42bf42e51ba76069a38a8b3cf3c49fbd53fe2fa228fa7"}]}, "handoff_summary": ""}

