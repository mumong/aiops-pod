data: {"id": "111899003f6d4385-node_complete-parallel_evidence", "run_id": "111899003f6d4385", "seq": 918, "ts_ms": 1789391284575, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 59.529, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/111899003f6d4385-g1/lane_artifacts/g1/artifact.json", "sha256": "9bee6435c393f509a7a45ef423dbf7b915755f10b3ebba038530668b6ec988cc", "bytes": 2420}, "snapshot_sha256": "75bda0784297b2a977a075cc50121717c532823b4eec1074c1ca1385143d7602"}]}, "handoff_summary": ""}

