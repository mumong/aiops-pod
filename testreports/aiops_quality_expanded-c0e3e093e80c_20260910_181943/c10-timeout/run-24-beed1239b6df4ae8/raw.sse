data: {"id": "beed1239b6df4ae8-thinking-parallel_evidence-265", "run_id": "beed1239b6df4ae8", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload in namespace aiops-case-v17 is running on node2 but experiencing severe container instability due to liveness probe timeouts and OOM-kill (Exit Code 137).\nkey_facts: [\"Resource: Pod workl", "duration_seconds": null, "iteration": 1, "ts_ms": 1789394508018, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v17", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_3e10a1e57c304da7971c676a", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload in namespace aiops-case-v17 is running on node2 but experiencing severe container instability due to liveness probe timeouts and OOM-kill (Exit Code 137).\nkey_facts: [\"Resource: Pod workload, Namespace: aiops-case-v17, Node: node2/10.2.0.50\", \"Container: app (Image: xnet.registry.io:8443/observability/python:3-alpine)\", \"State: Running (Current), Last State: Terminated (Exit Code 137, Reason: Error)\", \"Restart Count: 23\", \"Liveness Probe: Failing with 'context deadline exceeded' (timeout=1s, path=/health, sleep 3s in app code)\", \"Readiness Probe: Failing with 'connection refused' (path=/ready, not implemented in app code)\", \"Events: BackOff restarting (x211), Killing due to liveness failure (x3)\"]", "raw_ref": "/tmp/aiops/reports/context_archives/beed1239b6df4ae8-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/beed1239b6df4ae8-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/beed1239b6df4ae8-g1/tools/004-evidence-kubectl_describe.summary.txt"}

