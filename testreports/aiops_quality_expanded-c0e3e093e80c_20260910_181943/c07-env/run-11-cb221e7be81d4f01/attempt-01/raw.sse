g1 aiops-case-v10/workload**: pod-crashloop-runtime\n", "answer_source": "workflow", "elapsed_seconds": 77.345, "metrics": {"run_id": "cb221e7be81d4f01", "mttr": {"value": "1.3m", "seconds": 77.35393643379211, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "56%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-crashloop-runtime", "pass": true, "score": 0.9333, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.6666666666666666, "weighted_score": 0.1333}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-crashloop-runtime"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.9, "weighted_score": 0.18, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 90%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 77353.93643379211, "llm_calls": 13, "llm_duration_ms": 74636.05260848999, "tool_calls": 15, "executed_tool_calls": 14, "deduplicated_tool_calls": 1, "successful_tool_calls": 11, "failed_tool_calls": 4, "tool_duration_ms": 6900.045871734619, "tool_wall_duration_ms": 2388.838291168213}, "nodes": {"layer": {"name": "问题定位", "duration_ms":