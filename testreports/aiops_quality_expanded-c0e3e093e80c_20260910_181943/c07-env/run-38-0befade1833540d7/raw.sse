data: {"id": "0befade1833540d7-node_complete-parallel_evidence", "run_id": "0befade1833540d7", "seq": 1277, "ts_ms": 1789144407097, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 534.136, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v10", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0befade1833540d7-g1/lane_artifacts/g1/artifact.json", "sha256": "ff8014ddd6640001aaa5a0051b63ca08276e859be62cbfcccf61b16ac231b2eb", "bytes": 2420}, "snapshot_sha256": "13e805ce8e63a168d3976adc39613e4bedba99a81776ab746637ea6c052b5791"}]}, "handoff_summary": ""}

