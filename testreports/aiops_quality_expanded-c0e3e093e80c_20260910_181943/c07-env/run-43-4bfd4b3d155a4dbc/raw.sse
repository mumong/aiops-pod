data: {"id": "4bfd4b3d155a4dbc-node_complete-parallel_evidence", "run_id": "4bfd4b3d155a4dbc", "seq": 643, "ts_ms": 1789144751731, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 33.619, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v10", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/4bfd4b3d155a4dbc-g1/lane_artifacts/g1/artifact.json", "sha256": "d8e8b7cfb17d48af9151782e6034869113eed9c69f0e44b7ced6c1eddb842e7d", "bytes": 2420}, "snapshot_sha256": "2acdb55b13e8980051fa59b67290bfa4a50df013aec93ba88f2f0456358016e3"}]}, "handoff_summary": ""}

