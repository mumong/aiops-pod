n- **g1 aiops-case-v10/workload**: pod-crashloop-runtime\n", "answer_source": "workflow", "elapsed_seconds": 92.066, "metrics": {"run_id": "1ead6deb0d10486d", "mttr": {"value": "1.5m", "seconds": 92.07277917861938, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-crashloop-runtime", "pass": true, "score": 0.9333, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.6666666666666666, "weighted_score": 0.1333}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-crashloop-runtime"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 92072.77917861938, "llm_calls": 17, "llm_duration_ms": 69656.99887275696, "tool_calls": 24, "executed_tool_calls": 12, "deduplicated_tool_calls": 11, "successful_tool_calls": 23, "failed_tool_calls": 1, "tool_duration_ms": 26772.75323867798, "tool_wall_duration_ms": 21969.943046569824}, "nodes": {"layer": {"name": "问题定位", "duratio