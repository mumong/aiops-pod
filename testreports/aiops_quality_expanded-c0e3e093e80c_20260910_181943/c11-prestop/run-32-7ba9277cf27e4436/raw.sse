data: {"id": "7ba9277cf27e4436-thinking-parallel_evidence-1978", "run_id": "7ba9277cf27e4436", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_get_by_name", "content": null, "status": "success", "result_preview": "NAME       READY   STATUS        RESTARTS   AGE     IP              NODE    NOMINATED NODE   READINESS GATES   LABELS\nworkload   1/1     Terminating   0          2m19s   172.16.104.16   node2   <none>", "duration_seconds": null, "iteration": 5, "ts_ms": 1789364926928, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v12", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_2d0758e03cac489f930cccee", "tool_sequence": 16, "semantic_success": true, "result": "NAME       READY   STATUS        RESTARTS   AGE     IP              NODE    NOMINATED NODE   READINESS GATES   LABELS\nworkload   1/1     Terminating   0          2m19s   172.16.104.16   node2   <none>           <none>            aiops.lab/case-id=v12,app.kubernetes.io/name=workload", "raw_ref": "/tmp/aiops/reports/context_archives/7ba9277cf27e4436-g1/tools/020-evidence-kubectl_get_by_name.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/7ba9277cf27e4436-g1/tools/020-evidence-kubectl_get_by_name.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/7ba9277cf27e4436-g1/tools/020-evidence-kubectl_get_by_name.summary.txt"}

