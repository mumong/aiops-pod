data: {"id": "7ba9277cf27e4436-thinking-parallel_evidence-1744", "run_id": "7ba9277cf27e4436", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_get_yaml", "content": null, "status": "success", "result_preview": "kubectl_get_yaml 关键字段摘要:\nkind: Pod\nname: workload\nnamespace: aiops-case-v12\ndeletionTimestamp: 2026-09-14T06:51:29Z\ndeletionGracePeriodSeconds: 3900\nfinalizers: <none>\nterminationGracePeriodSeconds: 3", "duration_seconds": null, "iteration": 4, "ts_ms": 1789364921044, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v12", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_1e13de1d93c04760ad742e0c", "tool_sequence": 15, "semantic_success": false, "result": "kubectl_get_yaml 关键字段摘要:\nkind: Pod\nname: workload\nnamespace: aiops-case-v12\ndeletionTimestamp: 2026-09-14T06:51:29Z\ndeletionGracePeriodSeconds: 3900\nfinalizers: <none>\nterminationGracePeriodSeconds: 3900\nphase: Running", "raw_ref": "/tmp/aiops/reports/context_archives/7ba9277cf27e4436-g1/tools/017-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/7ba9277cf27e4436-g1/tools/017-evidence-kubectl_get_yaml.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/7ba9277cf27e4436-g1/tools/017-evidence-kubectl_get_yaml.summary.txt"}

