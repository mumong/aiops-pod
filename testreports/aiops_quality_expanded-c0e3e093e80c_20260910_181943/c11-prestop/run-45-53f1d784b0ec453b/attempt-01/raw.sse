4.7s\n│  └─ g1 aiops-case-v12/workload: 84.7s (Evidence 76.3s, RCA 8.4s)\n└─ 汇总总结: 10.9s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-v12/workload**: pod-terminating-stuck\n", "answer_source": "workflow", "elapsed_seconds": 114.832, "metrics": {"run_id": "53f1d784b0ec453b", "mttr": {"value": "1.9m", "seconds": 114.84020948410034, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "42%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-terminating-stuck", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-terminating-stuck"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 114840.20948410034, "llm_calls": 18, "llm_duration_ms": 90025.62999725342, "tool_calls": 20, "executed_tool_calls": 15, "deduplicated_tool_calls": 5, "successful_tool_calls": 20, "failed_tool_calls": 0, "tool_duration_ms": 6505.3939819335