data: {"id": "d1e94db5e24f45df-node_complete-parallel_evidence", "run_id": "d1e94db5e24f45df", "seq": 1366, "ts_ms": 1789072744554, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 66.625, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-sjvxl"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d1e94db5e24f45df-g1/lane_artifacts/g1/artifact.json", "sha256": "1c3755e332f3d77e7a5f4cd1aa1a7d10c0c50d9bae5db522aa0a7a97a99f8ee9", "bytes": 2450}, "snapshot_sha256": "035d72384b19d7e8a0cd38e7d9a09daa1911a2796fa752b305baf0676c36f2f4"}]}, "handoff_summary": ""}

