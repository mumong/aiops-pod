data: {"id": "bdbbe8009a534308-node_complete-parallel_evidence", "run_id": "bdbbe8009a534308", "seq": 1776, "ts_ms": 1789072647513, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 78.39, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-sjvxl"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/bdbbe8009a534308-g1/lane_artifacts/g1/artifact.json", "sha256": "5268dfa25868909a4c933dcfff94406cc634bfa296e4e5a2e1d42866df3b8bb9", "bytes": 2450}, "snapshot_sha256": "e4581d0fbe352a12b2f142c3554f17f37d3bf21fafde12f749dc090aa9bdc886"}]}, "handoff_summary": ""}

