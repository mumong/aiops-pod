data: {"id": "861623e086dc4f84-thinking-parallel_evidence-338", "run_id": "861623e086dc4f84", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_get_yaml", "content": null, "status": "success", "result_preview": "Pod workload-dff5cbc6b-sjvxl (ns: aiops-case-07) is in phase Running but has not become Ready due to the app container being in CrashLoopBackOff state after 4 restarts (exitCode=78).\nkey_facts: [\"Pod:", "duration_seconds": null, "iteration": 7, "ts_ms": 1789072407029, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-sjvxl"}, "dimension": "kubernetes"}, "tool_call_id": "call_2993280e5e0d4bab827b0272", "tool_sequence": 19, "semantic_success": false, "result": "Pod workload-dff5cbc6b-sjvxl (ns: aiops-case-07) is in phase Running but has not become Ready due to the app container being in CrashLoopBackOff state after 4 restarts (exitCode=78).\nkey_facts: [\"Pod: workload-dff5cbc6b-sjvxl, Namespace: aiops-case-07, Node: node2\", \"Container: app, Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Container Status: ready=False, restarts=4, reason=CrashLoopBackOff, exitCode=78\", \"Pod Conditions: Initialized=True, Ready=False (ContainersNotReady), ContainersReady=False\", \"Events: back-off 1m20s restarting failed container=app\", \"Command: python3 /opt/aiops/server.py\", \"Volume: code (configMap: workload-code)\"]\nconflicts: [\"current_summary omitted creationTimestamp, serviceAccountName, nodeName, labels, ownerReferences, and volume details which are present in raw_preview.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/861623e086dc4f84-g1/tools/022-evidence-kubectl_get_yaml.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/861623e086dc4f84-g1/tools/022-evidence-kubectl_get_yaml.structured.json", "summar