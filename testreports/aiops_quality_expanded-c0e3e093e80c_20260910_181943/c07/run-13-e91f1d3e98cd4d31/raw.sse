14.6s\n├─ 并发证据采集: 55.2s\n│  └─ g1 aiops-case-07/workload-dff5cbc6b-sjvxl: 55.2s (Evidence 44.4s, RCA 10.6s)\n└─ 汇总总结: 10.9s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-07/workload-dff5cbc6b-sjvxl**: pod-crashloop-runtime\n", "answer_source": "workflow", "elapsed_seconds": 80.715, "metrics": {"run_id": "e91f1d3e98cd4d31", "mttr": {"value": "1.3m", "seconds": 80.72205471992493, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "42%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-crashloop-runtime", "pass": true, "score": 0.9333, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.6666666666666666, "weighted_score": 0.1333}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-crashloop-runtime"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 80722.05471992493, "llm_calls": 10, "llm_duration_ms": 61287.29009628296, "tool_calls": 10, "executed_tool_calls": 10, "deduplicated_tool_calls": 0, "successful_tool_cal