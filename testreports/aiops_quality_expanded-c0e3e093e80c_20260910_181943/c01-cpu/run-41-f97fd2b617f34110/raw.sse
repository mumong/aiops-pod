data: {"id": "f97fd2b617f34110-thinking-parallel_evidence-354", "run_id": "f97fd2b617f34110", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v01\nnode: <none>\nstatus: Pending\n关键诊断行:\n  Warning  FailedScheduling  5m12s (x12 over 60m)  default-scheduler  0/3 nodes are available: 3 Insuf", "duration_seconds": null, "iteration": 1, "ts_ms": 1789108428454, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v01", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_de1acf2054be4af5b46da846", "tool_sequence": 1, "semantic_success": true, "result": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v01\nnode: <none>\nstatus: Pending\n关键诊断行:\n  Warning  FailedScheduling  5m12s (x12 over 60m)  default-scheduler  0/3 nodes are available: 3 Insufficient cpu. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\nPod 关键区块:\nQoS Class: Burstable\nNode-Selectors: <none>\nTolerations: node.kubernetes.io/not-ready:NoExecute op=Exists for 300s\nContainers:\n  app:\n    Image:      xnet.registry.io:8443/observability/python:3-alpine\n    Command:\n      python3\n      -u\n      -c\n      import time; print('application started', flush=True); time.sleep(86400)\n    Limits:\n      cpu:     100k\n      memory:  32Mi\n    Requests:\n      memory:     8Mi\n    Environment:  <none>\n    Mounts:       <none>\nEvents:\n  Warning  FailedScheduling  5m12s (x12 over 60m)  default-scheduler  0/3 nodes are available: 3 Insufficient cpu. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/f97fd2b617f34110-g1/tools/004-evidence-kube