data: {"id": "3bf889154400412e-node_complete-parallel_evidence", "run_id": "3bf889154400412e", "seq": 1239, "ts_ms": 1789106810450, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 24.439, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v01", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/3bf889154400412e-g1/lane_artifacts/g1/artifact.json", "sha256": "84b80d1a3f068074a23c7fe9249619a25f0e55e26b8f9f4eb34d8ddb729dd538", "bytes": 2568}, "snapshot_sha256": "6ede504781b4ec5523992f227e9966fb0e217b35d9bd2e6895d90e50293187b9"}]}, "handoff_summary": ""}

