": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-pending-unschedulable", "pass": true, "score": 0.9333, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.6666666666666666, "weighted_score": 0.1333}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-pending-unschedulable"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 61319.49734687805, "llm_calls": 14, "llm_duration_ms": 58296.011447906494, "tool_calls": 13, "executed_tool_calls": 11, "deduplicated_tool_calls": 1, "successful_tool_calls": 9, "failed_tool_calls": 4, "tool_duration_ms": 5967.15235710144, "tool_wall_duration_ms": 2698.5554695129395}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 14066.145181655884, "success": true}, "parallel_evidence": {"name": "并发证据采集", "duration_ms": 39908.41245651245, "success": true}, "evidence": {"name": "evidence", "duration_ms": 0.0, "success": true}, "rca": {"name": "rca", "duration_ms": 0.0, "success": true}, "conclusion": {"name": "汇总总结", "duration_ms": 7320.703029632568, "success": true}}, "success": true, "errors": []}}

