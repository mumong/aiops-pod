data: {"id": "2619d4429bae40b5-node_complete-parallel_evidence", "run_id": "2619d4429bae40b5", "seq": 2320, "ts_ms": 1789106172497, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 30.219, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v01", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2619d4429bae40b5-g1/lane_artifacts/g1/artifact.json", "sha256": "ba68408136b6e1233ebe9bf40256d1d999545e518fa56989ae2a4b2d886ecadb", "bytes": 2419}, "snapshot_sha256": "a2af73058928cf11cc8f2fe0b5344e6f5f8def1ceb7b03e3ce20c0280fa35dc8"}]}, "handoff_summary": ""}

