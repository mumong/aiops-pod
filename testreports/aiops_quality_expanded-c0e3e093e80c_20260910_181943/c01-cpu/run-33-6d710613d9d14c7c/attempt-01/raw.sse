data: {"id": "6d710613d9d14c7c-node_complete-parallel_evidence", "run_id": "6d710613d9d14c7c", "seq": 1454, "ts_ms": 1789107405224, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 48.478, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v01", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/6d710613d9d14c7c-g1/lane_artifacts/g1/artifact.json", "sha256": "709304dcce231969031c34a0986b93595325d4bcbaa88ce18fb1c672186df2db", "bytes": 2419}, "snapshot_sha256": "0df9dc42e5431e58300c0298bb4e5e33c935cb51cabd1a4f926d370f4326af81"}]}, "handoff_summary": ""}

