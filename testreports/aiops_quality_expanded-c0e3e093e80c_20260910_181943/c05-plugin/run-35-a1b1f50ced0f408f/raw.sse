data: {"id": "a1b1f50ced0f408f-node_complete-parallel_evidence", "run_id": "a1b1f50ced0f408f", "seq": 3526, "ts_ms": 1789376727277, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 36.83, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v14", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/a1b1f50ced0f408f-g1/lane_artifacts/g1/artifact.json", "sha256": "635167d9d07b86440a2a1675e7971f15d2308097214311ddc079d7500f7ca905", "bytes": 2420}, "snapshot_sha256": "ac4ae64dd1f7c1a0029b7744604df7dd04a65fb963c7e284102ac06760905815"}]}, "handoff_summary": ""}

