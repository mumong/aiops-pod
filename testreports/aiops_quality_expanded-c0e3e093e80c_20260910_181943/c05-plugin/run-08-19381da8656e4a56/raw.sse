y\": \"中\", \"reason\": \"如果 Pod 定义了 PVC、ConfigMap 或 Secret 类型的 Volume 且资源不存在或未绑定，kubelet 会在挂载阶段阻塞。\"}, {\"scenario\": \"沙箱创建失败 (CNI/Runtime)\", \"probability\": \"中\", \"reason\": \"如果 CNI 插件配置错误、IP 池耗尽或容器运行时异常，kubelet 无法创建 Pod Sandbox。\"}], \"abnormal_groups\": [{\"group_id\": \"g1\", \"status_keywords\": [\"ContainerCreating\"], \"pod_abnormal_type\": \"ContainerCreating\", \"compatible_layers\": [], \"entities\": [{\"kind\": \"Pod\", \"namespace\": \"aiops-case-v14\", \"name\": \"workload\"}], \"evidence_plan\": [], \"possible_scenarios\": [{\"scenario\": \"ContainerCreating 的直接原因待验证\", \"probability\": \"未知\", \"reason\": \"当前阶段只定位异常；根因必须由后续实时 canonical facts 确认\"}], \"matched_runbooks\": [\"pod-imagepull-failed.md\", \"pod-volume-mount-failed.md\", \"pod-pending-unschedulable.md\", \"pod-sandbox-create-failed.md\"]}], \"issue_groups\": [{\"group_id\": \"g1\", \"status_keywords\": [\"ContainerCreating\"], \"pod_abnormal_type\": \"ContainerCreating\", \"compatible_layers\": [], \"entities\": [{\"kind\": \"Pod\", \"namespace\": \"aiops-case-v14\", \"name\": \"workload\"}], \"evidence_plan\": [], \"possible_scenarios\": [{\"scenario\": \"ContainerCreating 的直接原因待验证\", \"probability\": \"未知\", \"reason\": \"当前阶段只定位异常；根因必须由后续实时 canonical facts 确认\"}], \"matched_runbooks\": [\"pod-imagepull-failed.md\", \"pod-volume-mount-failed.md\", \"pod-pending-unschedulable.md\", \"pod-sandbox-create-failed.md\"]}], \"current_abnormal_summary\": {\"source\": \"kubectl_get_by_name\", \"status_counts\": {\"ContainerCreating\": 1}, \"total_abnormal\": 1, \"selected_rows\": [\"workload   0/1     ContainerCreating   0          8m21s   <none>   node2   <none>           <none>            aiops.lab/case-id=v14,app.kubernetes.io/name=workload\"], \"raw_ref\": \"/tmp/aiops/reports/context_archives/19381da8656e4a56/tools/008-layer-kubectl_get_by_name.raw.txt\", \"summary_ref\": \"/tmp/aiops/reports/context_archives/19381da8656e4a56/tools/008-layer-kubectl_get_by_name.summary.txt\", \"struct