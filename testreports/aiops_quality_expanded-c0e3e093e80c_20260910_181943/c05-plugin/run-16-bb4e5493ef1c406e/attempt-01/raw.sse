data: {"id": "bb4e5493ef1c406e-node_complete-parallel_evidence", "run_id": "bb4e5493ef1c406e", "seq": 1501, "ts_ms": 1789374724844, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 36.133, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v14", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/bb4e5493ef1c406e-g1/lane_artifacts/g1/artifact.json", "sha256": "d9f5a495240d4189d754f8fc28c65a1f3e78a652a5309c471889469968f166e8", "bytes": 2420}, "snapshot_sha256": "6cd8cd3677ecf1e0febb4ea3ecf8383af7c114f56f77de28f26484c5682bf710"}]}, "handoff_summary": ""}

