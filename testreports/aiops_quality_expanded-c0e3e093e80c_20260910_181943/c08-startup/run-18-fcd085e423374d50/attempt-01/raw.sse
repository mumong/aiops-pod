.0m\n├─ 问题定位: 27.3s\n├─ 并发证据采集: 82.2s\n│  └─ g1 aiops-case-v15/workload: 82.2s (Evidence 73.2s, RCA 8.8s)\n└─ 汇总总结: 11.5s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-v15/workload**: pod-crashloop-runtime, pod-oomkilled\n", "answer_source": "workflow", "elapsed_seconds": 121.007, "metrics": {"run_id": "fcd085e423374d50", "mttr": {"value": "2.0m", "seconds": 121.00801396369934, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "54%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-oomkilled, pod-crashloop-runtime", "pass": true, "score": 0.85, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.3, "weighted_score": 0.09}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.3, "weighted_score": 0.06}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.8, "weighted_score": 0.12, "description": "Runbook 匹配质量", "detail": "已匹配（未识别核心）"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.95, "weighted_score": 0.19, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 95%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 121008.01396369934, "llm_calls": 12, "llm_duration_ms": 94236.41419410706, "tool_calls": 16, "executed_tool_calls": 15, "deduplicated_tool_calls": 1, "successful_tool_calls": 16, "failed