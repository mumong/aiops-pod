├─ 问题定位: 21.0s\n├─ 并发证据采集: 69.6s\n│  └─ g1 aiops-case-v15/workload: 69.6s (Evidence 63.2s, RCA 6.1s)\n└─ 汇总总结: 11.8s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-v15/workload**: pod-oomkilled, pod-crashloop-runtime\n", "answer_source": "workflow", "elapsed_seconds": 102.316, "metrics": {"run_id": "70a518d2e1be4691", "mttr": {"value": "1.7m", "seconds": 102.3184187412262, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "39%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-oomkilled, pod-crashloop-runtime", "pass": true, "score": 0.85, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.3, "weighted_score": 0.09}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.3, "weighted_score": 0.06}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.8, "weighted_score": 0.12, "description": "Runbook 匹配质量", "detail": "已匹配（未识别核心）"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 102318.4187412262, "llm_calls": 10, "llm_duration_ms": 97438.51208686829, "tool_calls": 15, "executed_tool_calls": 15, "deduplicated_tool_calls": 0, "successful_tool_calls": 12, "failed_tool_ca