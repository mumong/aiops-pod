data: {"id": "79b3cac9a7fe478e-node_complete-parallel_evidence", "run_id": "79b3cac9a7fe478e", "seq": 1159, "ts_ms": 1789385053533, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.058, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v15", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/79b3cac9a7fe478e-g1/lane_artifacts/g1/artifact.json", "sha256": "417b714b005466e886ff035aa85bcc87a130fd8525ec1bf7bbcab7d80bd5b1c5", "bytes": 2420}, "snapshot_sha256": "7f5c8de05cdca6a2b59973c7f6c648d32d5260ccbec0d0821b89b7caa70cac35"}]}, "handoff_summary": ""}

