data: {"id": "723245028bfd49a7-node_complete-parallel_evidence", "run_id": "723245028bfd49a7", "seq": 604, "ts_ms": 1789119955527, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 26.947, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/723245028bfd49a7-g1/lane_artifacts/g1/artifact.json", "sha256": "e34efc4a1d9ba05b479ccf4f421670f6e2aa17db1f27d1ee5eb27a18cc7f994b", "bytes": 2569}, "snapshot_sha256": "2175d6366700681141739f90689a1f55372853a765e7d31522308ab956512b87"}]}, "handoff_summary": ""}

