data: {"id": "aff56ad0a7dd4334-node_complete-parallel_evidence", "run_id": "aff56ad0a7dd4334", "seq": 719, "ts_ms": 1789119727452, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 43.36, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/aff56ad0a7dd4334-g1/lane_artifacts/g1/artifact.json", "sha256": "62100e573c81367b91b28a6a0b2da5b6e2463153612d4faf6672a7366039c8ac", "bytes": 2420}, "snapshot_sha256": "ffe4b74fe0546c7660e161eb11619004e0a1698039607599eb94b5441433138b"}]}, "handoff_summary": ""}

