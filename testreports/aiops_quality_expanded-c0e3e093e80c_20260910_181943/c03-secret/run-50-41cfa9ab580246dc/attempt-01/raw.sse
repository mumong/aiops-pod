data: {"id": "41cfa9ab580246dc-node_complete-parallel_evidence", "run_id": "41cfa9ab580246dc", "seq": 913, "ts_ms": 1789121605839, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 37.284, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/41cfa9ab580246dc-g1/lane_artifacts/g1/artifact.json", "sha256": "9ae711a5cd577eb119c0f353581fbf7962c254f68e54d264e1211fa3d02db8a9", "bytes": 2420}, "snapshot_sha256": "2d45d62416b9a98ecfd3947035cb61fed2370831d634fbaed5caeb3013ba3c1f"}]}, "handoff_summary": ""}

