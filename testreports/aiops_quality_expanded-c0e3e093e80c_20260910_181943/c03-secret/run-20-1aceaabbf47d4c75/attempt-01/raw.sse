 未调用 Runbook\n", "answer_source": "workflow", "elapsed_seconds": 88.365, "metrics": {"run_id": "1aceaabbf47d4c75", "mttr": {"value": "1.5m", "seconds": 88.37106156349182, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "40%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": false, "runbook_id": null, "pass": false, "score": 0.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 0.0, "weighted_score": 0.0}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.0, "weighted_score": 0.0}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.0, "weighted_score": 0.0}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.3, "weighted_score": 0.045, "description": "Runbook 匹配质量", "detail": "未匹配"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.95, "weighted_score": 0.19, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 95%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 88371.06156349182, "llm_calls": 11, "llm_duration_ms": 81537.46747970581, "tool_calls": 11, "executed_tool_calls": 10, "deduplicated_tool_calls": 1, "successful_tool_calls": 10, "failed_tool_calls": 1, "tool_duration_ms": 18865.60106277466, "tool_wall_duration_ms": 6393.354892730713}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 43369.54975128174, "success": true}, "parallel_evidence": {"name": "并发证据采集", "duration_ms": 362