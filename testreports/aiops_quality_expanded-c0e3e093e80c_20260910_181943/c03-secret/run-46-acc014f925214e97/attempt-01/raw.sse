data: {"id": "acc014f925214e97-node_complete-parallel_evidence", "run_id": "acc014f925214e97", "seq": 1136, "ts_ms": 1789121350089, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 30.031, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/acc014f925214e97-g1/lane_artifacts/g1/artifact.json", "sha256": "8c7075b043c256931af32251c929cbe9227501564a4151d2e69ae388b6101746", "bytes": 2419}, "snapshot_sha256": "784bb0fc802e5dda7dcc9bdd60e18e94ded66ee31e6167e0b703cc42bc7e9474"}]}, "handoff_summary": ""}

