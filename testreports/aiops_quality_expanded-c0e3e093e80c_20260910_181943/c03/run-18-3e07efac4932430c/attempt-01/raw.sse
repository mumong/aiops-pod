data: {"id": "3e07efac4932430c-node_complete-parallel_evidence", "run_id": "3e07efac4932430c", "seq": 1336, "ts_ms": 1789048409622, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 38.293, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-xn974"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/3e07efac4932430c-g1/lane_artifacts/g1/artifact.json", "sha256": "cb2de8bcc4b6688dafa5b933249a9ac2ac4cc03a81bf14b006a9a555a6b5a1ff", "bytes": 2451}, "snapshot_sha256": "819d1b1c8711fe4abda8772c7b6bc230b0a80ae10d2abdef2fb0dc4920b8c9e8"}]}, "handoff_summary": ""}

