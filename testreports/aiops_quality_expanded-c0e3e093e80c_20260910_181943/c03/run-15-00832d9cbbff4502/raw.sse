data: {"id": "00832d9cbbff4502-node_complete-parallel_evidence", "run_id": "00832d9cbbff4502", "seq": 815, "ts_ms": 1789048232095, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.882, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-xn974"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/00832d9cbbff4502-g1/lane_artifacts/g1/artifact.json", "sha256": "ea19ad9e400f7e1292fdc3f0c3390acbb3a9337e615fbdda43e3b0186af61bd3", "bytes": 2452}, "snapshot_sha256": "513df52187d0193ceb49ae9ad0c1513a15716f0f3d89bd8d7489b7dba97353c1"}]}, "handoff_summary": ""}

