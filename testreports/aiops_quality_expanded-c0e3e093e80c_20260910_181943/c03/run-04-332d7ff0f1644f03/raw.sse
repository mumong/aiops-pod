data: {"id": "332d7ff0f1644f03-node_complete-parallel_evidence", "run_id": "332d7ff0f1644f03", "seq": 931, "ts_ms": 1789045344628, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 35.557, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-xn974"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/332d7ff0f1644f03-g1/lane_artifacts/g1/artifact.json", "sha256": "7d9bc5cdca8ea10f92de5fa37775e626b3882de9f23eec151ff1727291a95d7a", "bytes": 2452}, "snapshot_sha256": "ee827fc29d0c7907becf47313fbf6289e8734aa65a845432fff353628d94ec1f"}]}, "handoff_summary": ""}

