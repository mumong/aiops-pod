l-failed, pod-volume-mount-failed, pod-config-error\n", "answer_source": "workflow", "elapsed_seconds": 90.548, "metrics": {"run_id": "e2ca3d8fc40f43ce", "mttr": {"value": "1.5m", "seconds": 90.55153346061707, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "47%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-config-error, pod-imagepull-failed, pod-volume-mount-failed", "pass": true, "score": 0.85, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 0.3, "weighted_score": 0.09}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 0.3, "weighted_score": 0.06}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 0.8, "weighted_score": 0.12, "description": "Runbook 匹配质量", "detail": "已匹配（未识别核心）"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.9, "weighted_score": 0.18, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 90%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 90551.53346061707, "llm_calls": 11, "llm_duration_ms": 88245.96905708313, "tool_calls": 11, "executed_tool_calls": 9, "deduplicated_tool_calls": 2, "successful_tool_calls": 11, "failed_tool_calls": 0, "tool_duration_ms": 4820.18256187439, "tool_wall_duration_ms": 1968.6203002929688}, "nodes": {"layer": {"name": "问题定位", "dura