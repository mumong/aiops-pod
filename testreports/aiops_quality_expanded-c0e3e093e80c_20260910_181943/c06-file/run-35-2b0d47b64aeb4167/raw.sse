data: {"id": "2b0d47b64aeb4167-node_complete-parallel_evidence", "run_id": "2b0d47b64aeb4167", "seq": 1245, "ts_ms": 1789138782632, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 34.367, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v09", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2b0d47b64aeb4167-g1/lane_artifacts/g1/artifact.json", "sha256": "2bfc7ef7afac8260cad86ed1b65aca928af7559c863f6a278334c4ef49cff0a5", "bytes": 2420}, "snapshot_sha256": "afded93f89a82a3cd71f8f86b077769611c7e79847dcad71f944f56a003812ce"}]}, "handoff_summary": ""}

