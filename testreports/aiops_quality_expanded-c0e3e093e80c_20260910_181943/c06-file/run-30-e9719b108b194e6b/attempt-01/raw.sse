data: {"id": "e9719b108b194e6b-node_complete-parallel_evidence", "run_id": "e9719b108b194e6b", "seq": 1316, "ts_ms": 1789138398764, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 44.746, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v09", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e9719b108b194e6b-g1/lane_artifacts/g1/artifact.json", "sha256": "84ec28cae946c67acca5cc4880f45c350534a79d74a6b1c61b22fda70d4066d3", "bytes": 2420}, "snapshot_sha256": "76a710b7701593b3d904ddb900b9a4b8128f55e625a1e5b53b495da74a750547"}]}, "handoff_summary": ""}

