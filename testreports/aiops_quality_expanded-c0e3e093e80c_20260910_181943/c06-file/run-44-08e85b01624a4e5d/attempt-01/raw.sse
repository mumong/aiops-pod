data: {"id": "08e85b01624a4e5d-node_complete-parallel_evidence", "run_id": "08e85b01624a4e5d", "seq": 1405, "ts_ms": 1789139446999, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.266, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v09", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/08e85b01624a4e5d-g1/lane_artifacts/g1/artifact.json", "sha256": "73fe7435a54733ccd1e565e47ea11782727a5e94e5f8c19a96daa277a9e0a815", "bytes": 2420}, "snapshot_sha256": "4367d4ee4eaf43e201da02b13a445c8fa925cdc586984a1ac0360be4eea14abf"}]}, "handoff_summary": ""}

