data: {"id": "3d3b6f7a47b04d10-node_complete-parallel_evidence", "run_id": "3d3b6f7a47b04d10", "seq": 1997, "ts_ms": 1789136053756, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 54.305, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v09", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/3d3b6f7a47b04d10-g1/lane_artifacts/g1/artifact.json", "sha256": "f50bb98c198baa9e12596d53fd5a3c9286f331c5b339d5d1c252fbaf73932e72", "bytes": 2420}, "snapshot_sha256": "e439284fc986996f3329f0fdb6dcbc8dbf9032e10f93cf851cad5054c7c61a62"}]}, "handoff_summary": ""}

