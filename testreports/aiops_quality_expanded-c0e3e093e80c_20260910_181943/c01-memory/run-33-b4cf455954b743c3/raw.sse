data: {"id": "b4cf455954b743c3-node_complete-parallel_evidence", "run_id": "b4cf455954b743c3", "seq": 986, "ts_ms": 1789112125565, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 30.388, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/b4cf455954b743c3-g1/lane_artifacts/g1/artifact.json", "sha256": "ec46ec049bd14ddde8176845cdcf4ebe38f0d3f391fc40b147c5a921ba135907", "bytes": 2419}, "snapshot_sha256": "731458ca0f621f257cb0d7dd9673f3b03b57ff10b495d25970433c68021f0ef2"}]}, "handoff_summary": ""}

