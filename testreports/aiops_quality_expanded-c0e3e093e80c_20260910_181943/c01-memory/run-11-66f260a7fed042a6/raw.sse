data: {"id": "66f260a7fed042a6-thinking-parallel_evidence-2390", "run_id": "66f260a7fed042a6", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "run_bash_command", "content": null, "status": "success", "result_preview": "{\"success\": true, \"stdout\": \"NAME     STATUS   ROLES           AGE    VERSION   INTERNAL-IP   EXTERNAL-IP   OS-IMAGE             KERNEL-VERSION       CONTAINER-RUNTIME\\nmaster   Ready    control-plane", "duration_seconds": null, "iteration": 8, "ts_ms": 1789110436742, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "other"}, "tool_call_id": "call_93abac7222d44cd299d51e7f", "tool_sequence": 8, "semantic_success": true, "result": "{\"success\": true, \"stdout\": \"NAME     STATUS   ROLES           AGE    VERSION   INTERNAL-IP   EXTERNAL-IP   OS-IMAGE             KERNEL-VERSION       CONTAINER-RUNTIME\\nmaster   Ready    control-plane   351d   v1.26.8   10.2.0.48     <none>        Ubuntu 22.04.4 LTS   5.15.0-173-generic   containerd://1.6.32\\nnode1    Ready    <none>          351d   v1.26.8   10.2.0.49     <none>        Ubuntu 22.04.4 LTS   5.15.0-186-generic   containerd://1.6.32\\nnode2    Ready    <none>          23d    v1.26.8   10.2.0.50     <none>        Ubuntu 22.04.4 LTS   5.15.0-140-generic   containerd://1.6.32\\n\", \"stderr\": \"\", \"returncode\": 0}", "raw_ref": "/tmp/aiops/reports/context_archives/66f260a7fed042a6-g1/tools/020-evidence-run_bash_command.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/66f260a7fed042a6-g1/tools/020-evidence-run_bash_command.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/66f260a7fed042a6-g1/tools/020-evidence-run_bash_command.summary.txt"}

