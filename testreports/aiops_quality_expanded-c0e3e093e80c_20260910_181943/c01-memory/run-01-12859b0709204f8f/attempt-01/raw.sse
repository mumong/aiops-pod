data: {"id": "12859b0709204f8f-node_complete-parallel_evidence", "run_id": "12859b0709204f8f", "seq": 2554, "ts_ms": 1789109204683, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 32.667, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/12859b0709204f8f-g1/lane_artifacts/g1/artifact.json", "sha256": "116237513960e6653fb2a7f8d5e8330a010587a1ed1ce95e6b1395246db6fb51", "bytes": 2569}, "snapshot_sha256": "1a43aed98ddba353872cc3de65d41be688da2c7a274495b7f0ce80e78f177f8a"}]}, "handoff_summary": ""}

