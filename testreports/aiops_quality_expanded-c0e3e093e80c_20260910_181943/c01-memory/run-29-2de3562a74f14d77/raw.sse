data: {"id": "2de3562a74f14d77-node_complete-parallel_evidence", "run_id": "2de3562a74f14d77", "seq": 1450, "ts_ms": 1789111839224, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 32.101, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/2de3562a74f14d77-g1/lane_artifacts/g1/artifact.json", "sha256": "d149dd10b9ebcab1a67aed86cd455224dfd076e0faae32c90919f45d4cbd1fd3", "bytes": 2418}, "snapshot_sha256": "068d48f48059e8ad40d4c87c03bf106fae1a3e6f197e13c6425313fdc8a933a6"}]}, "handoff_summary": ""}

