data: {"id": "b1dba8d300bb4af5-thinking-layer-121", "run_id": "b1dba8d300bb4af5", "node": "layer", "node_name": "问题定位", "thinking_type": "tool_start", "tool_name": "fetch_runbook", "content": null, "status": null, "result_preview": null, "duration_seconds": null, "iteration": 2, "ts_ms": 1789111213589}

