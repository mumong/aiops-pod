data: {"id": "ca59df1512334a38-thinking-parallel_evidence-713", "run_id": "ca59df1512334a38", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\n关键诊断行:\n  Warning  FailedScheduling  41m                default-scheduler  0/3 nodes are available: 3 Insufficient memory. preemption: 0/3 nodes are available: 3 No preemption vict", "duration_seconds": null, "iteration": 10, "ts_ms": 1789111604979, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_19bd691ab0ac41e9a1c7bbf3", "tool_sequence": 10, "semantic_success": true, "result": "kubectl_describe 摘要:\n关键诊断行:\n  Warning  FailedScheduling  41m                default-scheduler  0/3 nodes are available: 3 Insufficient memory. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n  Warning  FailedScheduling  30m (x2 over 35m)  default-scheduler  0/3 nodes are available: 3 Insufficient memory. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\nPod 关键区块:\nQoS Class: Burstable\nNode-Selectors: <none>\nTolerations: node.kubernetes.io/not-ready:NoExecute op=Exists for 300s\nContainers:\n  app:\n    Image:      xnet.registry.io:8443/observability/python:3-alpine\n    Command:\n      python3\n      -u\n      -c\n      import time; print('application started', flush=True); time.sleep(86400)\n    Limits:\n      cpu:     50m\n      memory:  1Pi\n    Requests:\n      cpu:        5m\n    Environment:  <none>\n    Mounts:       <none>\nEvents:\n  Warning  FailedScheduling  41m                default-scheduler  0/3 nodes are available: 3 Insufficient memory. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n  Warning  FailedScheduling  30m (x2 over 35m)  default-scheduler  0/3 nodes are available: 3 Insufficient memory. preemption: 0/3 nodes are available: 3 No preemption victims found for incoming pod..\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/ca59df1512334a38-g1/tools/013-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/ca59df1512334a38-g1/tools/013-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/ca59df1512334a38-g1/tools/013-evidence-kubectl_describe.summary.txt"}

