data: {"id": "00295e65bd6b49e3-node_complete-parallel_evidence", "run_id": "00295e65bd6b49e3", "seq": 1477, "ts_ms": 1789111993863, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 31.15, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/00295e65bd6b49e3-g1/lane_artifacts/g1/artifact.json", "sha256": "9862556f60bd3bec9eaf076b66fc5cf3f713c6687dfda94518aa68638807fc1f", "bytes": 2569}, "snapshot_sha256": "3ac602570ce2711f283ef82ecf5317782142fcdca4dda24fc76078da9a267fc8"}]}, "handoff_summary": ""}

