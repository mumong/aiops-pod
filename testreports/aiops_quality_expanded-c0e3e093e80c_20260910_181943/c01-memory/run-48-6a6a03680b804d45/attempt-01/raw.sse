data: {"id": "6a6a03680b804d45-node_complete-parallel_evidence", "run_id": "6a6a03680b804d45", "seq": 699, "ts_ms": 1789113600032, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 27.697, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/6a6a03680b804d45-g1/lane_artifacts/g1/artifact.json", "sha256": "fb52c94dcc73caa287fb1d70a605bb63e76d527fcf176b3e19b593340bfc1f2a", "bytes": 2569}, "snapshot_sha256": "3ca13b30efd61238a670344268617671ed6d29d9d607fcf3558a40a8dc5c4479"}]}, "handoff_summary": ""}

