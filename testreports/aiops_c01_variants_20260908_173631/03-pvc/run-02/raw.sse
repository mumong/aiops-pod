data: {"id": "e03e6b6b46444c00-node_complete-parallel_evidence", "run_id": "e03e6b6b46444c00", "seq": 618, "ts_ms": 1788860738090, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 31.386, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v03", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e03e6b6b46444c00-g1/lane_artifacts/g1/artifact.json", "sha256": "c840cb3b268b69fe8d7bc8a1242575e973e4872d1fdc3f6164fbfd89535d04a0", "bytes": 2419}, "snapshot_sha256": "60b62d289a939059be621ff47fd26ebbd5ff51c489ea05bee6d9763304bf4f58"}]}, "handoff_summary": ""}

