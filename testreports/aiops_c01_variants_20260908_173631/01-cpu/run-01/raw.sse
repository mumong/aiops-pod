event: node_complete
data: {"id": "975be492d402435e-node_complete-layer", "run_id": "975be492d402435e", "seq": 17, "ts_ms": 1788860323107, "node": "layer", "node_name": "问题定位", "duration_seconds": 34.707, "state_snapshot": {"layer": "Layer.ABNORMAL", "layers": ["ABNORMAL"], "layer_confidence": 0.5, "layer_reasoning": "当前集群存在两类活跃异常对象。第一类是 Pod 调度异常：aiops-case-v01 命名空间下的 `workload` Pod 处于 Pending 状态，根据 runbook 提示，这通常由 FailedScheduling 导致，属于典型的调度约束或资源不足问题。第二类是存储绑定异常：monitor 命名空间下有 8 个 PersistentVolumeClaim (PVC) 长期处于 Pending 状态（137天），包括 observability-byconity 系列和 log-observability-byconity 系列，这表明底层存储供给失败或 PVC 未正确绑定。虽然 PVC 状态也导致其关联的 Pod (如 byconity server/tso/worker) 可能无法运行，但 PVC Pending 本身即为明确的异常状态。结合 `kubectl_get_by_kind_in_cluster` 显示有 8 个异常项，且均为当前活跃状态，故判定集群异常。", "layer_analysis": "{\"layer\": \"DIAGNOSIS\", \"derived_layer\": \"\", \"layers\": [], \"layer_name\": \"\", \"confidence\": 0.5, \"reasoning\": \"当前集群存在两类活跃异常对象。第一类是 Pod 调度异常：aiops-case-v01 命名空间下的 `workload` Pod 处于 Pending 状态，根据 runbook 提示，这通常由 FailedScheduling 导致，属于典型的调度约束或资源不足问题。第二类是存储绑定异常：monitor 命名空间下有 8 个 PersistentVolumeClaim (PVC) 长期处于 Pending 状态（137天），包括 observability-byconity 系列和 log-observability-byconity 系列，这表明底层存储供给失败或 PVC 未正确绑定。虽然 PVC 状态也导致其关联的 Pod (如 byconity server/tso/worker) 可能无法运行，但 PVC Pending 本身即为明确的异常状态。结合 `kubectl_get_by_kind_in_cluster` 显示有 8 个异常项，且均为当前活跃状态，故判定集群异常。\", \"abnormal_pods\": [{\"name\": \"workload\", \"namespace\": \"aiops-case-v01\", \"status\": \"Pending\"}], \"pod_status_keyword\": \"Pending\", \"pod_abnormal_type\": \"scheduling_failure\", \"status_category\": \"ABNORMAL\", \"key_entities\": [{\"type\": \"Pod\", \"name\": \"workload\", \"namespace\": \"aiops-case-v01\"}, {\"type\": \"PVC\", \"name\": \"local-disk-observability-byconity-server-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"local-disk-observability-byconity-tso-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"local-disk-observability-byconity-vw-vw-default-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"local-disk-observability-byconity-vw-vw-write-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"log-observability-byconity-server-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"log-observability-byconity-tso-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"log-observability-byconity-vw-vw-default-0\", \"namespace\": \"monitor\"}, {\"type\": \"PVC\", \"name\": \"log-observability-byconity-vw-vw-write-0\", \"namespace\": \"monitor\"}], \"possible_scenarios\": [{\"scenario\": \"Pod 调度失败 (FailedScheduling)\", \"probability\": \"高\", \"reason\": \"aiops-case-v01/workload Pod 处于 Pending 状态，无 IP 和 Node，符合调度器未能分配节点的典型特征。需进一步检查 Events 确认是因资源不足、Taint/Toleration 不匹配还是 Affinity 不匹配。\"}, {\"scenario\": \"PVC 绑定失败/存储供给故障\", \"probability\": \"高\", \"reason\": \"monitor 命名空间下 8 个 PVC 长期处于 Pending 状态（137天），表明 Volume 无法动态配置或静态卷不可用，导致依赖这些 PVC 的 Pod 无法正常启动或处于 Pending。\"}], \"abnormal_groups\": [{\"group_id\": \"g1\", \"status_keywords\": [\"Pending\"], \"pod_abnormal_type\": \"PendingUnschedulable\", \"compatible_layers\": [], \"entities\": [{\"kind\": \"Pod\", \"namespace\": \"aiops-case-v01\", \"name\": \"workload\"}], \"evidence_plan\": [], \"possible_scenarios\": [{\"scenario\": \"PendingUnschedulable 的直接原因待验证\", \"probability\": \"未知\", \"reason\": \"当前阶段只定位异常；根因必须由后续实时 canonical facts 确认\"}], \"matched_runbooks\": [\"pod-pending-unschedulable.md\"]}], \"issue_groups\": [{\"group_id\": \"g1\", \"status_keywords\": [\"Pending\"], \"pod_abnormal_type\": \"PendingUnschedulable\", \"compatible_layers\": [], \"entities\": [{\"kind\": \"Pod\", \"namespace\": \"aiops-case-v01\", \"name\": \"workload\"}], \"evidence_plan\": [], \"possible_scenarios\": [{\"scenario\": \"PendingUnschedulable 的直接原因待验证\", \"probability\": \"未知\", \"reason\": \"当前阶段只定位异常；根因必须由后续实时 canonical facts 确认\"}], \"matched_runbooks\": [\"pod-pending-unschedulable.md\"]}], \"current_abnormal_summary\": {\"source\": \"kubectl_get_by_nam