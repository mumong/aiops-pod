data: {"id": "0dd8a8c14ebc4dd8-node_complete-parallel_evidence", "run_id": "0dd8a8c14ebc4dd8", "seq": 1322, "ts_ms": 1788425410558, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 48.902, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-wvcb2"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0dd8a8c14ebc4dd8-g1/lane_artifacts/g1/artifact.json", "sha256": "5bf2d514434593c95c99bf8223bca8b800900e0fe725c6e412ed9d7bf3645b3b", "bytes": 2452}, "snapshot_sha256": "7226a19f69815b3cb6e9220d0fe4ab25b83ea4cc71085c586cb4b6c6ff99423d"}]}, "handoff_summary": ""}

