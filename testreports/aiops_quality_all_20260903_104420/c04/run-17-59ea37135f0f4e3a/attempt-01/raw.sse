data: {"id": "59ea37135f0f4e3a-node_complete-parallel_evidence", "run_id": "59ea37135f0f4e3a", "seq": 1550, "ts_ms": 1788424758794, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 570.488, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-wvcb2"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/59ea37135f0f4e3a-g1/lane_artifacts/g1/artifact.json", "sha256": "eb800755f34ab35ea29c32a44711fcd9402c4948d1572de8adc5bb93c8af5d26", "bytes": 2452}, "snapshot_sha256": "9de6028eabeeadd2dba2601880037b72d621442d239acd46b813bcc10ce4add1"}]}, "handoff_summary": ""}

