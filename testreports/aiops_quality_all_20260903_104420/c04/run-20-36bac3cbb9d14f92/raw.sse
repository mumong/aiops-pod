data: {"id": "36bac3cbb9d14f92-node_complete-parallel_evidence", "run_id": "36bac3cbb9d14f92", "seq": 2145, "ts_ms": 1788425064017, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 53.64, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-04", "name": "workload-6584f97c76-wvcb2"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/36bac3cbb9d14f92-g1/lane_artifacts/g1/artifact.json", "sha256": "313466ccdfdc9a0023d9ba2208b75117ed6e087df6265f2853370ba8285452d0", "bytes": 2452}, "snapshot_sha256": "4b85c52c34d0ee232df42a6909ccf5f1ce005add44e2250d6e1a86652e4adfab"}]}, "handoff_summary": ""}

