3333, "weighted_score": 0.0667}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-crashloop-runtime"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 136156.6252708435, "llm_calls": 13, "llm_duration_ms": 88587.79549598694, "tool_calls": 17, "executed_tool_calls": 15, "deduplicated_tool_calls": 2, "successful_tool_calls": 17, "failed_tool_calls": 0, "tool_duration_ms": 162650.75659751892, "tool_wall_duration_ms": 46946.2947845459}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 19052.71005630493, "success": true}, "parallel_evidence": {"name": "并发证据采集", "duration_ms": 96798.34318161011, "success": true}, "evidence": {"name": "evidence", "duration_ms": 0.0, "success": true}, "rca": {"name": "rca", "duration_ms": 0.0, "success": true}, "conclusion": {"name": "汇总总结", "duration_ms": 20270.376443862915, "success": true}}, "success": true, "errors": []}}

