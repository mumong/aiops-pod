data: {"id": "96d37e17556142f1-node_complete-parallel_evidence", "run_id": "96d37e17556142f1", "seq": 1232, "ts_ms": 1788453907917, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 96.798, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-fl85h"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/96d37e17556142f1-g1/lane_artifacts/g1/artifact.json", "sha256": "993159f8e8b4c6b8a5760842564c2673c45f95ecaad1ad600546815d5a7cbd17", "bytes": 2452}, "snapshot_sha256": "9e46e41a6ea2d34d3ad8f86aa5a87122fb2b810e287eca9d228ae35dae216c09"}]}, "handoff_summary": ""}

