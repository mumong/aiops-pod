data: {"id": "b12016234df745fb-thinking-parallel_evidence-392", "run_id": "b12016234df745fb", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "read_context_archive", "content": null, "status": "success", "result_preview": "Pod workload-5c9c7b6489-fl85h in aiops-case-08 is stuck in CrashLoopBackOff with OOMKilled. The app container (python:3-alpine) has OOMKilled with exit code 137, memory limit is 64Mi, and it has resta", "duration_seconds": null, "iteration": 2, "ts_ms": 1788456445864, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "other"}, "tool_call_id": "call_4a5c6d3f968542dc987f0369", "tool_sequence": 3, "semantic_success": true, "result": "Pod workload-5c9c7b6489-fl85h in aiops-case-08 is stuck in CrashLoopBackOff with OOMKilled. The app container (python:3-alpine) has OOMKilled with exit code 137, memory limit is 64Mi, and it has restarted 23 times over 115m.\nkey_facts: [\"Pod: workload-5c9c7b6489-fl85h, Namespace: aiops-case-08, Node: node2/10.2.0.50\", \"Container 'app' state: Waiting, Reason: CrashLoopBackOff\", \"Last state: Terminated, Reason: OOMKilled, Exit Code: 137\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Restart Count: 23\", \"Memory Limit: 64Mi, Request: 24Mi\", \"Event: Warning BackOff x434 over 115m\"]\nconflicts: [\"raw_preview container signals show Reason: CrashLoopBackOff, while structured JSON shows reason: OOMKilled for Waiting state.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/b12016234df745fb-g1/tools/006-evidence-read_context_archive.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/b12016234df745fb-g1/tools/006-evidence-read_context_archive.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/b12016234df745fb-g1/tools/006-evidence-read_context_archive.summary.txt"}

