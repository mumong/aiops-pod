data: {"id": "00a77f3b002a4b08-node_complete-parallel_evidence", "run_id": "00a77f3b002a4b08", "seq": 3500, "ts_ms": 1788454330020, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 111.538, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-fl85h"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/00a77f3b002a4b08-g1/lane_artifacts/g1/artifact.json", "sha256": "da5edc4de948a1a957bbc7876a07c006ce190d1d5474b9747d069783c8a03b8e", "bytes": 2452}, "snapshot_sha256": "5b7f2ce736590b03faaf937222858d368293fdcb8949dde58a28263a3bc74105"}]}, "handoff_summary": ""}

