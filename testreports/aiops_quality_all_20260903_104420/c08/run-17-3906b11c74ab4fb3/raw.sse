data: {"id": "3906b11c74ab4fb3-node_complete-parallel_evidence", "run_id": "3906b11c74ab4fb3", "seq": 1440, "ts_ms": 1788452590245, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 179.531, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-08", "name": "workload-5c9c7b6489-fl85h"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/3906b11c74ab4fb3-g1/lane_artifacts/g1/artifact.json", "sha256": "833ed4b2489d93fb8b8bf7af7dfc1a6a8fb716adb6d5f60433de35c0e6aad854", "bytes": 2452}, "snapshot_sha256": "766c68a71b38e2ca2b35002481d5e788330b1f745a9da7c737a4559ae65a50bb"}]}, "handoff_summary": ""}

