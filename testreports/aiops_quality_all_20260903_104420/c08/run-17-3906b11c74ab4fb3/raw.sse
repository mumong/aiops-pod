data: {"id": "3906b11c74ab4fb3-thinking-parallel_evidence-1439", "run_id": "3906b11c74ab4fb3", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "ai_message", "tool_name": null, "content": "{\n  \"entity\": \"Pod/workload-5c9c7b6489-fl85h\",\n  \"namespace\": \"aiops-case-08\",\n  \"evidence_summary\": {\n    \"supported_causes\": [\n      {\n        \"cause\": \"OOMKilled (容器因内存超限被系统强制杀死)\",\n        \"evidence\": [\n          \"kubectl describe pod: 容器状态中明确显示 `Reason: OOMKilled`, `Exit Code: 137` (137 = 128 + SIGKILL, Linux 标准 OOM 退出码)\",\n          \"kubectl get pod yaml: `containerStatuses.app.reason = CrashLoopBackOff`, `exitCode = 137`, `restarts = 12`\",\n          \"预采集 Metrics (execute_pod_promql): `last_", "status": null, "result_preview": null, "duration_seconds": null, "iteration": 5, "ts_ms": 1788452579116, "lane_stage": "evidence"}

