data: {"id": "68475a1829324ffd-thinking-parallel_evidence-914", "run_id": "68475a1829324ffd", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "read_context_archive", "content": null, "status": "success", "result_preview": "Pod workload-5c9c7b6489-fl85h in namespace aiops-case-08 is in CrashLoopBackOff. Container 'app' is repeatedly OOMKilled (Exit Code 137) with memory limit set to 64Mi. Pod has restarted 25 times and e", "duration_seconds": null, "iteration": 4, "ts_ms": 1788457054749, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "other"}, "tool_call_id": "call_5ffd5354a87e47359b72d5b6", "tool_sequence": 8, "semantic_success": true, "result": "Pod workload-5c9c7b6489-fl85h in namespace aiops-case-08 is in CrashLoopBackOff. Container 'app' is repeatedly OOMKilled (Exit Code 137) with memory limit set to 64Mi. Pod has restarted 25 times and events show a BackOff warning (476 times over 125m).\nkey_facts: [\"Pod: workload-5c9c7b6489-fl85h\", \"Namespace: aiops-case-08\", \"Controller: ReplicaSet/workload-5c9c7b6489\", \"Container 'app' State: Waiting\", \"Container 'app' Reason: CrashLoopBackOff\", \"Container 'app' Last State: Terminated, Reason: OOMKilled, Exit Code: 137\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Memory Limit: 64Mi\", \"Memory Request: 24Mi\", \"Restart Count: 25\", \"Command: python3 /opt/aiops/server.py\", \"Event: Warning BackOff x476 over 125m\", \"Pod IP: 172.16.104.20\"]\nconflicts: [\"current_summary indicates container reason is 'OOMKilled', but raw_preview shows current state reason is 'CrashLoopBackOff' and last state reason is 'OOMKilled'.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/68475a1829324ffd-g1/tools/011-evidence-read_context_archive.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/68475a1829324ffd-g1/tools/011-evidence-read_context_