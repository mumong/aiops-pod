data: {"id": "5e3201d93a144201-node_complete-parallel_evidence", "run_id": "5e3201d93a144201", "seq": 2847, "ts_ms": 1788418065099, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 74.275, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-zz82w"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/5e3201d93a144201-g1/lane_artifacts/g1/artifact.json", "sha256": "9125d7960ed0562c014a9e67ca75409103d12706fc6f4d5ad537ca71ad637d46", "bytes": 2452}, "snapshot_sha256": "d3d98b2f2dba0d512d55d47d202f073c37f1ddc2052074725ebf7b1a5702a0a1"}]}, "handoff_summary": ""}

