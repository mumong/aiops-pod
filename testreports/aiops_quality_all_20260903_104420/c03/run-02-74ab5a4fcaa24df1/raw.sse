data: {"id": "74ab5a4fcaa24df1-node_complete-parallel_evidence", "run_id": "74ab5a4fcaa24df1", "seq": 1475, "ts_ms": 1788416093343, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 44.606, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-zz82w"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/74ab5a4fcaa24df1-g1/lane_artifacts/g1/artifact.json", "sha256": "646a1d53a6d3648436b04c4e7c41a20425ece9c1f3d13fe70f09d3ce8936cd5b", "bytes": 2452}, "snapshot_sha256": "dc5a47affb797a951230ed801424b6871d7ead9bbc3c105a94ea86432464b047"}]}, "handoff_summary": ""}

