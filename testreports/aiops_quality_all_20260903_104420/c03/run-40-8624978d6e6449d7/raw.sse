data: {"id": "8624978d6e6449d7-thinking-parallel_evidence-963", "run_id": "8624978d6e6449d7", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_logs", "content": null, "status": "success", "result_preview": "kubectl_logs 输出摘要: raw_chars=203 lines=3\nCommand failed (exit 1):\nkubectl logs workload-5b5fc86c8c-zz82w -n aiops-case-03\nError from server (BadRequest): container \"app\" in pod \"workload-5b5fc86c8c-zz", "duration_seconds": null, "iteration": 2, "ts_ms": 1788420595391, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-03", "name": "workload-5b5fc86c8c-zz82w"}, "dimension": "kubernetes"}, "tool_call_id": "call_1d2c81f1c10e4924bd0f33d5", "tool_sequence": 2, "semantic_success": false, "result": "kubectl_logs 输出摘要: raw_chars=203 lines=3\nCommand failed (exit 1):\nkubectl logs workload-5b5fc86c8c-zz82w -n aiops-case-03\nError from server (BadRequest): container \"app\" in pod \"workload-5b5fc86c8c-zz82w\" is waiting to start: ContainerCreating", "raw_ref": "/tmp/aiops/reports/context_archives/8624978d6e6449d7-g1/tools/008-evidence-kubectl_logs.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/8624978d6e6449d7-g1/tools/008-evidence-kubectl_logs.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/8624978d6e6449d7-g1/tools/008-evidence-kubectl_logs.summary.txt"}

