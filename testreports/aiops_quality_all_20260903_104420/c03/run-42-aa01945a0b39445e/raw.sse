n├─ 问题定位: 35.9s\n├─ 并发证据采集: 58.6s\n│  └─ g1 aiops-case-03/workload-5b5fc86c8c-zz82w: 58.6s (Evidence 50.1s, RCA 8.3s)\n└─ 汇总总结: 9.5s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-03/workload-5b5fc86c8c-zz82w**: pod-volume-mount-failed\n", "answer_source": "workflow", "elapsed_seconds": 103.905, "metrics": {"run_id": "aa01945a0b39445e", "mttr": {"value": "1.7m", "seconds": 103.92224836349487, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "47%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-volume-mount-failed", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-volume-mount-failed"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.75, "weighted_score": 0.15, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 75%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 103922.24836349487, "llm_calls": 15, "llm_duration_ms": 98195.40357589722, "tool_calls": 17, "executed_tool_calls": 15, "deduplicated_tool_calls": 2, "successful_tool_cal