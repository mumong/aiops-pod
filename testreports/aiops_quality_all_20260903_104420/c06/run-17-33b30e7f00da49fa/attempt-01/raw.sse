data: {"id": "33b30e7f00da49fa-node_complete-parallel_evidence", "run_id": "33b30e7f00da49fa", "seq": 1374, "ts_ms": 1788438895288, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 62.258, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-w9s9c"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/33b30e7f00da49fa-g1/lane_artifacts/g1/artifact.json", "sha256": "e43a1799db3fe47595f46e5bebaef1f72b7997175f7840d99e6de9880ebf92ff", "bytes": 2450}, "snapshot_sha256": "30668bdb9a4edc24fdb4cb510c22166408b76ecba715f8e09b2e25bb6c8c3f11"}]}, "handoff_summary": ""}

