: 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 0.7, "weighted_score": 0.14, "description": "因果链完整性", "detail": "部分因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-crashloop-runtime"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.6, "weighted_score": 0.12, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 60%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 116115.47756195068, "llm_calls": 12, "llm_duration_ms": 94471.40908241272, "tool_calls": 11, "executed_tool_calls": 9, "deduplicated_tool_calls": 2, "successful_tool_calls": 11, "failed_tool_calls": 0, "tool_duration_ms": 12314.033269882202, "tool_wall_duration_ms": 4752.8557777404785}, "nodes": {"layer": {"name": "问题定位", "duration_ms": 32825.040102005005, "success": true}, "parallel_evidence": {"name": "并发证据采集", "duration_ms": 64429.40139770508, "success": true}, "evidence": {"name": "evidence", "duration_ms": 0.0, "success": true}, "rca": {"name": "rca", "duration_ms": 0.0, "success": true}, "conclusion": {"name": "汇总总结", "duration_ms": 18824.325799942017, "success": true}}, "success": true, "errors": []}}

