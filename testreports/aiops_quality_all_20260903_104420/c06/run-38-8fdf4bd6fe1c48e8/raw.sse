data: {"id": "8fdf4bd6fe1c48e8-node_complete-parallel_evidence", "run_id": "8fdf4bd6fe1c48e8", "seq": 3358, "ts_ms": 1788442490033, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 96.883, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 0, "inconclusive_count": 1, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-w9s9c"}], "diagnostic_status": "inconclusive", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8fdf4bd6fe1c48e8-g1/lane_artifacts/g1/artifact.json", "sha256": "9cb81c881ad1275c2d34f7dea03c1a13c47ab31441cd7036eb0f9c19c853a061", "bytes": 2454}, "snapshot_sha256": "cb5e46f899aaf88893c0886a7b3a09b8875109924a9eba9415069369d00fa4b2"}]}, "handoff_summary": ""}

