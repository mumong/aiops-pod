data: {"id": "c0ea1b1ff23f46bb-node_complete-parallel_evidence", "run_id": "c0ea1b1ff23f46bb", "seq": 2453, "ts_ms": 1788441518226, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 564.778, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-06", "name": "workload-7679bcf76-w9s9c"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/c0ea1b1ff23f46bb-g1/lane_artifacts/g1/artifact.json", "sha256": "8f8baa24ea82bf0d279b4f6602bb18acbecddd210951de04a252d43d858f1fd7", "bytes": 2450}, "snapshot_sha256": "eafa3f4437edafaf77679ee5939328668889926d36c6e62c97749df1670220ed"}]}, "handoff_summary": ""}

