data: {"id": "85947cffe27943b4-node_complete-parallel_evidence", "run_id": "85947cffe27943b4", "seq": 1735, "ts_ms": 1788447143805, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 120.643, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-kmfxx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/85947cffe27943b4-g1/lane_artifacts/g1/artifact.json", "sha256": "ac95b0479a35557d4104246ad736b22d72563c4cd7ccf277f27d978355925ed7", "bytes": 2450}, "snapshot_sha256": "b3172b1676827cb9ab3faf34a2be8375cc844720bba54e81b53d7212d0157693"}]}, "handoff_summary": ""}

