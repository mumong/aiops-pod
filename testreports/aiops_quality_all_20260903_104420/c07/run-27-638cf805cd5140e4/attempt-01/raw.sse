data: {"id": "638cf805cd5140e4-node_complete-parallel_evidence", "run_id": "638cf805cd5140e4", "seq": 1884, "ts_ms": 1788446841229, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 125.093, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-kmfxx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/638cf805cd5140e4-g1/lane_artifacts/g1/artifact.json", "sha256": "a84123bb2b47464b5b6b3ec921217dd5c25b2fc210b936e3a871c13f072831c3", "bytes": 2450}, "snapshot_sha256": "20d813e68087ca542446c9404f32edaa165a4685c8098eed8937ee5d071350ad"}]}, "handoff_summary": ""}

