data: {"id": "e7b0fff7375d4be2-node_complete-parallel_evidence", "run_id": "e7b0fff7375d4be2", "seq": 1478, "ts_ms": 1788445311299, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 59.603, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-07", "name": "workload-dff5cbc6b-kmfxx"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e7b0fff7375d4be2-g1/lane_artifacts/g1/artifact.json", "sha256": "0cb12c28ffda2f1c1e6420131f698b6dc479d29d2d14f96fe18278518ee2e5cb", "bytes": 2449}, "snapshot_sha256": "4f048d78452c9dcd7019109e866a3e5dc02d71ec40ff7d3f2c8eadd696f3a599"}]}, "handoff_summary": ""}

