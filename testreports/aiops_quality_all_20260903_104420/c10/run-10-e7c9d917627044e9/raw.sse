data: {"id": "e7c9d917627044e9-node_complete-parallel_evidence", "run_id": "e7c9d917627044e9", "seq": 2215, "ts_ms": 1788468016121, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 85.319, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-sbqvc"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/e7c9d917627044e9-g1/lane_artifacts/g1/artifact.json", "sha256": "b7e6723358bf44697d6f6a8ad0f3a9d4f3c384b7ea3031d6153ce70bc4dbb9bf", "bytes": 2451}, "snapshot_sha256": "7a5a9008efb4b85329354a98fc594ebda077af00281d396b6023e34771f5f474"}]}, "handoff_summary": ""}

