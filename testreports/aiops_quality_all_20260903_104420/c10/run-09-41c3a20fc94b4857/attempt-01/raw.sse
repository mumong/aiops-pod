data: {"id": "41c3a20fc94b4857-thinking-parallel_evidence-824", "run_id": "41c3a20fc94b4857", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-79d9f8fd88-sbqvc in namespace aiops-case-10 on node2 is in CrashLoopBackOff state. Container 'app' has Exit Code 137 and is failing liveness probes (HTTP 500), triggering repeated restart", "duration_seconds": null, "iteration": 6, "ts_ms": 1788467794899, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-10", "name": "workload-79d9f8fd88-sbqvc"}, "dimension": "kubernetes"}, "tool_call_id": "call_d67cb94751884003bd5e33ac", "tool_sequence": 16, "semantic_success": true, "result": "Pod workload-79d9f8fd88-sbqvc in namespace aiops-case-10 on node2 is in CrashLoopBackOff state. Container 'app' has Exit Code 137 and is failing liveness probes (HTTP 500), triggering repeated restarts.\nkey_facts: [\"Pod: workload-79d9f8fd88-sbqvc\", \"Namespace: aiops-case-10\", \"Node: node2/10.2.0.50\", \"Status: Running (but pod is unstable)\", \"Container: app\", \"Exit Code: 137\", \"Reason: CrashLoopBackOff\", \"Warning: Liveness probe failed: HTTP probe failed with statuscode: 500 (17 times over 25m)\", \"Warning: Back-off restarting failed container app (83 times over 21m)\"]\nmissing: [\"Container image\", \"Pod Restart Count\", \"Specific error logs from container 'app'\"]", "raw_ref": "/tmp/aiops/reports/context_archives/41c3a20fc94b4857-g1/tools/019-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/41c3a20fc94b4857-g1/tools/019-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/41c3a20fc94b4857-g1/tools/019-evidence-kubectl_describe.summary.txt"}

