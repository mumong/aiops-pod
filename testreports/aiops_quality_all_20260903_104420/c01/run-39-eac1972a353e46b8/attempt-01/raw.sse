data: {"id": "eac1972a353e46b8-node_complete-parallel_evidence", "run_id": "eac1972a353e46b8", "seq": 2234, "ts_ms": 1788408938179, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 61.742, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-llhkh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/eac1972a353e46b8-g1/lane_artifacts/g1/artifact.json", "sha256": "a1a5aeb5b597f960c19a0ff005ed64cd04dd3601f29b1f3fd8251eb9c6aae493", "bytes": 2452}, "snapshot_sha256": "c5a8c5e7aec0fcfa6980e628419e6a0948378afbba634609bc0b87767be1bbe6"}]}, "handoff_summary": ""}

