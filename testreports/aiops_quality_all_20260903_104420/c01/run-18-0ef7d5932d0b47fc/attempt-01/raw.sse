data: {"id": "0ef7d5932d0b47fc-node_complete-parallel_evidence", "run_id": "0ef7d5932d0b47fc", "seq": 1612, "ts_ms": 1788406036584, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 50.288, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-llhkh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0ef7d5932d0b47fc-g1/lane_artifacts/g1/artifact.json", "sha256": "65a7e71b3bdb0663682f52cda77153d6aa95cd4bd381f3699ea8b605344023d4", "bytes": 2452}, "snapshot_sha256": "d43e571519527dda15c74b60586e2de39f806f799b5b284e718c0848f5c07f04"}]}, "handoff_summary": ""}

