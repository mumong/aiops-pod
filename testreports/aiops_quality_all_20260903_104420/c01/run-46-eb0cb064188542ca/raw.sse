data: {"id": "eb0cb064188542ca-node_complete-parallel_evidence", "run_id": "eb0cb064188542ca", "seq": 1393, "ts_ms": 1788409573342, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 50.622, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-llhkh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/eb0cb064188542ca-g1/lane_artifacts/g1/artifact.json", "sha256": "0055a770c1bc3a0a88e8a489cf138f3e4e55c5c4981d0e0961815acda4c15730", "bytes": 2451}, "snapshot_sha256": "a636af3c5ad530cd643dcb54c9a58374d1dbf4ec289a1ab998173e776a216521"}]}, "handoff_summary": ""}

