data: {"id": "c71caf76bfd14549-node_complete-parallel_evidence", "run_id": "c71caf76bfd14549", "seq": 2414, "ts_ms": 1788409826262, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 55.97, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-llhkh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/c71caf76bfd14549-g1/lane_artifacts/g1/artifact.json", "sha256": "f4df446cba909cee3ea6909656d32db9efb23ea6ccb5b2e048823a75aa9722fe", "bytes": 2633}, "snapshot_sha256": "84db70ecac1b2399f678d40677a20382a6ef19cc324343298640d1a08a29899e"}]}, "handoff_summary": ""}

