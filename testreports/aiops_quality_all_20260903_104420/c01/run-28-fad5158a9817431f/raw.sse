data: {"id": "fad5158a9817431f-node_complete-parallel_evidence", "run_id": "fad5158a9817431f", "seq": 1648, "ts_ms": 1788407485652, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 58.902, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-01", "name": "workload-68c557d875-llhkh"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/fad5158a9817431f-g1/lane_artifacts/g1/artifact.json", "sha256": "1cc1f72db11c2dab02ccd1679a879ccc629f4ba85ed323e2ed091997cdcf1a10", "bytes": 2451}, "snapshot_sha256": "df87cd1718337e230ad56fb42df1aa6bff34b66fff7b49065a8b2bf1d3a82394"}]}, "handoff_summary": ""}

