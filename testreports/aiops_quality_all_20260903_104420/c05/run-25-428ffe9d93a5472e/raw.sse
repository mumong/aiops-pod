data: {"id": "428ffe9d93a5472e-node_complete-parallel_evidence", "run_id": "428ffe9d93a5472e", "seq": 1700, "ts_ms": 1788431717245, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 58.082, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/428ffe9d93a5472e-g1/lane_artifacts/g1/artifact.json", "sha256": "a30191d8473f49f038fd1ef24582dbc5b3ae5e160ae1d5a727edb09a11463bfb", "bytes": 2452}, "snapshot_sha256": "4d1b465cf12fa142b25ea424bcce796e7d0c947ad0126f42adf4663f2f38185e"}]}, "handoff_summary": ""}

