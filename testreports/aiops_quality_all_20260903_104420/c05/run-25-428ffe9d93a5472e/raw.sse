data: {"id": "428ffe9d93a5472e-thinking-parallel_evidence-1102", "run_id": "428ffe9d93a5472e", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod 'workload-5dbb5dcd6c-nhd7v' is Pending due to missing NetworkAttachmentDefinition 'unavailable-network' in namespace 'aiops-case-05', causing Multus CNI sandbox creation failures.\nkey_facts: [\"Pod", "duration_seconds": null, "iteration": 1, "ts_ms": 1788431695805, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_2c8c701b5c574298ac69afcc", "tool_sequence": 1, "semantic_success": true, "result": "Pod 'workload-5dbb5dcd6c-nhd7v' is Pending due to missing NetworkAttachmentDefinition 'unavailable-network' in namespace 'aiops-case-05', causing Multus CNI sandbox creation failures.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v, Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Status: Pending, Container State: Waiting (Reason: ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Events: Repeated Warning 'NoNetworkFound' and 'FailedCreatePodSandBox' from multus and kubelet\", \"Error: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\"]\nmissing: [\"NetworkAttachmentDefinition object details for 'unavailable-network'\", \"Multus configuration logs\"]", "raw_ref": "/tmp/aiops/reports/context_archives/428ffe9d93a5472e-g1/tools/006-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/428ffe9d93a5472e-g1/tools/006-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archive