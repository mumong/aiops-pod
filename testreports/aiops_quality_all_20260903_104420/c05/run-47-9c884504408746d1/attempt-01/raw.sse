data: {"id": "9c884504408746d1-node_complete-parallel_evidence", "run_id": "9c884504408746d1", "seq": 732, "ts_ms": 1788436184544, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 42.707, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/9c884504408746d1-g1/lane_artifacts/g1/artifact.json", "sha256": "0eaa84425f6b9f04716f2c8c0bfea456ccbf8a34f13df7b60be2070c568e02ce", "bytes": 2452}, "snapshot_sha256": "c1ed2cd99bcd151f6c818ae92398a99002108823ba1dfd7b827010816542378a"}]}, "handoff_summary": ""}

