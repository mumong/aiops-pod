data: {"id": "294497cb8ea042f0-thinking-parallel_evidence-973", "run_id": "294497cb8ea042f0", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-nhd7v (ns: aiops-case-05) on node node2 is Pending with status ContainerCreating. Events show repeated failures due to missing NetworkAttachmentDefinition 'unavailable-network'", "duration_seconds": null, "iteration": 1, "ts_ms": 1788428990196, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_645001dfe0a74e4f854a32e9", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-nhd7v (ns: aiops-case-05) on node node2 is Pending with status ContainerCreating. Events show repeated failures due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v, Namespace: aiops-case-05, Node: node2/10.2.0.50\", \"Container: app, Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Status: Pending, Reason: ContainerCreating\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Warning Event 'NoNetworkFound': cannot find network-attachment-definition (unavailable-network) in namespace (aiops-case-05)\", \"Warning Event 'FailedCreatePodSandBox': multus plugin failed (add), missing delegate 'unavailable-network'\"]", "raw_ref": "/tmp/aiops/reports/context_archives/294497cb8ea042f0-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/294497cb8ea042f0-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/294497cb8ea042f0-g1/tools/004-evidence-kubectl_describe.summary.txt"}

