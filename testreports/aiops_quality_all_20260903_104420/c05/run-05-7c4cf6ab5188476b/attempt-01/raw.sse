data: {"id": "7c4cf6ab5188476b-thinking-parallel_evidence-1365", "run_id": "7c4cf6ab5188476b", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-nhd7v in namespace aiops-case-05 remains in Pending/ContainerCreating state due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dc", "duration_seconds": null, "iteration": 1, "ts_ms": 1788428345522, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_bfe441c585654fc08b424d7a", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-nhd7v in namespace aiops-case-05 remains in Pending/ContainerCreating state due to missing NetworkAttachmentDefinition 'unavailable-network'.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v, Namespace: aiops-case-05, Node: node2/10.2.0.50\", \"Status: Pending (ContainersReady: False, Reason: ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Root Cause: Network-attachment-definition 'unavailable-network' not found in namespace 'aiops-case-05'\", \"Events: Frequent 'Warning NoNetworkFound' from multus and 'Warning FailedCreatePodSandBox' from kubelet\"]", "raw_ref": "/tmp/aiops/reports/context_archives/7c4cf6ab5188476b-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/7c4cf6ab5188476b-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/7c4cf6ab5188476b-g1/tools/004-evidence-kubectl_describe.summary.txt"}

