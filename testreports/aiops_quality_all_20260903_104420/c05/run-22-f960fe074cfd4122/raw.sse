data: {"id": "f960fe074cfd4122-node_complete-parallel_evidence", "run_id": "f960fe074cfd4122", "seq": 1707, "ts_ms": 1788431411674, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 557.545, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/f960fe074cfd4122-g1/lane_artifacts/g1/artifact.json", "sha256": "7f7b075dc7f5bbe21e2a65a70dd8da9c0cacfa0dd3d7eb3c18ed4c827d3274d5", "bytes": 2634}, "snapshot_sha256": "de6e634fa2dfdfc3c4cde6de5f9d10c63d3a063756734ec4cd4ad293aebe7895"}]}, "handoff_summary": ""}

