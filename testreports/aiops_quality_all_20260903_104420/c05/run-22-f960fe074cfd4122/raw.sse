data: {"id": "f960fe074cfd4122-thinking-parallel_evidence-809", "run_id": "f960fe074cfd4122", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-nhd7v in aiops-case-05 is stuck in Pending/ContainerCreating state. It references a non-existent NetworkAttachmentDefinition 'unavailable-network' via multus CNI, causing repea", "duration_seconds": null, "iteration": 1, "ts_ms": 1788431389334, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_174e87a691774d37913620de", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-nhd7v in aiops-case-05 is stuck in Pending/ContainerCreating state. It references a non-existent NetworkAttachmentDefinition 'unavailable-network' via multus CNI, causing repeated sandbox creation failures on node2.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v, Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Status: Pending (ContainersReady: False, PodScheduled: True)\", \"Container app state: Waiting (Reason: ContainerCreating)\", \"Event Reason: FailedCreatePodSandBox (kubelet) - failed to setup network\", \"Event Reason: NoNetworkFound (multus) - cannot find network-attachment-definition (unavailable-network)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Error: network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\"]", "raw_ref": "/tmp/aiops/reports/context_archives/f960fe074cfd4122-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/f960fe074cfd4122-g1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/f960fe074cfd4122-g1/tools/004-evidence-kubectl_describe.summary.txt"}

