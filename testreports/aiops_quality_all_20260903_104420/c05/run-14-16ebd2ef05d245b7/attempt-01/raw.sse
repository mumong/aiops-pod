data: {"id": "16ebd2ef05d245b7-thinking-parallel_evidence-547", "run_id": "16ebd2ef05d245b7", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_find_resource", "content": null, "status": "success", "result_preview": "kubectl_find_resource 输出摘要: raw_chars=374 lines=3\nCommand failed (exit 1):\nkubectl get -A --show-labels -o wide network-attachment-definition | grep -i 'unavailable-network'\nError from server (Forbidd", "duration_seconds": null, "iteration": 2, "ts_ms": 1788429729310, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "kubernetes"}, "tool_call_id": "call_502993f8488f4e7a8fa94ce2", "tool_sequence": 4, "semantic_success": false, "result": "kubectl_find_resource 输出摘要: raw_chars=374 lines=3\nCommand failed (exit 1):\nkubectl get -A --show-labels -o wide network-attachment-definition | grep -i 'unavailable-network'\nError from server (Forbidden): network-attachment-definitions.k8s.cni.cncf.io is forbidden: User \"system:serviceaccount:mcp:mcp-server-manager\" cannot list resource \"network-attachment-definitions\" in API group \"k8s.cni.cncf.io\" at the cluster scope", "raw_ref": "/tmp/aiops/reports/context_archives/16ebd2ef05d245b7-g1/tools/007-evidence-kubectl_find_resource.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/16ebd2ef05d245b7-g1/tools/007-evidence-kubectl_find_resource.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/16ebd2ef05d245b7-g1/tools/007-evidence-kubectl_find_resource.summary.txt"}

