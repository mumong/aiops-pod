data: {"id": "16ebd2ef05d245b7-node_complete-parallel_evidence", "run_id": "16ebd2ef05d245b7", "seq": 1176, "ts_ms": 1788429751358, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 52.812, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/16ebd2ef05d245b7-g1/lane_artifacts/g1/artifact.json", "sha256": "a00a60d049137dbf10392481fa12d359eb883ae7b169978ad527879632f5b290", "bytes": 2452}, "snapshot_sha256": "ea2680227b12fff28c0a2997debfa33a38de4d9b8bd3df13fb9b55ad995a675d"}]}, "handoff_summary": ""}

