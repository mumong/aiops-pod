data: {"id": "9b9429e0d1ee4436-thinking-parallel_evidence-155", "run_id": "9b9429e0d1ee4436", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-nhd7v in namespace aiops-case-05 is in Pending state. The container app is waiting in ContainerCreating state. The root cause is a missing network-attachment-definition named '", "duration_seconds": null, "iteration": 1, "ts_ms": 1788435079591, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_87912d21ebb54e1291e9c262", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-nhd7v in namespace aiops-case-05 is in Pending state. The container app is waiting in ContainerCreating state. The root cause is a missing network-attachment-definition named 'unavailable-network' in namespace aiops-case-05, causing continuous Multus CNI failures.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v, Namespace: aiops-case-05, Node: node2/10.2.0.50\", \"Status: Pending, Container State: Waiting (Reason: ContainerCreating)\", \"Container app uses image: xnet.registry.io:8443/observability/python:3-alpine\", \"Annotations: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Events: Repeated Warning NoNetworkFound from multus indicating 'network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found'\", \"Event duration: Warnings observed from 60m ago to present\"]\nconflicts: [\"Current summary mentions 'FailedCreatePodSandBox' with specific rpc error code; raw_preview shows 'NoNetworkFound' warnings as the primary event. Both indicate the same missing resource issue, but the specific error message format differs. No Network found warning is the direct cause shown in raw events.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/9b9429e0d1ee4436-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/9b9429e0d1ee4436-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/9b9429e0d1ee4436-g1/tools/005-evidence-kubectl_describe.summary.txt"}

