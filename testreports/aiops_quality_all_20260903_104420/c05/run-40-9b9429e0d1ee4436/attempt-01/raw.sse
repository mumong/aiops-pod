data: {"id": "9b9429e0d1ee4436-node_complete-parallel_evidence", "run_id": "9b9429e0d1ee4436", "seq": 900, "ts_ms": 1788435097626, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 536.599, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/9b9429e0d1ee4436-g1/lane_artifacts/g1/artifact.json", "sha256": "9e67255914fe6ea792e3168ff168993f06b2b72d887f38341411335585e1ed9d", "bytes": 2452}, "snapshot_sha256": "f1d194d6cee030f3009d71939ef445609f770ae7999e0bd016a3930a9c5c01af"}]}, "handoff_summary": ""}

