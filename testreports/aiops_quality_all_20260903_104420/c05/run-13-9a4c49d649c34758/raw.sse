data: {"id": "9a4c49d649c34758-thinking-parallel_evidence-125", "run_id": "9a4c49d649c34758", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod `workload-5dbb5dcd6c-nhd7v` in namespace `aiops-case-05` is stuck in Pending/ContainerCreating state. Events show repeated failures by `multus` and `kubelet` because the required network-attachmen", "duration_seconds": null, "iteration": 1, "ts_ms": 1788429635418, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_7a704ec732e54c528e790094", "tool_sequence": 1, "semantic_success": true, "result": "Pod `workload-5dbb5dcd6c-nhd7v` in namespace `aiops-case-05` is stuck in Pending/ContainerCreating state. Events show repeated failures by `multus` and `kubelet` because the required network-attachment-definition `unavailable-network` is not found in the namespace. Note: current_summary incorrectly attributes the error solely to `kubelet`; raw_preview shows `multus` reports `NoNetworkFound` first, followed by `kubelet` `FailedCreatePodSandBox`.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v (aiops-case-05) on node node2/10.2.0.50\", \"Status: Pending (Reason: ContainerCreating)\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Error: missing network-attachment-definition 'unavailable-network' in namespace 'aiops-case-05'\", \"Events: Repeated 'Warning NoNetworkFound' from multus and 'Warning FailedCreatePodSandBox' from kubelet (starting 27m ago)\", \"Pod Spec has annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\"]\nconflicts: [\"current_summary blames kubelet only; raw_preview shows multus reports 'NoNetworkFound' first, then kubelet fails to create sandbox due to missing network config.\"]", "raw_ref": "/tmp/aiops/reports/context_archives/9a4c49d649c34758-g1/tools/005-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/9a4c49d649c34758-g1/tools/005-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/9a4c49d649c34758-g1/tools/005-evidence-kubectl_describe.summary.txt"}

