data: {"id": "5658bbac515d46b0-thinking-parallel_evidence-439", "run_id": "5658bbac515d46b0", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "Pod workload-5dbb5dcd6c-nhd7v (namespace: aiops-case-05, node: node2/10.2.0.50) is in Pending state due to missing NetworkAttachmentDefinition. The pod requests network 'unavailable-network' via annot", "duration_seconds": null, "iteration": 1, "ts_ms": 1788433093120, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}, "dimension": "kubernetes"}, "tool_call_id": "call_f166f46004bd4ee88e74f065", "tool_sequence": 1, "semantic_success": true, "result": "Pod workload-5dbb5dcd6c-nhd7v (namespace: aiops-case-05, node: node2/10.2.0.50) is in Pending state due to missing NetworkAttachmentDefinition. The pod requests network 'unavailable-network' via annotation k8s.v1.cni.cncf.io/networks, but Multus cannot find the corresponding resource in the namespace.\nkey_facts: [\"Pod: workload-5dbb5dcd6c-nhd7v\", \"Namespace: aiops-case-05\", \"Node: node2/10.2.0.50\", \"Image: xnet.registry.io:8443/observability/python:3-alpine\", \"Status: Pending\", \"Container State: Waiting (Reason: ContainerCreating)\", \"Annotation: k8s.v1.cni.cncf.io/networks: unavailable-network\", \"Warning Event: NoNetworkFound by multus\", \"Error Message: cannot find a network-attachment-definition (unavailable-network) in namespace (aiops-case-05): network-attachment-definitions.k8s.cni.cncf.io \\\"unavailable-network\\\" not found\"]", "raw_ref": "/tmp/aiops/reports/context_archives/5658bbac515d46b0-g1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/5658bbac515d46b0-g1/tools/004-evidence-kubectl_describe.structured.