data: {"id": "7be5abf8d97e4551-node_complete-parallel_evidence", "run_id": "7be5abf8d97e4551", "seq": 2334, "ts_ms": 1788433292437, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 48.123, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-05", "name": "workload-5dbb5dcd6c-nhd7v"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/7be5abf8d97e4551-g1/lane_artifacts/g1/artifact.json", "sha256": "14a7c71783725a139262bc5920b0322c8950aefbb9e3daccf7ed68ddb7ba0911", "bytes": 2452}, "snapshot_sha256": "e7499855a0ed0d803d4f7fa8f2444b3fe538ead37e0972bcf9871a8a1f4dbd77"}]}, "handoff_summary": ""}

