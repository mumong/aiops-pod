data: {"id": "f2fdf7b99307480f-node_complete-parallel_evidence", "run_id": "f2fdf7b99307480f", "seq": 1574, "ts_ms": 1788477358091, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 41.592, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/f2fdf7b99307480f-g1/lane_artifacts/g1/artifact.json", "sha256": "75bdd80e9c13609cd81a398745d4a669ca6780f1be1b7706a0d8e8e0bef9fa17", "bytes": 2418}, "snapshot_sha256": "eddeba397ab675381ef92660213f19d17929b4847177980b2863d392e8a435d7"}]}, "handoff_summary": ""}

