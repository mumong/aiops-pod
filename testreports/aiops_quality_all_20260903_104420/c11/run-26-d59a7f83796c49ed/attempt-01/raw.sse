data: {"id": "d59a7f83796c49ed-node_complete-parallel_evidence", "run_id": "d59a7f83796c49ed", "seq": 1692, "ts_ms": 1788477648408, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 60.665, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/d59a7f83796c49ed-g1/lane_artifacts/g1/artifact.json", "sha256": "0067287bbcba7f47b555a2cf9a0f88835b7a13217fb07c66a644b2c6dd0e1e79", "bytes": 2417}, "snapshot_sha256": "108fe7905beb952409742a92f6b5ff1cff38af74e543314ebe73f2219451f566"}]}, "handoff_summary": ""}

