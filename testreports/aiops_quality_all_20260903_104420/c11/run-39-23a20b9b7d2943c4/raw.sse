data: {"id": "23a20b9b7d2943c4-node_complete-parallel_evidence", "run_id": "23a20b9b7d2943c4", "seq": 1888, "ts_ms": 1788478778792, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 102.648, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/23a20b9b7d2943c4-g1/lane_artifacts/g1/artifact.json", "sha256": "3a8dd61d72d4a7b6540e4a194e7e1325f829fe92f3e9f8212458aacd5618549d", "bytes": 2418}, "snapshot_sha256": "0a94dc030d01528e04fec0071fc36450463787dc5271e8ca2072fa23afb29427"}]}, "handoff_summary": ""}

