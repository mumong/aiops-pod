data: {"id": "57cb50d905714fca-node_complete-parallel_evidence", "run_id": "57cb50d905714fca", "seq": 930, "ts_ms": 1788478929477, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 49.077, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/57cb50d905714fca-g1/lane_artifacts/g1/artifact.json", "sha256": "3641d2775fac0b66192600567c319c6aef0c0a7fc964d21967481f207213460b", "bytes": 2417}, "snapshot_sha256": "0ee88fca0232f9dbaf753c64be2894144a18c02b0a8d8beefe5e09e84dce1326"}]}, "handoff_summary": ""}

