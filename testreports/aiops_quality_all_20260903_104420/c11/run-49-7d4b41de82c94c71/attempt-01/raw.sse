data: {"id": "7d4b41de82c94c71-node_complete-parallel_evidence", "run_id": "7d4b41de82c94c71", "seq": 719, "ts_ms": 1788480182924, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 39.668, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-11", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/7d4b41de82c94c71-g1/lane_artifacts/g1/artifact.json", "sha256": "24b920b190d38d280c354e595ce624f3fb785cdd9552592fa089c6e74e68b01c", "bytes": 2418}, "snapshot_sha256": "b7a82cf0f490b6c956f83dfac8ff39c3a7fa35489d5a270e9a70ed93ce7e0b43"}]}, "handoff_summary": ""}

