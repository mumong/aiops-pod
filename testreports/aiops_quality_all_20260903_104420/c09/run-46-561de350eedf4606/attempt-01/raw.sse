 10.6s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-09/workload-5f4fb9ff45-cfzz6**: pod-notready-probe-failed\n", "answer_source": "workflow", "elapsed_seconds": 128.165, "metrics": {"run_id": "561de350eedf4606", "mttr": {"value": "2.1m", "seconds": 128.17704677581787, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "56%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-notready-probe-failed", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-notready-probe-failed"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.9, "weighted_score": 0.18, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 90%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 128177.04677581787, "llm_calls": 12, "llm_duration_ms": 105698.02236557007, "tool_calls": 15, "executed_tool_calls": 14, "deduplicated_tool_calls": 1, "successful_tool_calls": 15, "failed_tool_calls": 0, "tool_duration_ms": 46460.41393280029, "tool_wall_duration_ms": 22044.575691223145}, "no