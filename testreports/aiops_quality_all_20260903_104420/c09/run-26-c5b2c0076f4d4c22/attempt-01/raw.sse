data: {"id": "c5b2c0076f4d4c22-node_complete-parallel_evidence", "run_id": "c5b2c0076f4d4c22", "seq": 1933, "ts_ms": 1788462714155, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 602.143, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-cfzz6"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/c5b2c0076f4d4c22-g1/lane_artifacts/g1/artifact.json", "sha256": "901347644be702e2c1e2a62d883d76eb34d4615cde753e70aa74abfb17c8546f", "bytes": 2452}, "snapshot_sha256": "ecbace49dce243c8a824de938029ddf62783d9cfe77fc0f1b4e921967ed26e40"}]}, "handoff_summary": ""}

