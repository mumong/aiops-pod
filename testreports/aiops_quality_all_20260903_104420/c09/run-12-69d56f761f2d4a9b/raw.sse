data: {"id": "69d56f761f2d4a9b-thinking-layer-435", "run_id": "69d56f761f2d4a9b", "node": "layer", "node_name": "问题定位", "thinking_type": "tool_result", "tool_name": "fetch_runbook", "content": null, "status": "success", "result_preview": "<runbook>\n# Pod NotReadyProbeFailed / Running 但未 Ready\n\n> Pod异常类型: NotReadyProbeFailed | 典型状态: Running + READY 0/1 | 兼容分类: probe_health\n\n## 状态识别\n- Pod phase 通常为 `Running`，但 READY 为 `0/1` 或部分容器未 Ready\n", "duration_seconds": null, "iteration": 5, "ts_ms": 1788459306280}

