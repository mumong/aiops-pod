data: {"id": "443d75f3762e4759-node_complete-parallel_evidence", "run_id": "443d75f3762e4759", "seq": 1052, "ts_ms": 1788463545161, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 70.941, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-cfzz6"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/443d75f3762e4759-g1/lane_artifacts/g1/artifact.json", "sha256": "b5f01174f2e704ee263e02f714abd6f91bc199730334cb274f90ef41fcb64e28", "bytes": 2451}, "snapshot_sha256": "62c6a4c2a9b3e510cea097cf808f33e8b68c1e90cddc6c17b17a6cf3ec4c1a14"}]}, "handoff_summary": ""}

