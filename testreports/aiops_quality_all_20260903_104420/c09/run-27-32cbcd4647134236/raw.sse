data: {"id": "32cbcd4647134236-thinking-parallel_evidence-906", "run_id": "32cbcd4647134236", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_logs", "content": null, "status": "success", "result_preview": "Pod `workload-5f4fb9ff45-cfzz6` (service: aiops-lab-workload) 持续报 `http_request` 错误：`dependency unavailable` (HTTP 503)。日志显示 `allocated_mib` 恒为 0。\nkey_facts: [\"Pod: workload-5f4fb9ff45-cfzz6\", \"Servic", "duration_seconds": null, "iteration": 2, "ts_ms": 1788462800463, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "entity": {"kind": "Pod", "namespace": "aiops-case-09", "name": "workload-5f4fb9ff45-cfzz6"}, "dimension": "kubernetes"}, "tool_call_id": "call_5463539e89da4c988a5338ec", "tool_sequence": 4, "semantic_success": true, "result": "Pod `workload-5f4fb9ff45-cfzz6` (service: aiops-lab-workload) 持续报 `http_request` 错误：`dependency unavailable` (HTTP 503)。日志显示 `allocated_mib` 恒为 0。\nkey_facts: [\"Pod: workload-5f4fb9ff45-cfzz6\", \"Service: aiops-lab-workload\", \"Error Message: dependency unavailable\", \"HTTP Status: 503\", \"Resource Usage: allocated_mib: 0\", \"Frequency: 持续报错 (时间跨度约 24s，日志截断)\"]\nmissing: [\"未显示具体依赖项名称 (如 DB、下游服务)\", \"未提供 Pod 事件 (Events) 以解释为何 allocated_mib 为 0\"]", "raw_ref": "/tmp/aiops/reports/context_archives/32cbcd4647134236-g1/tools/009-evidence-kubectl_logs.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/32cbcd4647134236-g1/tools/009-evidence-kubectl_logs.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/32cbcd4647134236-g1/tools/009-evidence-kubectl_logs.summary.txt"}

