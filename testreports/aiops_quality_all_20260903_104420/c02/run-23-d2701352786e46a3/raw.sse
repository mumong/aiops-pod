workload-65b7f54794-rnlv4: 110.1s (Evidence 99.5s, RCA 10.4s)\n└─ 汇总总结: 10.0s\n```\n\n📋 Runbook 参考\n\n- **g1 aiops-case-02/workload-65b7f54794-rnlv4**: pod-imagepull-failed\n", "answer_source": "workflow", "elapsed_seconds": 149.852, "metrics": {"run_id": "d2701352786e46a3", "mttr": {"value": "2.5m", "seconds": 149.85885047912598, "pass": true, "threshold": "< 10.0m"}, "evidence_completeness": {"value": "0%", "collected": 0, "planned": 0, "pass": false, "threshold": "> 90%"}, "root_cause_confidence": {"value": "48%", "pass": false, "threshold": ">= 80%"}, "runbook_coverage": {"matched": true, "runbook_id": "pod-imagepull-failed", "pass": true, "score": 1.0, "breakdown": [{"description": "Runbook 引用", "weight": 0.5, "score": 1.0, "weighted_score": 0.5}, {"description": "核心 Runbook 识别", "weight": 0.3, "score": 1.0, "weighted_score": 0.3}, {"description": "Runbook 结论关联", "weight": 0.2, "score": 1.0, "weighted_score": 0.2}]}, "confidence_breakdown": [{"name": "evidence_strength", "weight": 0.35, "score": 0.0, "weighted_score": 0.0, "description": "加权证据完整率", "detail": "加权完整率 0%"}, {"name": "causal_chain", "weight": 0.2, "score": 1.0, "weighted_score": 0.2, "description": "因果链完整性", "detail": "完整因果链"}, {"name": "tool_coverage", "weight": 0.1, "score": 0.3, "weighted_score": 0.03, "description": "关键探针覆盖率", "detail": "工具成功率 30%"}, {"name": "runbook_match", "weight": 0.15, "score": 1.0, "weighted_score": 0.15, "description": "Runbook 匹配质量", "detail": "核心: pod-imagepull-failed"}, {"name": "llm_self_score", "weight": 0.2, "score": 0.5, "weighted_score": 0.1, "description": "LLM 自评分数", "detail": "来源: layer_confidence, 分数: 50%"}], "confidence_penalties": [], "evidence_breakdown": {"total": 0, "breakdown": {}}, "performance": {"total_duration_ms": 149858.85047912598, "llm_calls": 29, "llm_duration_ms": 142640.0761604309, "tool_calls": 29, "executed_tool_calls": 27, "deduplicated_tool_calls": 2, "successful_tool_calls": 28, "failed_tool_calls": 1, "tool_duration_ms": 10555.20081520