data: {"id": "d2701352786e46a3-thinking-parallel_evidence-2398", "run_id": "d2701352786e46a3", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "run_bash_command", "content": null, "status": "success", "result_preview": "{\"success\": true, \"stdout\": \"NAME                        READY   STATUS             RESTARTS   AGE   IP              NODE    NOMINATED NODE   READINESS GATES\\nworkload-65b7f54794-rnlv4   0/1     Image", "duration_seconds": null, "iteration": 10, "ts_ms": 1788413059170, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "other"}, "tool_call_id": "call_204f323a82324575ae052c33", "tool_sequence": 10, "semantic_success": true, "result": "{\"success\": true, \"stdout\": \"NAME                        READY   STATUS             RESTARTS   AGE   IP              NODE    NOMINATED NODE   READINESS GATES\\nworkload-65b7f54794-rnlv4   0/1     ImagePullBackOff   0          52m   172.16.104.16   node2   <none>           <none>\\n\", \"stderr\": \"\", \"returncode\": 0}", "raw_ref": "/tmp/aiops/reports/context_archives/d2701352786e46a3-g1/tools/024-evidence-run_bash_command.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/d2701352786e46a3-g1/tools/024-evidence-run_bash_command.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/d2701352786e46a3-g1/tools/024-evidence-run_bash_command.summary.txt"}

