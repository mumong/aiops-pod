data: {"id": "0d7ea1a05eaf4059-node_complete-parallel_evidence", "run_id": "0d7ea1a05eaf4059", "seq": 2756, "ts_ms": 1788414338435, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 54.37, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-rnlv4"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/0d7ea1a05eaf4059-g1/lane_artifacts/g1/artifact.json", "sha256": "6256f6ba9681c8b909df3cd73579d282dd558da7ccac9fd0ac0eb4a0d29a3667", "bytes": 2634}, "snapshot_sha256": "906670bd24796cc10d2eaa42a8e42f55add94ecb4196bc10692e0fd02652fdfd"}]}, "handoff_summary": ""}

