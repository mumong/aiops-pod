data: {"id": "db7643968147438a-thinking-parallel_evidence-1446", "run_id": "db7643968147438a", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubernetes_jq_query", "content": null, "status": "success", "result_preview": "kubernetes_jq_query 输出摘要: raw_chars=295 lines=9\nExecuting jq query for pods...\n{\n  \"name\": \"workload-65b7f54794-rnlv4\",\n  \"namespace\": \"aiops-case-02\",\n  \"phase\": \"Pending\",\n  \"image\": \"registry.inval", "duration_seconds": null, "iteration": 8, "ts_ms": 1788415413238, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g1", "dimension": "kubernetes"}, "tool_call_id": "call_c165d22c7a7f4953a133c097", "tool_sequence": 14, "semantic_success": true, "result": "kubernetes_jq_query 输出摘要: raw_chars=295 lines=9\nExecuting jq query for pods...\n{\n  \"name\": \"workload-65b7f54794-rnlv4\",\n  \"namespace\": \"aiops-case-02\",\n  \"phase\": \"Pending\",\n  \"image\": \"registry.invalid/aiops/workload:missing\",\n  \"reason\": \"ImagePullBackOff\",\n  \"message\": \"Back-off pulling image \\\"registry.invalid/aiops/workload:missing\\\"\"\n}", "raw_ref": "/tmp/aiops/reports/context_archives/db7643968147438a-g1/tools/021-evidence-kubernetes_jq_query.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/db7643968147438a-g1/tools/021-evidence-kubernetes_jq_query.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/db7643968147438a-g1/tools/021-evidence-kubernetes_jq_query.summary.txt"}

