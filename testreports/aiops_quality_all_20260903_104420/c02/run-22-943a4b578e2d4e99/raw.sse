data: {"id": "943a4b578e2d4e99-node_complete-parallel_evidence", "run_id": "943a4b578e2d4e99", "seq": 2218, "ts_ms": 1788412920528, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 62.047, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 1, "expected_group_count": 1, "terminal_group_count": 1, "join_complete": true, "diagnosed_count": 1, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-02", "name": "workload-65b7f54794-rnlv4"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/943a4b578e2d4e99-g1/lane_artifacts/g1/artifact.json", "sha256": "0c0a6df3d7d4a0dffdd715fd85385a9b3f2e1404e285a8e35d732c9cc6d3a0e3", "bytes": 2634}, "snapshot_sha256": "fb25c5552ef2dac64a79892289a1097c0e845732ebbca685636213213f7975b3"}]}, "handoff_summary": ""}

