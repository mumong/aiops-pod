data: {"id": "8be6496386db442d-node_complete-parallel_evidence", "run_id": "8be6496386db442d", "seq": 5331, "ts_ms": 1788863682943, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 87.111, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 6, "expected_group_count": 6, "terminal_group_count": 6, "join_complete": true, "diagnosed_count": 6, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v01", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8be6496386db442d-g1/lane_artifacts/g1/artifact.json", "sha256": "62ec74661b74b33c158c6d1f7e9d2e46300480ab5e234087706a87079bb18f26", "bytes": 2419}, "snapshot_sha256": "9f03fd4b69092db357593346c36cd23e9a2cec1f4835347f0680fe128b8ebfb8"}, {"group_id": "g2", "presentation_index": 1, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8be6496386db442d-g2/lane_artifacts/g2/artifact.json", "sha256": "5fc171ce85160670e1d5f22506ab3bbc63ab4f9a7cdf2487cb2942a5b0123d8a", "bytes": 2419}, "snapshot_sha256": "5d0b66dfc495a9523f0f4e54e31dc3e33a39a8afeef8e12964eafcce83573aa8"}, {"group_id": "g3", "presentation_index": 2, "entities": [{"kind": "Pod", "namespace": "aiops-case-v03", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8be6496386db442d-g3/lane_artifacts/g3/artifact.json", "sha256": "a567cdc15435584c48503e3c5216e6c98b51fbfbd0bd21b2b4235e9657de06e3", "bytes": 2419}, "snapshot_sha256": "80f8f27111400341c60bfea647c0c47315fa3436670afd253cb17b17f3bf4077"}, {"group_id": "g4", "presentation_index": 3, "entities": [{"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8be6496386db442d-g4/lane_artifacts/g4/artifact.json", "sha256": "56088f72cab9c220aa65fdc9a648b464de161d5d3e173f0ada93940c45aaa802", "bytes": 2420}, "snapshot_sha256": "f7e5e8ad56d72e96475d4f3fb206a8a8257315f94a895d09142767e014d87cba"}, {"group_id": "g5", "presentation_index": 4, "entities": [{"kind": "Pod", "namespace": "aiops-case-v05", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8be6496386db442d-g5/lane_artifacts/g5/artifact.json", "sha256": "f622958bb54c14f70a6a8803584788777fca7f6c0d3f6723d63180eb8a6268df", "bytes": 2417}, "snapshot_sha256": "d9daed772b5a40ab6c7a5ac73ee9516c16adb3b7905457dc428f4504d880eaea"}, {"group_id": "g6", "presentation_index": 5, "entities": [{"kind": "Pod", "namespace": "aiops-case-v06", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/8be6496386db442d-g6/lane_artifacts/g6/artifact.json", "sha256": "c1eccd2637544deed26684ef95f9f9916536635792bb75b137a2e5e0ef904f31", "bytes": 2569}, "snapshot_sha256": "75fe5d5c6a14c043c59c50f2a17f33bd4c2e8250c887d43b6bf5f4bf186a90a2"}]}, "handoff_summary": ""}

