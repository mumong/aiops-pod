data: {"id": "87b95b89ca46403c-thinking-parallel_evidence-341", "run_id": "87b95b89ca46403c", "node": "parallel_evidence", "node_name": "parallel_evidence", "thinking_type": "tool_result", "tool_name": "kubectl_describe", "content": null, "status": "success", "result_preview": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v04\nnode: node2/10.2.0.50\nstatus: Pending\n关键诊断行:\n  Warning  FailedMount  79s (x9 over 3m27s)  kubelet            MountVolume.SetUp failed for ", "duration_seconds": null, "iteration": 1, "ts_ms": 1788863739634, "lane_stage": "evidence", "evidence_context": {"contract_version": "aiops.parallel-evidence-stream.v1", "group_id": "g2-p1", "entity": {"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}, "dimension": "kubernetes"}, "tool_call_id": "call_a0772873363e455c825f5a55", "tool_sequence": 1, "semantic_success": true, "result": "kubectl_describe 摘要:\nname: workload\nnamespace: aiops-case-v04\nnode: node2/10.2.0.50\nstatus: Pending\n关键诊断行:\n  Warning  FailedMount  79s (x9 over 3m27s)  kubelet            MountVolume.SetUp failed for volume \"input\" : secret \"unavailable-input\" not found\n  Warning  FailedMount  84s                  kubelet            Unable to attach or mount volumes: unmounted volumes=[input], unattached volumes=[input]: timed out waiting for the condition\nPod 关键区块:\nQoS Class: Burstable\nNode-Selectors: <none>\nTolerations: node.kubernetes.io/not-ready:NoExecute op=Exists for 300s\nContainers:\n  app:\n    Container ID:\n    Image:         xnet.registry.io:8443/observability/python:3-alpine\n    Image ID:\n    Command:\n      python3\n      -u\n      -c\n      import time; print('application started', flush=True); time.sleep(86400)\n    State:          Waiting\n      Reason:       ContainerCreating\n    Ready:          False\n    Restart Count:  0\n    Limits:\n      cpu:     50m\n      memory:  32Mi\n    Requests:\n      cpu:        5m\n      memory:     8Mi\n    Environment:  <none>\n    Mounts:\nVolumes:\n  input:\n    Type:        Secret (a volume populated by a Secret)\n    SecretName:  unavailable-input\n    Optional:    false\nEvents:\n  Warning  FailedMount  84s                  kubelet            Unable to attach or mount volumes: unmounted volumes=[input], unattached volumes=[input]: timed out waiting for the condition\n  Warning  FailedMount  79s (x9 over 3m27s)  kubelet            MountVolume.SetUp failed for volume \"input\" : secret \"unavailable-input\" not found\n关键状态/事件:", "raw_ref": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g2-p1/tools/004-evidence-kubectl_describe.raw.txt", "structured_ref": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g2-p1/tools/004-evidence-kubectl_describe.structured.json", "summary_ref": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g2-p1/tools/004-evidence-kubectl_describe.summary.txt"}

