data: {"id": "87b95b89ca46403c-node_complete-parallel_evidence", "run_id": "87b95b89ca46403c", "seq": 5036, "ts_ms": 1788864311602, "node": "parallel_evidence", "node_name": "并发证据采集", "duration_seconds": 588.58, "state_snapshot": {"contract_version": "aiops.parallel-evidence-output.v2", "group_count": 6, "expected_group_count": 6, "terminal_group_count": 6, "join_complete": true, "diagnosed_count": 6, "inconclusive_count": 0, "error_count": 0, "errors": [], "groups": [{"group_id": "g1-p1", "presentation_index": 0, "entities": [{"kind": "Pod", "namespace": "aiops-case-v01", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g1-p1/lane_artifacts/g1-p1/artifact.json", "sha256": "bfe2df7b5048a0c77a3c28c193dc6148710c832283aab5e2ef2157292e869f3e", "bytes": 2470}, "snapshot_sha256": "3e50bb0012adfefd93b8988b9cc399e1396e02c9fd0a04cd98e3832febb2a0d4"}, {"group_id": "g1-p2", "presentation_index": 1, "entities": [{"kind": "Pod", "namespace": "aiops-case-v02", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g1-p2/lane_artifacts/g1-p2/artifact.json", "sha256": "b7f26b8dcdb0e8a1330414370f6b590eb3c5c23a00134129a2787c5e778c79f0", "bytes": 2470}, "snapshot_sha256": "f5918988cf7b632f30793efb756d1fd6b66bd0448434269fc36e1fea82348765"}, {"group_id": "g1-p3", "presentation_index": 2, "entities": [{"kind": "Pod", "namespace": "aiops-case-v03", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g1-p3/lane_artifacts/g1-p3/artifact.json", "sha256": "1c083a85cddce07865a60eeabe228208e2c371033334ca46e6749ccd6ebde20d", "bytes": 2470}, "snapshot_sha256": "f42c9b590954f89d1613082dfb43fcc0853181548e242030d2f1b15a70e6977d"}, {"group_id": "g2-p1", "presentation_index": 3, "entities": [{"kind": "Pod", "namespace": "aiops-case-v04", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g2-p1/lane_artifacts/g2-p1/artifact.json", "sha256": "66cba8ff3452c378e2911ca721e295985df8ee07f7fc06b9d103364a938a73e6", "bytes": 2620}, "snapshot_sha256": "f3ce3a0f6ca5e9d2070a0a8725d679fa3eea6a4a4692978e3858b152cde15e90"}, {"group_id": "g2-p2", "presentation_index": 4, "entities": [{"kind": "Pod", "namespace": "aiops-case-v05", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g2-p2/lane_artifacts/g2-p2/artifact.json", "sha256": "fc106ef3823ac709fdc10f4373fd57d09a8f6d83181fa3dc9e7ecacf3d103aec", "bytes": 2620}, "snapshot_sha256": "646c3a9a093156fff523bdf221a3a6abfdccd400c118a4ec959af565a53d428d"}, {"group_id": "g2-p3", "presentation_index": 5, "entities": [{"kind": "Pod", "namespace": "aiops-case-v06", "name": "workload"}], "diagnostic_status": "diagnosed", "artifact_ref": {"path": "/tmp/aiops/reports/context_archives/87b95b89ca46403c-g2-p3/lane_artifacts/g2-p3/artifact.json", "sha256": "9b1d982ca210dd79bdc7b880e4c6a8d218823114b8157fd3216d049b2af773f8", "bytes": 2620}, "snapshot_sha256": "2a1f1b7f6e2512d800cdd992bf293272885e09885492844829b883ebb4ea515b"}]}, "handoff_summary": ""}

