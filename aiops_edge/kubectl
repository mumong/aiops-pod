#!/usr/local/bin/python3
"""kubectl shim (specs/008-multi-cluster): local unless AIOPS_CLUSTER names an edge cluster."""
import os
import sys

REAL = os.environ.get("AIOPS_REAL_KUBECTL", "/usr/local/bin/kubectl.real")
if not os.environ.get("AIOPS_CLUSTER"):
    os.execv(REAL, [REAL, *sys.argv[1:]])
sys.path.insert(0, os.environ.get("AIOPS_EDGE_LIB", "/app/servers"))
from aiops_edge.shim import entrypoint  # noqa: E402

entrypoint()
