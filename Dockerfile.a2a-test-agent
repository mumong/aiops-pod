FROM python:3.12-slim

ARG VERSION=1.0.0

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TEST_AGENT_HOST=0.0.0.0 \
    TEST_AGENT_PORT=8002 \
    APP_VERSION=${VERSION}

COPY requirements.a2a.txt .
RUN pip install --no-cache-dir --no-compile -r requirements.a2a.txt \
    && find /usr/local/lib/python3.12/site-packages \
        \( -type d -name __pycache__ -o -type f -name '*.pyc' \) -exec rm -rf '{}' + \
    && rm -rf /root/.cache /tmp/*

RUN useradd -m -u 1000 appuser && chown appuser:appuser /app

COPY --chown=appuser:appuser a2a_test_agent/ ./a2a_test_agent/

USER appuser
EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health', timeout=4)"]

CMD ["python", "-m", "a2a_test_agent"]
