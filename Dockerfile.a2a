FROM python:3.12-slim

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    A2A_HOST=0.0.0.0 \
    A2A_PORT=8001

# Dependencies first: this layer must not depend on VERSION, otherwise every
# release re-runs pip install and the build needs network access (it failed twice
# with "Network is unreachable" and left the service down after `make delete`).
COPY requirements/a2a.txt ./requirements/
RUN pip install --no-cache-dir --no-compile --upgrade pip==26.2.0 \
    && pip install --no-cache-dir --no-compile -r requirements/a2a.txt \
    && find /usr/local/lib/python3.12/site-packages \
        \( -type d -name __pycache__ -o -type f -name '*.pyc' \) -exec rm -rf '{}' + \
    && rm -rf /root/.cache /tmp/*

RUN useradd -m -u 1000 appuser && chown appuser:appuser /app

COPY --chown=appuser:appuser a2a_adapter/ ./a2a_adapter/

ARG VERSION=1.0.0
ENV APP_VERSION=${VERSION}

USER appuser
EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=4)"]

CMD ["python", "-m", "a2a_adapter"]
